#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "You should find some in the Green Chest."
msgstr "Bạn nên tìm một số trong Rương Xanh."

#. Key:	0571D2B24F6127BBBD8601BAC869621D
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "You can purchase an AutoDefender from the farming vendor"
msgstr "Bạn có thể mua một AutoDefender từ người bán nông sản"

#. Key:	064432694F7A980F7CB4F3A3AE604F0F
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "They usually hide away for a few seconds after being shot"
msgstr "Nó thường trốn đi trong vài giây sau khi bị bắn"

#. Key:	07B26A274713CE70E8E3F793A602D42F
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Alpha Animals can drop this hat."
msgstr "Súc vật Alpha có thể đánh rơi cái mũ này."

#. Key:	0930FE1D49194C29CFC1D5B007DCAA17
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "To catch some fish you need a tool for that. Buy fishing rod by clicking the vending machine near the dock."
msgstr "Bạn cần một dụng cụ để bắt cá. Mua một cần câu bằng cách nhấp vào máy bán hàng gần bến cảng."

#. Key:	0B8E3A4E438B300E7E230A8FD787056A
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Miner in Sgt. Lake sells it for a good price."
msgstr "Thợ mỏ ở hồ Sgt. bán nó với giá tốt."

#. Key:	0E2D42644FB049F04C907BA2E4BD0C54
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "You can use a basic pickaxe"
msgstr "Bạn có thể sử dụng cái cuốc chim cơ bản"

#. Key:	11045F9E47DE163D7B7716800D9669B7
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Hermit is in Skabban island"
msgstr "Tu sĩ trên đảo Skabban"

#. Key:	1584542E4885FEE83881EA8D39F550BD
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Check out different vendors and buy a research tent. You will need it to survive."
msgstr "Thăm dò những thương nhân khác nhau và mua một lều nghiên cứu. Bạn sẽ cần nó để sống sót."

#. Key:	15B6BD324A7FC1581BCEDB8468E0EFEA
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Combine all the pristine trophies in the Advanced Workbench."
msgstr "Kết hợp tất cả các cúp sạch sẽ trong Bàn công cụ Nâng cao."

#. Key:	1855F8A54A3C983CEA04F9BEACFB839B
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Can be found in legendary orange chests."
msgstr "Có thể tìm thấy trong rương cam huyền thoại."

#. Key:	1868E02B4B10918513CA8F8936D90158
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Northern islands have better loot."
msgstr "Các đảo phía bắc có lương khá hơn."

#. Key:	1BE53ED0473C9023F039879A7991B965
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Talk with the vendor on Koilot Island."
msgstr "Nói chuyện với người bán hàng ở Đảo Koilot."

#. Key:	1FAA9A8B4B99F7A7DEABC98A63AADA98
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Trace the pipelines to locate the refinery atop the oil rig."
msgstr "Theo dõi đường ống dẫn để tìm nhà máy lọc dầu trên giàn khoan."

#. Key:	2013509D4436F33852DB51A6F8A34457
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Add crude oil to the refinery. Wait briefly for fuel to be produced."
msgstr "Thêm dầu thô vào nhà máy lọc dầu. Đợi một lúc để sản xuất nhiên liệu."

#. Key:	218A49DD41E28C759B7134AD83FD4D0C
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Find and get rid of them. "
msgstr "Tìm và tiêu diệt chúng. "

#. Key:	21FDAA55494E1E0FE47FD68E94F81402
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Collect wheat you have planted yourself."
msgstr "Thu hoạch lúa mì bạn đã tự trồng."

#. Key:	23B853094A221CF2AFDE82ACD14EE896
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Place this inside your tent."
msgstr "Đặt cái này trong lều của bạn."

#. Key:	2444930F421D8D29590FA1AE6CCC05FE
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "You can buy and sell items to vending machines."
msgstr "Bạn có thể mua và bán vật phẩm tại các máy bán hàng."

#. Key:	31269F1E4C63DABA27742195CE0933CD
