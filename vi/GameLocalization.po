msgctxt "DT_AllQuests"
msgid "Upland Hunting"
msgstr "Săn bắn vùng cao nguyên"

#. Key:	UpgradeTime_Description
#. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial5.Description_8_665031484F84F4453D05189416ACAD65
#: /Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial5.Description_8_665031484F84F4453D05189416ACAD65
