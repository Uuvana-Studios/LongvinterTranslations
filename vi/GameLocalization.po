#: /Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial4.Description_8_665031484F84F4453D05189416ACAD65
msgctxt "DT_AllQuests"
msgid "The uplands are teeming with wildlife. Master the art of the hunt to gather valuable resources and protect yourself."
msgstr "Vùng cao nguyên đầy ắp sinh vật hoang dã. Làm chủ nghệ thuật săn bắn để thu thập tài nguyên quý và bảo vệ bản thân."

#. Key:	UplandHunting_TranslatedName
