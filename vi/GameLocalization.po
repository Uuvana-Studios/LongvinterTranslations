msgctxt "DT_AllQuests"
msgid "Practice Makes Perfect"
msgstr "Thực hành tạo nên sự hoàn hảo"

#. Key:	BasicsOfSurvival_Description
#. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial1.Description_8_665031484F84F4453D05189416ACAD65
#: /Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial1.Description_8_665031484F84F4453D05189416ACAD65
msgctxt "DT_AllQuests"
msgid "Your research journey demands resilience. First, you must master the fundamental skill of restoring your energy."
msgstr "Chuyến du hành nghiên cứu của bạn đòi hỏi sự kiên cường. Trước tiên, bạn phải thành thạo kỹ năng cơ bản là phục hồi năng lượng."

#. Key:	BasicsOfSurvival_TranslatedName
#. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial1.TranslatedName_21_B9A5ECBC40C4C2D839C7B9A851A1986B
#: /Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial1.TranslatedName_21_B9A5ECBC40C4C2D839C7B9A851A1986B
msgctxt "DT_AllQuests"
msgid "The Basics of Survival"
msgstr "Những điều cơ bản để sinh tồn"

#. Key:	ExploringTheUnknown_Description
#. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial2.Description_8_665031484F84F4453D05189416ACAD65
#: /Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial2.Description_8_665031484F84F4453D05189416ACAD65
msgctxt "DT_AllQuests"
msgid "Venture deeper inland. The wilderness holds many secrets, and perhaps some valuable resources."
msgstr "Mạo hiểm sâu hơn vào đất liền. Vùng hoang dã chứa nhiều bí mật và có thể là một số tài nguyên quý giá."

#. Key:	ExploringTheUnknown_TranslatedName
#. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial2.TranslatedName_21_B9A5ECBC40C4C2D839C7B9A851A1986B
#: /Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial2.TranslatedName_21_B9A5ECBC40C4C2D839C7B9A851A1986B
msgctxt "DT_AllQuests"
msgid "Exploring the Unknown"
msgstr "Khám phá Những Điều Chưa Biết"

#. Key:	SettlingDown_Description
#. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial3.Description_8_665031484F84F4453D05189416ACAD65
#: /Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial3.Description_8_665031484F84F4453D05189416ACAD65
msgctxt "DT_AllQuests"
msgid "It's time to establish a more permanent presence. Find a place to call your own!"
msgstr "Đã đến lúc thiết lập một sự hiện diện cố định hơn. Tìm một nơi để gọi là của riêng bạn!"

#. Key:	SettlingDown_TranslatedName
#. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial3.TranslatedName_21_B9A5ECBC40C4C2D839C7B9A851A1986B
#: /Game/Blueprints/NewQuests/DT_AllQuests.DT_AllQuests.Tutorial3.TranslatedName_21_B9A5ECBC40C4C2D839C7B9A851A1986B
msgctxt "DT_AllQuests"
msgid "Settling Down"
msgstr "Định cư"

#. Key:	UplandHunting_Description
