msgctxt "WebUIX.HTML"
msgid "game.watch(\"Warehouse\", 500)\ngame.after(30, \"supply\")\n\nfunction on_trigger_enter(trigger, player)\n  if trigger == \"Warehouse\" then\n    game.add_mk(player, 50)\n    game.energy(player, 20)\n    game.show_info(player, \"Welcome to the warehouse!\")\n    game.teleport(player, \"Exit\")\n  end\nend\n\nfunction on_timer(label)\n  if label == \"supply\" then\n    game.after(30, \"supply\")\n  end\nend"
msgstr "game.watch(\"Warehouse\", 500)\ngame.after(30, \"supply\")\n\nfunction on_trigger_enter(trigger, player)\n  if trigger == \"Warehouse\" then\n    game.add_mk(player, 50)\n    game.energy(player, 20)\n    game.show_info(player, \"Welcome to the warehouse!\")\n    game.teleport(player, \"Exit\")\n  end\nend\n\nfunction on_timer(label)\n  if label == \"supply\" then\n    game.after(30, \"supply\")\n  end\nend"

