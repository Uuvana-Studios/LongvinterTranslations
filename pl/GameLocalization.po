#. Key:	E2F17E56431A52F3D9F00A98BB377AA2
#. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_0.Text
#: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_0.Text
msgid "Welcome to your adventure on Longvinter Island! We're thrilled to have you join us. "
msgstr "Witamy na Twojej przygodzie na Wyspie Longvinter! Cieszymy się, że dołączyłeś do nas."

#. Key:	11F993254B4489914866C3A7FD8AF526
#. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_1.Text
#: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_1.Text
