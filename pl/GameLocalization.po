msgstr "Prześledzić rurociągi, aby zlokalizować rafinerie na szczycie platformy wiertniczej."

#. Key:	2013509D4436F33852DB51A6F8A34457
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Add crude oil to the refinery. Wait briefly for fuel to be produced."
msgstr "Dodaj ropę naftową do rafinerii. Poczekaj chwilę na wyprodukowanie paliwa."

#. Key:	218A49DD41E28C759B7134AD83FD4D0C
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
