msgstr "Kontynuuj polowanie na ptaki, aby zdobyć te nieskazitelne pióra!"

#. Key:	46A1A1EC47DEBE552330249154FE2E95
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Just have the soup in your inventory. It will be delivered automatically"
msgstr "Po prostu miej zupę w swoim inwentarzu. Zostanie dostarczona automatycznie."

#. Key:	473C86C54BD5328244EBA8B5F5457C6D
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Once in the bunker, enter the locked room and find the documents. You may need a keycard."
msgstr "Po wejściu do bunkra, wejdź do zamkniętego pokoju i znajdź dokumenty. Może być potrzebna karta magnetyczna."

#. Key:	4B1A605C45EAB967C293A2A6D486006D
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
