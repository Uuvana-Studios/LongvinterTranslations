#. Key:	090926ED493BFF326B2758A96C950B6A
#. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Starting_Collectables.Default__A_Vendor_Starting_Collectables_C.VendorDescription
#: /Game/Blueprints/Vendor/A_Vendor_Starting_Collectables.Default__A_Vendor_Starting_Collectables_C.VendorDescription
msgid "I offer all the essential items for cheap here! Also, I buy some berries I am really fond of. I offer all the necessary items for cheap here!\r\n\r\nI also buy some berries that I'm really fond of.\r\n\r\nDon't knock on the door\r\n\r\n-Jax"
msgstr "Je propose tous les articles essentiels pour pas cher ici ! De plus, j'achète des baies dont je suis très friand. J'offre tous les articles nécessaires pour pas cher ici!\r\n\r\nJ'achète également quelques baies dont je suis vraiment friand.\r\n\r\nNe frappez pas à la porte\r\n\r\n-Jax"

#. Key:	E523C89D456DF47ED438238BCE1ECE15
#. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_SwampBase2.Default__A_Vendor_SwampBase2_C.Vendor Name
#. Key:	F9C9E8F14305A964EA5F18A3CAE021CF
#. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_SwampBase.Default__A_Vendor_SwampBase_C.Vendor Name
#: /Game/Blueprints/Vendor/A_Vendor_SwampBase.Default__A_Vendor_SwampBase_C.Vendor Name
#: /Game/Blueprints/Vendor/A_Vendor_SwampBase2.Default__A_Vendor_SwampBase2_C.Vendor Name
