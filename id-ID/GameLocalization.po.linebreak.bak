msgstr "Barang Kerajinan yang Diterima"  #. Key:	ADE557D1413DFC4C7CD1EFB51A20F626 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:GetRequirementText [Script Bytecode] #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:GetRequirementText [Script Bytecode] msgid "Accepted Foods"
msgstr "Makanan yang Diterima"  #. Key:	B98F5FFA4A6DA44A997A96AF00A24B75 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:GetRequirementText [Script Bytecode] #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:GetRequirementText [Script Bytecode] msgid "Accepted Plants"
