msgstr "Tidak dapat diletakkan di atas ikan!"  #. Key:	7DF5A0B7417969CE3FCAECA4738E53FE #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "You can only place 1 boat house near your house"
