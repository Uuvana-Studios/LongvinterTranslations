msgstr "Kamu diblokir!"  #. Key:	1DA175C54D11D4A4C64E32897C1AEA32 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_BanMessage.UMG_BanMessage_C:WidgetTree.TextBlock.Text #: /Game/Widgets/MainMenu/UMG_BanMessage.UMG_BanMessage_C:WidgetTree.TextBlock.Text msgid "Appeal"
msgstr "Daya Tarik"  #. Key:	BA97445945F295A67EA8C99FD1CF9E45 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_ConnectToAddress.UMG_ConnectToAddress_C:ExecuteUbergraph_UMG_ConnectToAddress [Script Bytecode] #. Key:	CC9C498746115A7932391DA5BC9105DC #. SourceLocation:	/Game/Widgets/MainMenu/UMG_MainMenu.UMG_MainMenu_C:ExecuteUbergraph_UMG_MainMenu [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_ConnectToAddress.UMG_ConnectToAddress_C:ExecuteUbergraph_UMG_ConnectToAddress [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_MainMenu.UMG_MainMenu_C:ExecuteUbergraph_UMG_MainMenu [Script Bytecode] msgid "Direct Connect"
msgstr "Sambungan Langsung"  #. Key:	E70C74524F8F57B36C5C47ABF1611DFC #. SourceLocation:	/Game/Widgets/MainMenu/UMG_ConnectToAddress.UMG_ConnectToAddress_C:WidgetTree.Adress.HintText #: /Game/Widgets/MainMenu/UMG_ConnectToAddress.UMG_ConnectToAddress_C:WidgetTree.Adress.HintText msgid "Ip address"
