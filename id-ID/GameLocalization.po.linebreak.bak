msgstr "Anda tidak dapat bermain sendiri!"  #. Key:	3EF8FEC44275E5CE72D9DCBB38815C20 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/DiceGameComponent.DiceGameComponent_C:ExecuteUbergraph_DiceGameComponent [Script Bytecode] #. Key:	76AA25BE4895A24C53F756B4B69C6C11 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:IncreaseDeposit [Script Bytecode] #. Key:	EA2C5100434C263FCEA9E2AC76796DF5 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:IncreaseDeposit [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/DiceGameComponent.DiceGameComponent_C:ExecuteUbergraph_DiceGameComponent [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:IncreaseDeposit [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:IncreaseDeposit [Script Bytecode] msgid "Maximum bet is"
msgstr "Taruhan maksimumnya adalah"  #. Key:	8B814E284569413E22C47C86C271B9D3 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Add Ammo [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Add Ammo [Script Bytecode] msgid "You cannot carry more arrows!"
msgstr "Anda tidak dapat membawa lebih banyak anak panah!"  #. Key:	99B9BB25486012A88505099DA57A0725 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Add Ammo [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Add Ammo [Script Bytecode] msgid "You don't have to reload. Just shoot."
msgstr "Anda tidak perlu mengisi ulang. Tembak saja."  #. Key:	C935370149CE56815C333E857A06E88E #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Add Ammo [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Add Ammo [Script Bytecode] msgid "You cannot carry more ammo!"
msgstr "Anda tidak dapat membawa lagi amunisi!"  #. Key:	31EC4EE6405CA05780555298E2AA9773 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Add Item to Smelter [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Add Item to Smelter [Script Bytecode] msgid "Smelter is full!"
msgstr "Smelter sudah penuh!"  #. Key:	7F3BD95547FDEE7668A79192E4C4A457 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Edible Interaction [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Edible Interaction [Script Bytecode] msgid "Status effect is already applied"
msgstr "Efek status sudah diterapkan"  #. Key:	BEA85230424EF720F86614B402EAF4CC #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Edible Interaction [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:Edible Interaction [Script Bytecode] msgid "Less health from same type of food by"
msgstr "darah berkurang dari memakan jenis makanan yang sama sebesar"  #. Key:	26B93E0A4517820C6056E4A8CE47D42C #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] msgid "You do not have the permission to remove upgrades from this house!"
msgstr "Anda tidak memiliki izin untuk menghapus upgrade dari rumah ini!"  #. Key:	3751000646E327BB002F039708F0B184 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] msgid "Consuming foods with more than 35 energy has an effect that makes you feel full, preventing you from consuming other high energy foods."
msgstr "Mengkonsumsi makanan dengan lebih dari 35 energi memiliki efek yang membuat Anda merasa kenyang, sehingga mencegah Anda untuk mengkonsumsi makanan berenergi tinggi lainnya."  #. Key:	5DE062C34A6A8D19B1EC9FB0BA58E351 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] msgid "Double Loot!"
msgstr "Loot Dobel!"  #. Key:	8F63195C44DF0CFDF5E0D0978499B73B #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] msgid "Trade completed"
msgstr "Trade Selesai"  #. Key:	A042DEAF4284619834CE39A99DA75F53 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] msgid "This item is only used in crafting"
msgstr "Item ini hanya digunakan dalam kerajinan"  #. Key:	BF66DE02427C4887D4CCFB9B25E0096C #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] msgid "You just found 2 items"
msgstr "Anda baru saja menemukan 2 item"  #. Key:	DCBC07EB4B25EC37A81853B32AADEB25 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] msgid "If you drop an item on the floor, it will disappear after a while even if it’s in your house"
msgstr "Jika Anda menjatuhkan barang di lantai, barang itu akan menghilang setelah beberapa waktu meskipun di dalam rumah Anda"  #. Key:	23B7F9F14DC1DCD6413271BF37D7E76A #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:FLearnNewItem [Script Bytecode] #. Key:	FFE6F05647B302927F9BB69C9A3C3DD1 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:FLearnNewItem [Script Bytecode] msgid "Check cooking book for requirements"
msgstr "Periksa buku memasak untuk persyaratan"  #. Key:	2E66A4E0426FA4BFC219F88A0B67DE63 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #. Key:	C56495534DF832BBB9DA4F893C662BD5 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:ExecuteUbergraph_UMG_Inventory [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:ExecuteUbergraph_UMG_Inventory [Script Bytecode] msgid "\"Cook dishes, make drinks, or combine ingredients in a campfire or a stove\""
msgstr "\"Memasak hidangan, membuat minuman, atau mencampurkan bahan di dalam api unggun atau kompor\""  #. Key:	6505334B45B35D40E3916384EAFA0833 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:ExecuteUbergraph_UMG_Inventory [Script Bytecode] #. Key:	8518AA134F40E830CC1AC6A3B78B5D40 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:ExecuteUbergraph_UMG_Inventory [Script Bytecode] msgid "Cooking recipes"
msgstr "Resep memasak"  #. Key:	CC1118A948C77372AA31C9A46D153C94 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:ExecuteUbergraph_UMG_Inventory [Script Bytecode] #. Key:	E0EE844443826423BDD641AEFDD9D6E8 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:ExecuteUbergraph_InventoryComponent [Script Bytecode] #: /Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:ExecuteUbergraph_UMG_Inventory [Script Bytecode] msgid "\"Craft new items by combining two or more items in the workbench, which can be bought from a vendor or found from a loot container\""
msgstr "\"Buat barang baru dengan menggabungkan dua atau lebih barang di bangku kerja, yang bisa dibeli dari penjual atau ditemukan dari kotak rampasan\""  #. Key:	DF1117ED42C8123F13570BB60CD4090A #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:FLearnNewItem [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:FLearnNewItem [Script Bytecode] msgid "You have already learned everything"
msgstr "Kamu sudah mempelajari semuanya"  #. Key:	1E6B18FC4728F49CFB2F0DBE7D729CC7 #. SourceLocation:	/Game/Widgets/ErrorMessage/UMG_Notification.UMG_Notification_C:WidgetTree.T_Desc.Text #. Key:	B28C527D422BE25F07880C9B2DF81B26 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:FLearnNewItem [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:FLearnNewItem [Script Bytecode] #: /Game/Widgets/ErrorMessage/UMG_Notification.UMG_Notification_C:WidgetTree.T_Desc.Text msgid "Check crafting book for requirements"
msgstr "Periksa buku crafting untuk persyaratan"  #. Key:	DEE8CA58475AF90179B7D18BD08A20AF #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:GetAttachmentResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:GetAttachmentResult [Script Bytecode] msgid "The item already contains an attachment"
msgstr "Item tersebut sudah berisi lampiran"  #. Key:	73A15F864A12D3ADFA86C48BDCC3D8B7 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:getCraftingResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:getCraftingResult [Script Bytecode] msgid "This is cooked in fireplace!"
msgstr "Ini dimasak di perapian!"  #. Key:	75BD766A45620D72C93C368C8DF9EB45 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:getCraftingResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:getCraftingResult [Script Bytecode] msgid "You have not learned that, check compendium blueprints!"
msgstr "Anda belum mempelajarinya, periksa kompendium cetak biru!"  #. Key:	91F9F93D45BC88CD1259589539B7BE8A #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:getCraftingResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:getCraftingResult [Script Bytecode] msgid "This is crafted with workbench istead!"
msgstr "Ini dibuat dengan menggunakan meja kerja!"  #. Key:	FE69D0FC4550E29F70422A8A0B155A74 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:getCraftingResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:getCraftingResult [Script Bytecode] msgid "Did you try to make"
msgstr "Apakah anda ingin membuat"  #. Key:	5AD332BF417782F02B1F90BED52ED024 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MakeAllowedItemsString [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MakeAllowedItemsString [Script Bytecode] msgid " to here"
msgstr "ke sini"  #. Key:	63F859594EB551ACA87AFE846F311704 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MakeAllowedItemsString [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MakeAllowedItemsString [Script Bytecode] msgid "You can only add "
msgstr "Anda hanya dapat menambahkan"  #. Key:	12153A874BA9343FDD2D879EB2AAA983 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MoveBattery [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MoveBattery [Script Bytecode] msgid "No batteries inside"
msgstr "Tidak ada baterai didalam"  #. Key:	547D97944A85FD6368A551946052A4B3 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MoveBattery [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MoveBattery [Script Bytecode] msgid "Cannot add more batteries"
msgstr "Tidak dapat menambahkan Baterai lagi"  #. Key:	CAAC5CD44DC33EE6D758A1AB306462EB #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MoveBattery [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:MoveBattery [Script Bytecode] msgid "Not a battery"
msgstr "Bukan baterai"  #. Key:	C6B6E0834DD1D04810575A96DCF5BB91 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:setMoneyBasket [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/InventoryComponent.InventoryComponent_C:setMoneyBasket [Script Bytecode] msgid "Not enough MK"
msgstr "Tidak cukup MK"  #. Key:	43EAEA74476ECD4F8BF4F881DAEC90B5 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] msgid "Too close to the edge of the cliff"
msgstr "Terlalu dekat dengan tepi tebing"  #. Key:	5BD709544C38F48296ADB9AC49911199 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] msgid "Cannot place on top of pets"
msgstr "Tidak dapat ditempatkan di atas hewan peliharaan"  #. Key:	9A24D5B04878A27F3283658CCACDBCD2 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] msgid "Overlapping with player model!"
msgstr "Tumpang-tindih dengan model pemain!"  #. Key:	A2DEF18E4EB6EF5A5D67F19D06B6581E #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] msgid "Too close to Point of Interest!"
msgstr "Terlalu dekat dengan Point of Interest!"  #. Key:	E6C21AED4DA111B9FE4F2291491C3F87 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:CheckOverlap [Script Bytecode] msgid "This item will decay after placing!"
msgstr "Item ini akan membusuk setelah ditempatkan!"  #. Key:	0028284B4032374EFB15E9A73E694CEE #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "You cannot place any more items of this type"
msgstr "Kamu tidak dapat menempatkan barang jenis ini lagi"  #. Key:	2D172E4048E13F93B3669AB42BDEF6E5 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "You need to buy more house slots from LRI stations"
msgstr "Anda perlu membeli lebih banyak slot rumah dari stasiun LRI"  #. Key:	31AF5FDD4526E9C75A2E80A949CCBAE0 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Tent can be dismantled after 30 minutes of placing"
msgstr "Tenda bisa dicopot setelah 30 menit pemasangan"  #. Key:	40D46AE3468E49E7D1A98EBFA9C28F5B #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "You need two(2) free slots in inventory"
msgstr "Kau butuh dua(2) slot kosong di simpanan"  #. Key:	499C28F24E3B6390541D898443BF7044 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "You already have placed your tents"
msgstr "Anda sudah menempatkan tenda Anda"  #. Key:	5F9B3F6D458BB75D6B659C9C58E501DD #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Can only be placed on the ground!"
msgstr "Hanya bisa ditempatkan di lantai!"  #. Key:	7C04369E41825047F7E7CC824E9F33C5 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Still loading map, please place tent later"
msgstr "Peta masih dimuat, silakan pasang tenda nanti"  #. Key:	929748564B0212675118699FE054611A #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Remove Mailbox before dismantling"
msgstr "Hapus Kotak Surat sebelum dibongkar"  #. Key:	95BAA49D42983EA07B61D59C9013C11E #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Item placement limit reached"
msgstr "Batas penempatan item tercapai"  #. Key:	96C1ED9E46B2E6DEE43E2481A45BE21E #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Items placed when blue can be picked up by anyone, while green ones can only be picked up by you. However, in a PVP server, players can break items and then pick them up."
msgstr "Item yang diletakkan saat berwarna biru dapat diambil oleh siapa saja, sedangkan yang berwarna hijau hanya dapat diambil oleh Anda. Namun, dalam server PVP, pemain dapat memecahkan item dan kemudian mengambilnya."  #. Key:	99B868C0415F1CE0F6CA8B929A2E2A88 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "It seems that you have not placed the house"
msgstr "Sepertinya Anda belum menempatkan rumah"  #. Key:	A5BAE39E43418D1E02D56986733825C0 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Can only be placed on walls!"
msgstr "Hanya dapat diletakkan di dinding!"  #. Key:	B376B54C44678E7C7B3862BC72036AC6 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Remove Trading Vendor before dismantling"
msgstr "Hapus Vendor Trading sebelum membongkar"  #. Key:	B51033B74239A8A37F46B88340867C94 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:ExecuteUbergraph_ItemPlacingComponent [Script Bytecode] msgid "Error while placing, try again"
msgstr "Kesalahan saat menempatkan, coba lagi"  #. Key:	001A57D04F165E77AC41F29555A70BA8 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Cannot place on top of players!"
msgstr "Tidak bisa meletakkan di atas pemain!"  #. Key:	0FF017584E63591412D7C0A5D3E557BA #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Can only be placed near your house"
msgstr "Hanya dapat ditempatkan di dekat rumah Anda"  #. Key:	185620B045D755514270CA9B24F30B20 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Item can only be placed in a shop"
msgstr "Item hanya bisa diletakkan di toko"  #. Key:	1B31B5604697451C71EA19BD9FC90E4C #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Tent area is overlapping with building blocked zone"
msgstr "Area tenda tumpang tindih dengan zona terhalang bangunan"  #. Key:	2287934941AB5581C561A197557D0D43 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "This item can only be placed inside!"
msgstr "Barang ini hanya bisa ditaruh di dalam!"  #. Key:	2A5474AC4F33A6FFFD5193AB16F4A6E6 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Cannot place on boat!"
msgstr "Tidak bisa ditaruh di kapal!"  #. Key:	2BE60E0B4FF58E8DBF15078599879A15 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Cannot place on land!"
msgstr "Tidak bisa ditaruh di tanah!"  #. Key:	38B0760843FE29FE528372AD1B5E9EC9 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Cannot place that high!"
msgstr "Tidak dapat diletakkan setinggi itu!"  #. Key:	3DB751634D71562747713B97A545F5A0 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Item is overlapping with something!"
msgstr "Barang tumpang tindih dengan sesuatu!"  #. Key:	3E99C1924F162B4AB485639A8D03940D #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "This item can only be placed on the ground, and cliffs"
