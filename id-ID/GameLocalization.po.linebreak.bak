msgstr ">"  #. Key:	4E897EC5403DFEF3A401FBBC2E568441 #. SourceLocation:	/Game/Blueprints/A_Campfire/A_Campfire.A_Campfire_C:ExecuteUbergraph_A_Campfire [Script Bytecode] #: /Game/Blueprints/A_Campfire/A_Campfire.A_Campfire_C:ExecuteUbergraph_A_Campfire [Script Bytecode] msgid "Most fish can be cooked and eaten with campfire."
msgstr "Kebanyakan ikan bisa dimasak dan dimakan dengan api unggun."  #. Key:	6E02FBBC40DA8F3000818A9687668E55 #. SourceLocation:	/Game/Blueprints/A_Campfire/A_Campfire.A_Campfire_C:ExecuteUbergraph_A_Campfire [Script Bytecode] #: /Game/Blueprints/A_Campfire/A_Campfire.A_Campfire_C:ExecuteUbergraph_A_Campfire [Script Bytecode] msgid "You can heal up near the campfire."
