msgstr "Jam"  #. Key:	1715558846B55F5483B202A817481B28 #. SourceLocation:	/Game/Widgets/PlaceableInteractWindow/UMG_BaseGeneratorWindow.UMG_BaseGeneratorWindow_C:WidgetTree.add_fuel_text.Text #. Key:	26126A3C4421B7B940402FAC5CE385A8 #. SourceLocation:	/Game/Blueprints/Vehicles/Boats/UMG_BoatFuel.Default__UMG_BoatFuel_C.hasFuelText #. Key:	2F5CF70A45F23AD56B2B7C8389347381 #. SourceLocation:	/Game/Blueprints/Vehicles/Boats/UMG_BoatFuel.UMG_BoatFuel_C:WidgetTree.add_fuel_text.Text #. Key:	411C722343B0B7566AA3358523D485A3 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Inventory.Default__UMG_Inventory_C.hasFuelText #. Key:	63D5B70543EA9479794AB68840441F86 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:WidgetTree.add_fuel_text.Text #. Key:	F08528404627F1CDD2C0219D05F09677 #. SourceLocation:	/Game/Widgets/PlaceableInteractWindow/UMG_BaseGeneratorWindow.Default__UMG_BaseGeneratorWindow_C.hasFuelText #: /Game/Blueprints/Vehicles/Boats/UMG_BoatFuel.Default__UMG_BoatFuel_C.hasFuelText #: /Game/Blueprints/Vehicles/Boats/UMG_BoatFuel.UMG_BoatFuel_C:WidgetTree.add_fuel_text.Text #: /Game/Widgets/Inventory/UMG_Inventory.Default__UMG_Inventory_C.hasFuelText #: /Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:WidgetTree.add_fuel_text.Text #: /Game/Widgets/PlaceableInteractWindow/UMG_BaseGeneratorWindow.Default__UMG_BaseGeneratorWindow_C.hasFuelText #: /Game/Widgets/PlaceableInteractWindow/UMG_BaseGeneratorWindow.UMG_BaseGeneratorWindow_C:WidgetTree.add_fuel_text.Text msgid "Add Fuel"
msgstr "Tambah Bahan Bakar"  #. Key:	760AAF4B48AC3033F30467B7DDAE04BA #. SourceLocation:	/Game/Widgets/Inventory/UMG_Inventory.Default__UMG_Inventory_C.noFuelText #. Key:	B69347E040100A68493911B87AC0879C #. SourceLocation:	/Game/Blueprints/Vehicles/Boats/UMG_BoatFuel.Default__UMG_BoatFuel_C.noFuelText #. Key:	F0541101448DDE3675CF0BA2867F33D3 #. SourceLocation:	/Game/Widgets/PlaceableInteractWindow/UMG_BaseGeneratorWindow.Default__UMG_BaseGeneratorWindow_C.noFuelText #: /Game/Blueprints/Vehicles/Boats/UMG_BoatFuel.Default__UMG_BoatFuel_C.noFuelText #: /Game/Widgets/Inventory/UMG_Inventory.Default__UMG_Inventory_C.noFuelText #: /Game/Widgets/PlaceableInteractWindow/UMG_BaseGeneratorWindow.Default__UMG_BaseGeneratorWindow_C.noFuelText msgid "No Fuel In Inventory"
msgstr "Tidak Ada Bahan Bakar Dalam Inventaris"  #. Key:	8F65AB874E5200B1D3A42696EA0461D5 #. SourceLocation:	/Game/Blueprints/Vehicles/Boats/UMG_BoatFuel.UMG_BoatFuel_C:ExecuteUbergraph_UMG_BoatFuel [Script Bytecode] #: /Game/Blueprints/Vehicles/Boats/UMG_BoatFuel.UMG_BoatFuel_C:ExecuteUbergraph_UMG_BoatFuel [Script Bytecode] msgid "Fuel full!"
msgstr "Bahan bakar penuh!"  #. Key:	729DC542462384AC15FA3C9A5BA2CFC0 #. SourceLocation:	/Game/Blueprints/Vehicles/Boats/UMG_BoatStorage.UMG_BoatStorage_C:ExecuteUbergraph_UMG_BoatStorage [Script Bytecode] #. Key:	D5DB63E842CA97556FE53D89A11754D8 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Chest.UMG_Chest_C:ExecuteUbergraph_UMG_Chest [Script Bytecode] #. Key:	F7E681C34F80652DBED5949C172612FD #. SourceLocation:	/Game/Blueprints/Vendor/UMG_VendorEditorContent.UMG_VendorEditorContent_C:GetText_0 [Script Bytecode] #: /Game/Blueprints/Vehicles/Boats/UMG_BoatStorage.UMG_BoatStorage_C:ExecuteUbergraph_UMG_BoatStorage [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_VendorEditorContent.UMG_VendorEditorContent_C:GetText_0 [Script Bytecode] #: /Game/Widgets/Inventory/UMG_Chest.UMG_Chest_C:ExecuteUbergraph_UMG_Chest [Script Bytecode] msgid "Price"
msgstr "Harga"  #. Key:	1E88B1DD43D5E3DF9C355FA18F2ABCD4 #. SourceLocation:	/Game/GenericRadialMenus/Templates/UMG_MultiMenuTemplate.UMG_MultiMenuTemplate_C:WidgetTree.CategoryTitle.Text #. Key:	3FC525CC47909DDC93CFFEA393D77B48 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_SimilarReport.UMG_SimilarReport_C:WidgetTree.T_Category_1.Text #. Key:	B2EF4D79485AF3E26DFB17A603F98AFF #. SourceLocation:	/Game/Blueprints/Vehicles/Boats/UMG_BoatStorage.UMG_BoatStorage_C:ExecuteUbergraph_UMG_BoatStorage [Script Bytecode] #. Key:	C6A8A4034526E331C673D4AC8C902F72 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Chest.UMG_Chest_C:ExecuteUbergraph_UMG_Chest [Script Bytecode] #: /Game/Blueprints/Vehicles/Boats/UMG_BoatStorage.UMG_BoatStorage_C:ExecuteUbergraph_UMG_BoatStorage [Script Bytecode] #: /Game/GenericRadialMenus/Templates/UMG_MultiMenuTemplate.UMG_MultiMenuTemplate_C:WidgetTree.CategoryTitle.Text #: /Game/Widgets/Inventory/UMG_Chest.UMG_Chest_C:ExecuteUbergraph_UMG_Chest [Script Bytecode] #: /Game/Widgets/MainMenu/Feedbackform/UMG_SimilarReport.UMG_SimilarReport_C:WidgetTree.T_Category_1.Text msgid "Category"
msgstr "Kategori"  #. Key:	3A03161C4083827C59AFD792BD9CB4A6 #. SourceLocation:	/Game/Blueprints/Vehicles/Boats/UMG_BoatStorage.UMG_BoatStorage_C:ExecuteUbergraph_UMG_BoatStorage [Script Bytecode] #. Key:	86A370B94A659CC0D169B38A7CC5CBAC #. SourceLocation:	/Game/Widgets/Inventory/UMG_Chest.UMG_Chest_C:ExecuteUbergraph_UMG_Chest [Script Bytecode] #: /Game/Blueprints/Vehicles/Boats/UMG_BoatStorage.UMG_BoatStorage_C:ExecuteUbergraph_UMG_BoatStorage [Script Bytecode] #: /Game/Widgets/Inventory/UMG_Chest.UMG_Chest_C:ExecuteUbergraph_UMG_Chest [Script Bytecode] msgid "Rarity"
msgstr "Tingkat Kelangkaan"  #. Key:	0B4AD2BF4327BA6A2036B1B0762E439C #. SourceLocation:	/Game/Blueprints/Vehicles/Boats/UMG_BoatStorage.UMG_BoatStorage_C:WidgetTree.T_PlayerName.Text #. Key:	731C2A1640ECEEB90134738B15B87368 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Chest.UMG_Chest_C:WidgetTree.T_PlayerName.Text #: /Game/Blueprints/Vehicles/Boats/UMG_BoatStorage.UMG_BoatStorage_C:WidgetTree.T_PlayerName.Text #: /Game/Widgets/Inventory/UMG_Chest.UMG_Chest_C:WidgetTree.T_PlayerName.Text msgid "Player"
msgstr "Pemain"  #. Key:	27496A2D48FAA2C0B21B89837CB1A3D5 #. SourceLocation:	/Game/Widgets/Modding/UMG_WorkshopUpload.UMG_WorkshopUpload_C:WidgetTree.ET_Desc.HintText #. Key:	4C4073BB4B2AE515F69FA3A2899770E5 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_SimilarReport.UMG_SimilarReport_C:WidgetTree.T_Description_1.Text #. Key:	5B14FC374B5B51C138F9BC85ED261CB7 #. SourceLocation:	/Game/Widgets/Modding/UMG_WorkshopUpload.UMG_WorkshopUpload_C:WidgetTree.ET_Desc_1.HintText #. Key:	E9E1449A4A60DEB44974FC86E1F001C5 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor.Default__A_Vendor_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor.Default__A_Vendor_C.VendorDescription #: /Game/Widgets/MainMenu/Feedbackform/UMG_SimilarReport.UMG_SimilarReport_C:WidgetTree.T_Description_1.Text #: /Game/Widgets/Modding/UMG_WorkshopUpload.UMG_WorkshopUpload_C:WidgetTree.ET_Desc.HintText #: /Game/Widgets/Modding/UMG_WorkshopUpload.UMG_WorkshopUpload_C:WidgetTree.ET_Desc_1.HintText msgid "Description"
msgstr "Deskripsi"  #. Key:	40E8517D4F8E5A79DDBD549255A3D1AE #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_AFarmingShop_A.Default__A_Vendor_AFarmingShop_A_C.Vendor Name #. Key:	4C165EAB4E2B338A1A25B1B27B0CAA0D #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_AFarmingShop_B.Default__A_Vendor_AFarmingShop_B_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_AFarmingShop_A.Default__A_Vendor_AFarmingShop_A_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_AFarmingShop_B.Default__A_Vendor_AFarmingShop_B_C.Vendor Name msgid "A's Farming Shop"
msgstr "Toko Pertanian A"  #. Key:	51FC901B4878524A277FEE94770703AD #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_AFarmingShop_B.Default__A_Vendor_AFarmingShop_B_C.VendorDescription #. Key:	F9F9B53B4FDE08B8B4E2C3A200E10F3E #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_AFarmingShop_A.Default__A_Vendor_AFarmingShop_A_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_AFarmingShop_A.Default__A_Vendor_AFarmingShop_A_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_AFarmingShop_B.Default__A_Vendor_AFarmingShop_B_C.VendorDescription msgid "I'd rather eat animals, but this is probably more sustainable.\r\n\r\nSetup your home tent and start farming. Turn seeds into edible fruit and bring it all here.\r\n\r\nRemeber to guard your plants. A lot of berry thieves around here.\r\n\r\n-A"
msgstr "Aku lebih memilih untuk makan hewan, tapi ini sepertinya lebih terjamin\r\n\r\nBangun tenda rumah mu dan mulai bercocok tanam. Ubah benih menjadi buah-buahan dan bawa semua kemari\r\n\r\nIngat untuk menjaga tanamanmu. Banyak maling buah disekitar sini.\r\n\r"  #. Key:	3CDFF3B74C02BEC17E63D1AFE130C5CF #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_PlayerPlaced.A_Vendor_PlayerPlaced_C:ExecuteUbergraph_A_Vendor_PlayerPlaced [Script Bytecode] #. Key:	907EA07C4134B67FFF92CBBF3EA80494 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_AI.A_Vendor_AI_C:ExecuteUbergraph_A_Vendor_AI [Script Bytecode] #: /Game/Blueprints/Vendor/A_Vendor_AI.A_Vendor_AI_C:ExecuteUbergraph_A_Vendor_AI [Script Bytecode] #: /Game/Blueprints/Vendor/A_Vendor_PlayerPlaced.A_Vendor_PlayerPlaced_C:ExecuteUbergraph_A_Vendor_PlayerPlaced [Script Bytecode] msgid "Vendor is already used by someone else"
msgstr "Vendor telah digunakan oleh orang lain"  #. Key:	779CFCE44E0F78E94247F5B7ACD4FF86 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_AllCompendium.Default__A_Vendor_AllCompendium_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_AllCompendium.Default__A_Vendor_AllCompendium_C.Vendor Name msgid "Tom"
msgstr "Tom"  #. Key:	C124C4DC43B6CF053B42DE86135EB2C7 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_AllCompendium.Default__A_Vendor_AllCompendium_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_AllCompendium.Default__A_Vendor_AllCompendium_C.VendorDescription msgid "Oh, this was unexpected. I was not expecting company here so far north! I initially came here for some peace and quiet, but I cannot say that I am not pleased to have some company at last. I have been collecting hats my whole life, and it seems that you are quite a collector as well. I would be happy to trade things since I have no use for Mk up here.\r\n\r\n-Tom"
msgstr "Oh, ini tidak terduga. Saya tidak menyangka akan ada banyak orang di sini, di tempat yang jauh di utara ini! Awalnya saya datang ke sini untuk mencari kedamaian dan ketenangan, tetapi saya tidak bisa mengatakan bahwa saya tidak senang karena akhirnya ada yang menemani saya. Saya telah mengoleksi topi sepanjang hidup saya, dan tampaknya Anda juga seorang kolektor. Saya akan dengan senang hati menukar barang, karena saya tidak menggunakan Mk di sini.\r\n\r\n-Tom"  #. Key:	832AFE2D423DF7B31DB8888054F62C7D #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Arena.Default__A_Vendor_Arena_C.Vendor Name #. Key:	F4846A1E499A748C4F55B388C75FD8CF #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_ArenaReward.Default__A_Vendor_ArenaReward_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Arena.Default__A_Vendor_Arena_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_ArenaReward.Default__A_Vendor_ArenaReward_C.Vendor Name msgid "Jacks Arena "
msgstr "Arena Jack "  #. Key:	3CCB82CE45FB2AEE61AAE69F925FB283 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Arena.Default__A_Vendor_Arena_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Arena.Default__A_Vendor_Arena_C.VendorDescription msgid "You are going to try your luck in the arena eh? I want to prepare you as much as possible for your challenge. \r\n\r\nIf you find any good loot that you don't want to keep. Just sell it over to James and he will distribute it.\r\n\r\n- Jack"
msgstr "Anda akan mencoba keberuntungan Anda di arena ya? Saya ingin mempersiapkan Anda sebaik mungkin untuk menghadapi tantangan Anda. \\\r \r\nJika Anda menemukan jarahan bagus yang tidak ingin Anda simpan. Jual saja kepada James dan dia akan mendistribusikannya.\\\r \r\n- Jack"  #. Key:	4600FF67479C14E7012884925424BC6C #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_ArenaReward.Default__A_Vendor_ArenaReward_C.VendorCatalogue(4).VendorCatalogue.VendorItem_49_9649B8424E045E3B665EEEAAAF1394BD.Name_95_49AEBAFF411339CDDC5B75BD9B47F68E #: /Game/Blueprints/Vendor/A_Vendor_ArenaReward.Default__A_Vendor_ArenaReward_C.VendorCatalogue(4).VendorCatalogue.VendorItem_49_9649B8424E045E3B665EEEAAAF1394BD.Name_95_49AEBAFF411339CDDC5B75BD9B47F68E msgid "Machinegun Turret"
msgstr "Meriam Turret"  #. Key:	25BBCD0343430AC49B06E2A4934CA966 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_ArenaReward.Default__A_Vendor_ArenaReward_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_ArenaReward.Default__A_Vendor_ArenaReward_C.VendorDescription msgid "Oh, you found my little hideout! Here you can take your chances in the arena. Every hour at :00, I distribute one token and other items I've managed to gather in the chests. Once you have 8 tokens and learn how to craft them into a master token with a blueprint, you can trade it in for an exclusive black bear mount!"
msgstr "Oh, kamu menemukan persembunyian kecilku! Di sini Anda dapat mencoba keberuntungan Anda di arena. Setiap jam pada :00, saya mendistribusikan satu token dan barang lain yang berhasil saya kumpulkan di peti. Setelah Anda memiliki 8 token dan belajar bagaimana mengolah mereka menjadi token master dengan cetakan, Anda dapat menukarnya dengan tungangan beruang hitam eksklusif!"  #. Key:	F0786E0A46F6E1C5C18976B13A982FD1 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_ChangingCatalog.A_Vendor_ChangingCatalog_C:OnRep_SecondsTillNextRoll [Script Bytecode] #. Key:	FF639E6A4BB53308AB240D89F30A920F #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_BlackMarket.A_Vendor_BlackMarket_C:OnRep_SecondsTillNextRoll [Script Bytecode] #: /Game/Blueprints/Vendor/A_Vendor_BlackMarket.A_Vendor_BlackMarket_C:OnRep_SecondsTillNextRoll [Script Bytecode] #: /Game/Blueprints/Vendor/A_Vendor_ChangingCatalog.A_Vendor_ChangingCatalog_C:OnRep_SecondsTillNextRoll [Script Bytecode] msgid "New catalog in:"
msgstr "Katalog Baru:"  #. Key:	C453E0874ABFDB76AD3A738DB05FB1EA #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_BlackMarket.Default__A_Vendor_BlackMarket_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_BlackMarket.Default__A_Vendor_BlackMarket_C.Vendor Name msgid "Arttu's Black Market"
msgstr "Pasar Gelap Arttu"  #. Key:	630923F14D358C28D4C777B666802376 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_BlackMarket.Default__A_Vendor_BlackMarket_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_BlackMarket.Default__A_Vendor_BlackMarket_C.VendorDescription msgid "Oh hi, I was not expecting to see someone here. There's an Oil Rig just north of here if you have a boat. I've been doing loot runs there for quite a while and I have some stock ready to sell. I know prices are a bit on the expensive side, but I'm the only one here who can get this stuff. Arttu"
msgstr "Oh hai, Saya tidak mengharap untuk melihat seseorang di sini. Ada Rig Minyak hanya di sebelah utara dari sini jika Anda memiliki perahu. Saya telah melakukan lari loot di sana untuk waktu yang cukup lama dan saya memiliki beberapa persediaan siap untuk dijual. Saya tahu harga agak mahal, tetapi saya satu-satunya di sini yang bisa mendapatkan barang ini. Arttu"  #. Key:	C78A9355453FD9CC25A950AAF3E5348B #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Casino.Default__A_Vendor_Casino_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Casino.Default__A_Vendor_Casino_C.Vendor Name msgid "Vendo-O"
msgstr "Vendo-O"  #. Key:	C497AFD3472BFF44CC4C0F9BF538ED0B #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Casino.Default__A_Vendor_Casino_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Casino.Default__A_Vendor_Casino_C.VendorDescription msgid "Come on over to Vendo-O, offering Slorbo drinks as you give the dice games a shot! Satisfy your thirst with our unique beverages while you try your luck at the tables, and remember to fill up on our deliciously unusual fish dishes. So, don't wait – come and enjoy the fun at Vendo-O – it's a fantastic mix!"
msgstr "Kemarilah ke Vendo-O, menawarkan minuman Slorbo saat Anda mencoba permainan dadu! Puaskan dahaga Anda dengan minuman unik kami sambil mencoba keberuntungan di meja, dan jangan lupa untuk mengisi dengan hidangan ikan yang lezat dan tidak biasa. Jadi, jangan menunggu - datang dan nikmati keseruannya di Vendo-O - perpaduan yang fantastis!"  #. Key:	A39FA8FA47E1F0F4EE26A5A9C9CAF641 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_ChangingCatalog.Default__A_Vendor_ChangingCatalog_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_ChangingCatalog.Default__A_Vendor_ChangingCatalog_C.Vendor Name msgid "Julia's Mysterios Shop"
msgstr "Toko Misteri Julia"  #. Key:	8E5FB2E14DE5C41583EB819D2B01507F #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_ChangingCatalog.Default__A_Vendor_ChangingCatalog_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_ChangingCatalog.Default__A_Vendor_ChangingCatalog_C.VendorDescription msgid "Hi there!\r\n\r\nI always love to meet new researchers around the island.\r\n\r\nIf nothing here suits you now. Please check the clock and come back to see what new items have arrived from over the seas"
msgstr "Hai.!\r\n\r\nSaya selalu senang bertemu dengan para peneliti baru di sekitar pulau ini.\r\n\r\nJika tidak ada yang cocok untuk Anda sekarang. Silakan periksa waktu dan kembali lagi untuk melihat barang baru apa saja yang tiba dari seberang lautan"  #. Key:	988AD2EE4A07B6EAFF873DB7A2BA2296 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Cooking.Default__A_Vendor_Cooking_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Cooking.Default__A_Vendor_Cooking_C.VendorDescription msgid "Excellent! You've managed to experiment with and cook everything on the menu! Now that you're an expert, grab yourself a cooking hat. I can't quite explain it, but everything just seems to go faster when I'm wearing that!"
msgstr "Luar biasa! Anda telah berhasil bereksperimen dan memasak semua yang ada di menu! Sekarang setelah Anda menjadi seorang ahli, belilah topi masak untuk diri Anda sendiri. Saya tidak bisa menjelaskannya, tetapi semuanya terasa lebih cepat ketika saya mengenakannya!"  #. Key:	288363C84B30D991BBDC688E2F1322DA #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_HuntingReward.Default__A_Vendor_HuntingReward_C.Vendor Name #. Key:	35F6205F4356135389F2AE9DAB5C2B22 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Feather.Default__A_Vendor_Feather_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Feather.Default__A_Vendor_Feather_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_HuntingReward.Default__A_Vendor_HuntingReward_C.Vendor Name msgid "Filemon"
msgstr "Filemon"  #. Key:	57C66F2941664901EB43AD9505BAB0B7 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Feather.Default__A_Vendor_Feather_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Feather.Default__A_Vendor_Feather_C.VendorDescription msgid "I will be happy to buy all sorts of feathers and other animal stuff you find on the island. Feel free to come and say hello to me at Padva island!\r\n\r\n-Filemon"
msgstr "Saya akan dengan senang hati membeli semua jenis bulu dan benda-benda binatang lainnya yang Anda temukan di pulau ini. Jangan ragu untuk datang dan menyapa saya di pulau Padva!\\\r \r\n-Filemon"  #. Key:	3D63A59142F48DA48DFC17AC6D4A94C8 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Fishing.Default__A_Vendor_Fishing_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Fishing.Default__A_Vendor_Fishing_C.Vendor Name msgid "Sgt. Lake's Kitchen"
msgstr "Dapur Sgt. Lake"  #. Key:	AEA3EC4145251935C0B1D3A88FD0444A #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Fishing.Default__A_Vendor_Fishing_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Fishing.Default__A_Vendor_Fishing_C.VendorDescription msgid "Want to be useful for once? Grab a fishing rod from us and go fishing.\r\n\r\nThis island has a healthy fish population, which makes for a healthy researcher population.\r\n\r\nWhat are you standing there? Go find the best spots!\r\n\r\n-Sgt. Lake"
msgstr "Ingin berguna untuk sekali saja? Ambil joran dari kami dan pergilah memancing.\r\n\r\nPulau ini memiliki populasi ikan yang sehat, yang menjadikannya tempat yang baik bagi para peneliti.\r\n\r\nApa yang Anda lakukan di sana? Cari tempat yang terbaik!\r\n\r\n-Sgt. Lake"  #. Key:	846A35EC4EC544A4F8411497059091C0 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_FishingReward.Default__A_Vendor_FishingReward_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_FishingReward.Default__A_Vendor_FishingReward_C.Vendor Name msgid "Sgt. Lake"
msgstr "Sersan Lake"  #. Key:	CDEE383C41B1D77A440D6D8663AD4954 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_FishingReward.Default__A_Vendor_FishingReward_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_FishingReward.Default__A_Vendor_FishingReward_C.VendorDescription msgid "Well done! You finished the most important compendium list there is, be proud of yourself and wear the hat with pride!\r\n\r\n-Sgt. Lake"
msgstr "Bagus! Anda menyelesaikan daftar kompendium terpenting yang ada, bangga pada diri sendiri dan kenakan topi dengan bangga!\r\n\r\n-Sgt. Lake""  #. Key:	5C29609D4155E15693E38AA59C6BAB39 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_GeneralStore.Default__A_Vendor_GeneralStore_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_GeneralStore.Default__A_Vendor_GeneralStore_C.Vendor Name msgid "James General Store"
msgstr "Toko Serba Ada James"  #. Key:	05BBB65A4D84000C0D00BEB5949F2D5C #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_GeneralStore.Default__A_Vendor_GeneralStore_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_GeneralStore.Default__A_Vendor_GeneralStore_C.VendorDescription msgid "Have any items that you dont have any need to?\r\n\r\nIf the answer is yes then just hand it over to me. I buy everything from you for reduced cost of course.\r\n\r\n-James"
msgstr "Punya barang yang tidak kamu butuhkan?\r\n\r\nKalau jawabannya iya, berikan kepada ku. Aku membeli semua dari kamu dengan harga yang lebih rendah tentunya.\r\n\r\n-James"  #. Key:	0FD5BA114E3F42D9CC270BA909A26CA8 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Hermit.A_Vendor_Hermit_C:ExecuteUbergraph_A_Vendor_Hermit [Script Bytecode] #: /Game/Blueprints/Vendor/A_Vendor_Hermit.A_Vendor_Hermit_C:ExecuteUbergraph_A_Vendor_Hermit [Script Bytecode] msgid "You dont have any soup in your inventory!"
msgstr "Kamu tidak punya sup apapun di penyimpananmu!"  #. Key:	D08C3CEB44DE8614075FEBB97E68AED2 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Hermit.Default__A_Vendor_Hermit_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Hermit.Default__A_Vendor_Hermit_C.Vendor Name msgid "Hermit"
msgstr "Pertapa"  #. Key:	904681DB43A58D5421DB02B9668E3F7E #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Hermit.Default__A_Vendor_Hermit_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Hermit.Default__A_Vendor_Hermit_C.VendorDescription msgid "Some say that I was once a skilled healer. I was born with a deep connection to nature and the spirits of the mountain. I have valuable knowledge about the local flora and fauna and can trade you my findings and belongings for mysterious bags."
msgstr "Ada yang mengatakan bahwa saya dulunya adalah seorang penyembuh yang terampil. Saya terlahir dengan hubungan yang mendalam dengan alam dan roh-roh gunung. Saya memiliki pengetahuan yang berharga tentang flora dan fauna setempat dan dapat menukarkan temuan dan barang-barang saya dengan tas misterius."  #. Key:	33BDC5694E4BAFFF48985D954327C515 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_HuntingReward.Default__A_Vendor_HuntingReward_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_HuntingReward.Default__A_Vendor_HuntingReward_C.VendorDescription msgid "Only hunters that enjoy the killing have made it this far. Shooting a bird wihout damaging it's feathers ain't no easy task my firend. Be proud.\r\n\r\n-Filemon"
msgstr "Hanya pemburu yang menyukai pembunuhan yang bisa menjangkau sejauh ini. Menembak burung tanpa merusak bulunya adalah hal yang tidak mudah sobat. Berbahagialah.\r\n\r\n-Filemon"  #. Key:	741402444C4A63FA612F18A11592C5C3 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_IslandBenefits.Default__A_Vendor_IslandBenefits_C.Vendor Name #. Key:	E7D10332410E3E6C920C2090B4CBFC4E #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_IslandBenefits_Shop.Default__A_Vendor_IslandBenefits_Shop_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_IslandBenefits.Default__A_Vendor_IslandBenefits_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_IslandBenefits_Shop.Default__A_Vendor_IslandBenefits_Shop_C.Vendor Name msgid "LRI Benefits station"
msgstr "Stasiun Manfaat LRI"  #. Key:	4D35CC314B10B2583930AE9A990C5C4D #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_IslandBenefits.Default__A_Vendor_IslandBenefits_C.VendorDescription #. Key:	7009FB99483F5DC8771D528AE6F732E1 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_IslandBenefits_Shop.Default__A_Vendor_IslandBenefits_Shop_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_IslandBenefits.Default__A_Vendor_IslandBenefits_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_IslandBenefits_Shop.Default__A_Vendor_IslandBenefits_Shop_C.VendorDescription msgid "Welcome to the Longvinter Research Industries Benefits , providing exclusive perks for esteemed LRI  members. Enhance your Longvinter Island experience with additional house rights and secure your valuables in our state-of-the-art Global Vault. Our experienced staff ensures world-class service and assistance tailored to your unique needs. Visit us today on any of our locations."
msgstr "Selamat datang di Longvinter Research Industries Benefits, yang memberikan fasilitas eksklusif bagi para anggota LRI yang terhormat. Tingkatkan pengalaman Anda di Longvinter Island dengan hak rumah tambahan dan amankan barang berharga Anda di ruang penyimpanan Global kami yang canggih. Staf kami yang berpengalaman memastikan layanan dan bantuan kelas dunia yang disesuaikan dengan kebutuhan unik Anda. Kunjungi kami hari ini di salah satu lokasi kami."  #. Key:	436E3A2D413E9F9AB1BDCBA4ADCA9607 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_KyrresEquipment.Default__A_Vendor_KyrresEquipment_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_KyrresEquipment.Default__A_Vendor_KyrresEquipment_C.Vendor Name msgid "Kyrre's Equipment"
msgstr "Peralatan Kyrre"  #. Key:	DFE2EEBB4051F77DC417AEB94D270F73 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_KyrresEquipment.Default__A_Vendor_KyrresEquipment_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_KyrresEquipment.Default__A_Vendor_KyrresEquipment_C.VendorDescription msgid "Think you're going to carry everything on that tiny backpack of yours? Didn't think so either.\r\n\r\nGet yourself a tent and some containers to ease that load and keep your findings safe! Only you can enter the tent, so you're safe. Don't ask me how it works like that, it just does.\r\n\r\n-Kyrre"
msgstr "Kamu pikir akan membawa semuanya di ransel kecil itu milikmu? Aku juga tidak berpikir begitu.\r\n\r\nDapatkan tenda dan beberapa wadah untuk meringankan beban dan menjaga penemuan Anda aman! Hanya Anda yang dapat memasuki tenda, jadi Anda aman. Jangan tanya aku bagaimana bisa begitu, memang begitulah adanya.\r\n\r\n-Kyrre"  #. Key:	776697704440B4A2911469BAB7E434A4 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Mining.Default__A_Vendor_Mining_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Mining.Default__A_Vendor_Mining_C.Vendor Name msgid "Dan"
msgstr "Dan"  #. Key:	B6ACF5A846FFB62177F65CA6661AF695 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Mining.Default__A_Vendor_Mining_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Mining.Default__A_Vendor_Mining_C.VendorDescription msgid "Got a hunger for adventure? Grab a pickaxe from me and let's get mining. Mines are filled with precious resources, and we need miners like you to uncover them. \r\n\r\nWhat are you waiting for? Dive into the depths and unearth riches!\r\n\r\n-Dan"
msgstr "Anda haus akan petualangan? Ambil Pakur dariku dan mari kita mulai menambang. Tambang dipenuhi dengan sumber daya yang berharga, dan kami membutuhkan penambang seperti Anda untuk menemukannya. \r\n\r\nApa lagi yang Anda tunggu? Menyelam ke kedalaman dan menggali kekayaan!\r\n\r\n-Dan"  #. Key:	B4AC1E5E476B6F7E1971439F545BDE10 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_MrsSnow.Default__A_Vendor_MrsSnow_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_MrsSnow.Default__A_Vendor_MrsSnow_C.Vendor Name msgid "Mrs. Snow's Outpost"
msgstr "Pos Nyonya Snow"  #. Key:	D51A4AD9470A1442C794F5A82A9E334F #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_MrsSnow.Default__A_Vendor_MrsSnow_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_MrsSnow.Default__A_Vendor_MrsSnow_C.VendorDescription msgid "Hello handsome! You look a little lost, let me help you:\r\n\r\nBring me some fish or berries, and I'll pay you well! The fish here is amazing. You should cook some for yourself while you're at it.\r\n\r\nI used to live in the city. I had a career as a lawyer. I did everything you're supposed to do I guess, but it wasn't cutting it. I wanted to find the thing I'm passionate about, so I joined the research program, and I'm still here, happy as one could be. Nature was the thing for me. I hope you find your happiness too, or whatever you are looking for.\r\n\r\n- Mrs. Snow"
msgstr "Halo tampan! Kamu terlihat sedikit tersesat, biar aku membantumu:\r\n\r\nBawakan aku beberapa ikan atau beri, dan aku akan membayarmu dengan baik! Ikan di sini sangat luar biasa. Kamu harus memasaknya untuk dirimu sendiri juga.\r\n\r\nAku dulu tinggal di kota. Aku memiliki karir sebagai pengacara. Aku melakukan segalanya seperti yang seharusnya kulakukan kurasa, tetapi itu tidak cukup. Aku ingin menemukan hal yang membuatku bersemangat, jadi aku bergabung dengan program penelitian, dan aku masih di sini, bahagia seperti yang bisa diharapkan. Alam adalah hal yang tepat untukku. Aku harap kamu juga menemukan kebahagiaanmu, atau apapun yang kamu cari.\r\n\r\n- Ny. Snow"  #. Key:	7BDF864D45144514035A22B54314B9A0 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Pix.Default__A_Vendor_Pix_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Pix.Default__A_Vendor_Pix_C.Vendor Name msgid "Pix"
msgstr "Pix"  #. Key:	31B7FD1446463FA1130A0BB92D80D13A #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Pix.Default__A_Vendor_Pix_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Pix.Default__A_Vendor_Pix_C.VendorDescription msgid "Hey there! If you ever find any mysterious bags lying around, bring them to me and I'll give you something in return!\r\n\r\nI'm too short to wander around the island all day looking for those, It gets too exhausting, so I setup this vending machine to trade with the researchers that do have normal size legs.\r\n\r\nWhat do the bags contain, and who is Anders? That I cannot tell you. "
msgstr "Hey kamu! kalau kamu menemukan tas misterius, bawa ke aku dan aku akan beri kamu sesuatu!\r\n\r\nAku terlalu pendek untuk menjelajahi pulau ini sepanjang hari untuk mencari tas-tas itu, sangat melelahkan, jadi aku pasang alat ini untuk berdagang dengan peneliti yang ounya kaki normal.\r\n\r\nApa isi tasnya, dan siapa Anders? Ku tak bisa kasih tahu. "  #. Key:	DBC0400441F53360680279AD2F1F0504 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_PlantReward.Default__A_Vendor_PlantReward_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_PlantReward.Default__A_Vendor_PlantReward_C.Vendor Name msgid "Angel"
msgstr "Malaikat"  #. Key:	2F9AF32A4B239F2F59C0578EF4F19073 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_PlantReward.Default__A_Vendor_PlantReward_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_PlantReward.Default__A_Vendor_PlantReward_C.VendorDescription msgid "You've found all the known plants on the island! Thats some great reseach my friend! On average it seems like there are new plants found every month, so keep your eyes open when exploring!\r\n\r\n-Angel"
msgstr "Kamu telah menemukan semua tanaman yang dikenal di pulau! Riset yang bagus, kawan! Rata-rata, sepertinya ada tanaman baru yang ditemukan setiap bulan, jadi tetap buka matamu selama menjelajah!\r\n\r\n-Angel"  #. Key:	A0F9D06D4CF4A9812AB974A659AACA81 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_PlayerPlaced.A_Vendor_PlayerPlaced_C:ExecuteUbergraph_A_Vendor_PlayerPlaced [Script Bytecode] #: /Game/Blueprints/Vendor/A_Vendor_PlayerPlaced.A_Vendor_PlayerPlaced_C:ExecuteUbergraph_A_Vendor_PlayerPlaced [Script Bytecode] msgid "Vendor Items"
msgstr "Barang Pedagang"  #. Key:	C981F9BB45D416A9B61CAAA25BB3C7C6 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_PlayerPlaced.A_Vendor_PlayerPlaced_C:ExecuteUbergraph_A_Vendor_PlayerPlaced [Script Bytecode] #: /Game/Blueprints/Vendor/A_Vendor_PlayerPlaced.A_Vendor_PlayerPlaced_C:ExecuteUbergraph_A_Vendor_PlayerPlaced [Script Bytecode] msgid "Vendor is currently used by someone else"
msgstr "Penjual sedang digunakan oleh orang lain"  #. Key:	86B4B2BB45420B38A1F537817D3CFCC1 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_PlayerPlaced_Shop.Default__A_Vendor_PlayerPlaced_Shop_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_PlayerPlaced_Shop.Default__A_Vendor_PlayerPlaced_Shop_C.VendorDescription msgid "Shop catalogue"
msgstr "Katalog toko"  #. Key:	7418A6EB4B37A8800B722FBCA60F79FC #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Starting_Collectables.Default__A_Vendor_Starting_Collectables_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Starting_Collectables.Default__A_Vendor_Starting_Collectables_C.Vendor Name msgid "Jax's Outopost"
msgstr "Pos terdepan Jax"  #. Key:	090926ED493BFF326B2758A96C950B6A #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Starting_Collectables.Default__A_Vendor_Starting_Collectables_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Starting_Collectables.Default__A_Vendor_Starting_Collectables_C.VendorDescription msgid "I offer all the essential items for cheap here! Also, I buy some berries I am really fond of. I offer all the necessary items for cheap here!\r\n\r\nI also buy some berries that I'm really fond of.\r\n\r\nDon't knock on the door\r\n\r\n-Jax"
msgstr "Aku menawarkan semua item penting dengan harga murah di sini! Aku juga membeli buah berry yang aku sangat suka. Aku menawarkan semua item yang dibutuhkan dengan harga murah di sini!\r\n\r\nAku juga membeli buah berry yang aku sangat suka.\r\n\r\nJangan mengetuk pintu\r\n\r\n-Jax"  #. Key:	A1898892439F1CE585F0AB9AD2A26890 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Tim.Default__A_Vendor_Tim_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Tim.Default__A_Vendor_Tim_C.Vendor Name msgid "Tim's Outpost"
msgstr "Pos terdepan Tim"  #. Key:	76BC4E534375B11BB9009AA6430E536A #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Tim.Default__A_Vendor_Tim_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Tim.Default__A_Vendor_Tim_C.VendorDescription msgid "Are you lost? Just asking. You don't look like the type that usually wanders around here, you know, the tough type.\r\n\r\nHere are some tools if you want to buy any, but let's be real here, you look more like a berry gatherer than anything else, just in my opinion of course. Bring the berries to me, and I'll ship them off to a local beverage factory\r\n\r\nDon't knock on the door\r\n\r\n-Tim"
msgstr "Kamu tersasar? Hanya bertanta. Kamu tidak seperti tipe orang-orang yang berkelana kemari, ya tahulah, orang-orang kuat.\r\n\r\nIni beberapa alat jika kamu mau membeli nya, tapi kalo kita serius, kamu lebih seperti orang yang memanen berry daripada tipe yang lain, cuman opini ku. Bawakan berry-berry itu ke aku, dan akan aku kirimkan ke pabrik minuman terdekat.\r\n\r\nGedor pintu, gua gedor balik.\r\n\r\n-Tim"  #. Key:	94051A304AC82D5D0C608E9F89F039E5 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Trailer.Default__A_Vendor_Trailer_C.Vendor Name #: /Game/Blueprints/Vendor/A_Vendor_Trailer.Default__A_Vendor_Trailer_C.Vendor Name msgid "Trailer Vendor"
msgstr "Vendor Trailer"  #. Key:	D5A1FDE543889CFE1575DC9B662061D4 #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_Trailer.Default__A_Vendor_Trailer_C.VendorDescription #: /Game/Blueprints/Vendor/A_Vendor_Trailer.Default__A_Vendor_Trailer_C.VendorDescription msgid "Placeholder"
msgstr "Penampung"  #. Key:	DF87A8B442D673F61A3B7A881E86DAA7 #. SourceLocation:	/Game/Blueprints/Vendor/generalStoreItemType.generalStoreItemType.DisplayNameMap(0 - Value).DisplayNameMap #: /Game/Blueprints/Vendor/generalStoreItemType.generalStoreItemType.DisplayNameMap(0 - Value).DisplayNameMap msgid "basketItem"
msgstr "barang keranjang"  #. Key:	E127C00646FD662D35B5179163EEFC80 #. SourceLocation:	/Game/Blueprints/Vendor/generalStoreItemType.generalStoreItemType.DisplayNameMap(1 - Value).DisplayNameMap #: /Game/Blueprints/Vendor/generalStoreItemType.generalStoreItemType.DisplayNameMap(1 - Value).DisplayNameMap msgid "storeInventoryItem"
msgstr "item persediaan toko"  #. Key:	95A25EC94296E4582DDE5FAAF2FA193D #. SourceLocation:	/Game/Blueprints/Vendor/UMG_GeneralStore.UMG_GeneralStore_C:WidgetTree.T_PageNum.Text #: /Game/Blueprints/Vendor/UMG_GeneralStore.UMG_GeneralStore_C:WidgetTree.T_PageNum.Text msgid "1/10"
msgstr "1/10"  #. Key:	985948B343BEE00F0CC4EEAC54C7E807 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_GeneralStore.UMG_GeneralStore_C:WidgetTree.tabText.Text #: /Game/Blueprints/Vendor/UMG_GeneralStore.UMG_GeneralStore_C:WidgetTree.tabText.Text msgid "Sell"
msgstr "Jual"  #. Key:	2C895EC04C39223397A69C87699849C7 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_GeneralStore.UMG_GeneralStore_C:WidgetTree.TextBlock_173.Text #: /Game/Blueprints/Vendor/UMG_GeneralStore.UMG_GeneralStore_C:WidgetTree.TextBlock_173.Text msgid " Sell items "
msgstr " Jual barang "  #. Key:	C73507124ADC32D459FA91A06C45D67D #. SourceLocation:	/Game/Blueprints/Vendor/UMG_VendorEditorContent.Default__UMG_VendorEditorContent_C.forTextConstant #. Key:	C8476FE94D39FB41230F52B174AA78D9 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Item.UMG_Item_C:ExecuteUbergraph_UMG_Item [Script Bytecode] #. Key:	EA676A8E44C4AFB7CFC9F1BB0820142D #. SourceLocation:	/Game/Blueprints/Vendor/UMG_GeneralStore_Item.Default__UMG_GeneralStore_Item_C.forConstantText #. Key:	EE3EA232436288A5B786AAB3998A9D56 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_VendorContent.Default__UMG_VendorContent_C.forTextConstant #: /Game/Blueprints/Vendor/UMG_GeneralStore_Item.Default__UMG_GeneralStore_Item_C.forConstantText #: /Game/Blueprints/Vendor/UMG_VendorContent.Default__UMG_VendorContent_C.forTextConstant #: /Game/Blueprints/Vendor/UMG_VendorEditorContent.Default__UMG_VendorEditorContent_C.forTextConstant #: /Game/Widgets/Inventory/UMG_Item.UMG_Item_C:ExecuteUbergraph_UMG_Item [Script Bytecode] msgid "for"
msgstr "untuk"  #. Key:	D71D57FB4125A49552ED98A76B24C308 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_NoItems.UMG_NoItems_C:WidgetTree.T_Coordinates.Text #. Key:	E7279F424B66E8977BFE80A9CD143182 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_VendorEditor.UMG_VendorEditor_C:WidgetTree.UMG_NoItems.Text #: /Game/Blueprints/Vendor/UMG_NoItems.UMG_NoItems_C:WidgetTree.T_Coordinates.Text #: /Game/Blueprints/Vendor/UMG_VendorEditor.UMG_VendorEditor_C:WidgetTree.UMG_NoItems.Text msgid "Add items by clicking inventory."
msgstr "Tambahkan item dengan klik ruang penyimpanan."  #. Key:	3B10C7A24A922107ACED358800E29407 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_VendorEditor.UMG_VendorEditor_C:WidgetTree.UMG_NoItems.Text2 #. Key:	D563ABB34E55099416D13F8C3B76A63F #. SourceLocation:	/Game/Blueprints/Vendor/UMG_NoItems.UMG_NoItems_C:WidgetTree.T_Coordinates_1.Text #: /Game/Blueprints/Vendor/UMG_NoItems.UMG_NoItems_C:WidgetTree.T_Coordinates_1.Text #: /Game/Blueprints/Vendor/UMG_VendorEditor.UMG_VendorEditor_C:WidgetTree.UMG_NoItems.Text2 msgid "Note: Items cannot be retrieved after deposit"
msgstr "Catatan: Barang tidak dapat diambil setelah penyetoran"  #. Key:	3564B1524696473844FB719935BF900C #. SourceLocation:	/Game/Blueprints/Vendor/UMG_ShipmentComplete.UMG_ShipmentComplete_C:WidgetTree.T_TitleStreak.Text #: /Game/Blueprints/Vendor/UMG_ShipmentComplete.UMG_ShipmentComplete_C:WidgetTree.T_TitleStreak.Text msgid "Payment: "
msgstr "Pembayaran: "  #. Key:	57C9F81C4C251D91A2337AB50599274F #. SourceLocation:	/Game/Blueprints/Vendor/UMG_ShipmentComplete.UMG_ShipmentComplete_C:WidgetTree.T_TitleStreak_1.Text #. Key:	6D3E0271419A3AC53C3A63B94EEF3526 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_VendorQuest.UMG_VendorQuest_C:ExecuteUbergraph_UMG_VendorQuest [Script Bytecode] #. Key:	E2DB73ED4B0F22DF470D7BB84E56FDDE #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestCompletedSeparator.UMG_QuestCompletedSeparator_C:WidgetTree.T_QuestName.Text #: /Game/Blueprints/Vendor/UMG_ShipmentComplete.UMG_ShipmentComplete_C:WidgetTree.T_TitleStreak_1.Text #: /Game/Blueprints/Vendor/UMG_VendorQuest.UMG_VendorQuest_C:ExecuteUbergraph_UMG_VendorQuest [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestCompletedSeparator.UMG_QuestCompletedSeparator_C:WidgetTree.T_QuestName.Text msgid "Completed"
msgstr "Selesai"  #. Key:	2B3E90B34394C4CFECBCBD8C307F3137 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_ShipmentDeposit.UMG_ShipmentDeposit_C:WidgetTree.T_Plants_6.Text #: /Game/Blueprints/Vendor/UMG_ShipmentDeposit.UMG_ShipmentDeposit_C:WidgetTree.T_Plants_6.Text msgid "15/30"
msgstr "15/30"  #. Key:	1AB5F4794056B4CFA71BC990DB6D3629 #. SourceLocation:	/Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:WidgetTree.TextBlock.Text #. Key:	6A3FC09D4BE2DD43DF7C6EBDBE635C9C #. SourceLocation:	/Game/Widgets/Inventory/UMG_HouseUpgrade.UMG_HouseUpgrade_C:WidgetTree.TextBlock_6.Text #. Key:	8486654A480F6F07D4B49A86C5932350 #. SourceLocation:	/Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:ExecuteUbergraph_UMG_UpgradeRequirements [Script Bytecode] #. Key:	A2F66FB54192D45A0A1151A63EFCC05E #. SourceLocation:	/Game/Blueprints/Vendor/UMG_ShipmentDeposit.UMG_ShipmentDeposit_C:WidgetTree.TextBlock.Text #: /Game/Blueprints/Vendor/UMG_ShipmentDeposit.UMG_ShipmentDeposit_C:WidgetTree.TextBlock.Text #: /Game/Widgets/Inventory/UMG_HouseUpgrade.UMG_HouseUpgrade_C:WidgetTree.TextBlock_6.Text #: /Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:ExecuteUbergraph_UMG_UpgradeRequirements [Script Bytecode] #: /Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:WidgetTree.TextBlock.Text msgid "Deposit"
msgstr "Setoran"  #. Key:	CCA25DDA4F18EE053C4482A0B9B9D3BC #. SourceLocation:	/Game/Blueprints/Vendor/UMG_ShipmentDeposit.UMG_ShipmentDeposit_C:WidgetTree.TextBlock_3.Text #: /Game/Blueprints/Vendor/UMG_ShipmentDeposit.UMG_ShipmentDeposit_C:WidgetTree.TextBlock_3.Text msgid "Fulfilled"
msgstr "Terpenuhi"  #. Key:	1D89971B413C1692905280998463DA85 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:GetText_0 [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:GetText_0 [Script Bytecode] msgid "Upgrade"
msgstr "Tingkatkan"  #. Key:	C2D04D1B4554E78914DBCD980DE0EC5F #. SourceLocation:	/Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:GetText_0 [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:GetText_0 [Script Bytecode] msgid "Select Home"
msgstr "Pilih Rumah"  #. Key:	57E9831642CD540EC8BA7AB3D31D617C #. SourceLocation:	/Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:WidgetTree.T_KilledYou.Text #: /Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:WidgetTree.T_KilledYou.Text msgid "Choose the house you want to upgrade with increased decay wood storage."
msgstr "Pilih rumah yang ingin Anda tingkatkan dengan meningkatkan penyimpanan kayu yang membusuk."  #. Key:	DC7546D14B2AED454831BFB6F8214872 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:WidgetTree.T_KilledYou_1.Text #: /Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:WidgetTree.T_KilledYou_1.Text msgid "This upgrade will double your house's wood storage capacity, extending the decay time from 1 week to 2 weeks."
msgstr "Peningkatan ini akan menggandakan kapasitas penyimpanan kayu rumah Anda, memperpanjang waktu kerusakan dari 1 minggu menjadi 2 minggu."  #. Key:	4879CCFC4E54794B213AB8A17FB3EA05 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:WidgetTree.T_KilledYou_2.Text #: /Game/Blueprints/Vendor/UMG_UpgradeHomeMap.UMG_UpgradeHomeMap_C:WidgetTree.T_KilledYou_2.Text msgid "Note: The upgrade will not transfer if you dismantle your house, and it must be purchased separately for each house you own."
msgstr "Catatan: Peningkatan tidak akan ditransfer jika Anda membongkar rumah Anda, dan harus dibeli secara terpisah untuk setiap rumah yang Anda miliki."  #. Key:	0043F23045327CA656EF0BB70ED7E237 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] msgid "Complete the farming\r\ncompendium to shop here!"
msgstr "Selesaikan kompendium\r\npertanian untuk berbelanja di sini!"  #. Key:	11D5FBEA40B8F5A0935DC1BEC99A80C3 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] msgid "Complete the compendium\r\nto shop here!"
msgstr "Selesaikan kompedium dahulu\r\nuntuk berbelanja di sini!"  #. Key:	16387B5544A76737A9CB7E9FD729D92C #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] msgid "Complete the Hermit\r\n of the mountain to shop here!"
msgstr "Selesaikan tugas Pertapa\r\n gunung untuk berbelanja di sini!"  #. Key:	490EF4714CD9229BCE2C6FABFB5BD19C #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] msgid "Complete the cooking\r\ncompendium to shop here!"
msgstr "Selesaikan kompedium memasak terlebih dahulu\r\nuntuk berbelanja di sini!"  #. Key:	749F8BA043609F01E3A4599BEBE7CE74 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] msgid "Complete the hunting\r\ncompendium to shop here! "
msgstr "Selesaikan kompedium Berburu terlebih dahulu\r\nuntuk berbelanja di sini! "  #. Key:	9B528B814A020D460F21EEB2DDD9A758 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] msgid "Complete fishing, hunting, farming & cooking compendium to shop here!"
msgstr "Kompendium lengkap tentang memancing, berburu, bertani, dan memasak bisa Anda dapatkan di sini!"  #. Key:	A82F7D98422B0789585D1D96ECECCADC #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:ExecuteUbergraph_UMG_Vendor [Script Bytecode] msgid "Complete the fishing\r\ncompendium to shop here!"
msgstr "Selesaikan kompendium\r\nMemancing untuk berbelanja di sini!"  #. Key:	5341DC8F496BCCDEB1FA26AC0FB99402 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_VendorEditor.UMG_VendorEditor_C:WidgetTree.T_Coordinates.Text #. Key:	540246D84BF06347BB1C519165345995 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:WidgetTree.T_Coordinates.Text #. Key:	93CA0E8C4A0D6BE2523E1CA667B938C8 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:WidgetTree.T_Coordinates.Text #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:WidgetTree.T_Coordinates.Text #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:WidgetTree.T_Coordinates.Text #: /Game/Blueprints/Vendor/UMG_VendorEditor.UMG_VendorEditor_C:WidgetTree.T_Coordinates.Text msgid "Coords"
msgstr "Koordinat"  #. Key:	647D71CA4ACE932E8C210492344A7F05 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.Title_2.Text #. Key:	6729A3CD4FDADB8532EAADADDCE971D1 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:WidgetTree.T_CurrentTab_2.Text #. Key:	A8FBEAC94F6B49C92E8CE297D0B25F8C #. SourceLocation:	/Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:ExecuteUbergraph_UMG_Inventory [Script Bytecode] #. Key:	A99837134BCAE4D0B6CB3EBC4E442643 #. SourceLocation:	/Game/Widgets/Tutorials/E_TutorialType.E_TutorialType.DisplayNameMap(8 - Value).DisplayNameMap #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:WidgetTree.T_CurrentTab_2.Text #: /Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:ExecuteUbergraph_UMG_Inventory [Script Bytecode] #: /Game/Widgets/Tutorials/E_TutorialType.E_TutorialType.DisplayNameMap(8 - Value).DisplayNameMap #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.Title_2.Text msgid "Quests"
msgstr "Misi"  #. Key:	872C6FAB4424B38917E4DBA1F05614FD #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:WidgetTree.TextBlock_155.Text #: /Game/Blueprints/Vendor/UMG_Vendor.UMG_Vendor_C:WidgetTree.TextBlock_155.Text msgid "Complete fishing compendium to shop here! "
msgstr "Selesaikan kompendium Memancing untuk berbelanja di sini! "  #. Key:	0BD0EEE7401AD93E76B1CEB17338FFCB #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Join together with the whole island to supply goods. Island supplies don't get streaks but payment is good from the start. You are rewarded based on your contribution."
msgstr "Bergabunglah bersama seluruh pulau untuk memasok barang. Pasokan pulau tidak akan beruntun tetapi pembayarannya bagus sejak awal. Anda diberi imbalan berdasarkan kontribusi Anda."  #. Key:	2C66F7954B502A4E8DC5ECA57DC0345D #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Vault"
msgstr "Brankas"  #. Key:	2D3E16024A0108A7F49EFAB47101150B #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Already upgraded"
msgstr "Sudah ditingkatkan"  #. Key:	3008BE9C41FCED1782477EB1C1099581 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Are you sure you want to continue? This will reset ALL compendium, houses and other progress on the server!"
msgstr "Apakah Anda yakin ingin melanjutkan? Ini akan mengatur ulang SEMUA kompendium, rumah, dan kemajuan lainnya di server!"  #. Key:	45E81E39431BEABD8C720EABFD341E5C #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "prestige already unlocked"
msgstr "prestise sudah terbuka"  #. Key:	6068F4294CCF0E96C50A40949F030E54 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Permament House Slots"
msgstr "Slot Rumah Permamen"  #. Key:	63AB603448821E4EB2DA3382BA52043E #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Tents cannot be upgraded"
msgstr "Tenda tidak dapat ditingkatkan"  #. Key:	6A9C3F5847039E87D4D9EABD72B5205B #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Unlock 10 more slots to your global vault"
msgstr "Buka 10 slot lagi untuk brankas global Anda"  #. Key:	7034772340B34A0D8230D59A490AC46E #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "IMPORTANT: No payment is given for partially filled shipments! If some items are fully filled, those will give 50% rewards."
msgstr "PENTING: Tidak ada pembayaran yang diberikan untuk pengiriman yang dilakukan sebagian! Jika beberapa item terisi penuh, maka akan mendapatkan imbalan 50%."  #. Key:	7F9A8AFA467144EA2C5DE68EBC63C878 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Decay Wood Extension"
msgstr "Ekstensi Kayu Pembusukan"  #. Key:	8E818FA24B946395074621A014C3FD5E #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Unlock more placeable houses"
msgstr "Buka lebih banyak rumah yang bisa ditempat"  #. Key:	98C264BA47EBC50AD95769A770E7AC10 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Unlock daily shipments and sell items at a much higher price than normal"
msgstr "Buka pengiriman harian dan jual barang dengan harga yang jauh lebih tinggi dari biasanya"  #. Key:	A7DB5DBF4857134372BF79BC224B32A0 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Fill all shipments before the timer runs out to sell items at higher profits. After each successful shipment, your payment will increase!"
msgstr "Selesaikan semua pengiriman sebelum waktunya habis untuk menjual barang dengan keuntungan yang lebih tinggi. Setelah setiap pengiriman berhasil, pembayaran Anda akan meningkat!"  #. Key:	B33BBDFD4E2B0660505887A89691AA69 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "More houses"
msgstr "Rumah lainnya"  #. Key:	DA346EAD46182D90EDA1D9B156D34505 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Resets your server progress and unlocks an additional house slot. If unlocked on an official server, it stays with you, even after server wipe."
msgstr "Mengatur ulang kemajuan server Anda dan membuka slot rumah tambahan. Jika dibuka pada server resmi, hal itu akan tetap dengan Anda, bahkan setelah penghapusan server."  #. Key:	EB36CFD248DD59DD02A62DBA3B889A8B #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Unlock global vault that can be accessed from all benefit stations"
msgstr "Buka brankas global yang dapat diakses dari semua stasiun manfaat"  #. Key:	FEFB1FCB4F957D6FE7DF8D8464F5CF7C #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:ExecuteUbergraph_UMG_Vendor_IslandBenefits [Script Bytecode] msgid "Double the decay wood storage so your house stays up longer"
