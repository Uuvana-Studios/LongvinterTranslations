msgstr "Jangkauan Turet:"  #. Key:	214E58694DE99A9CCDC05D9D765C3A10 #. SourceLocation:	/Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] #: /Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] msgid "When tent is upgraded to house, green area can only be used by owners of the house. Light green shows the minimum needed space to upgrade fully."
msgstr "Ketika tenda ditingkatkan menjadi rumah, area hijau hanya dapat digunakan oleh pemilik rumah. Warna hijau muda menunjukkan ruang minimum yang dibutuhkan untuk meningkatkan sepenuhnya."  #. Key:	28774A1B4CA909B66B34178EEBB88E53 #. SourceLocation:	/Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] #: /Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] msgid "Blocked area"
