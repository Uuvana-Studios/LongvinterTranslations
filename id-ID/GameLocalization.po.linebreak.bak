msgstr "ID disalin!"  #. Key:	31B0BD29460751954C5DCA9B68CB0679 #. SourceLocation:	/Game/Widgets/UMG_GameplayHint.UMG_GameplayHint_C:WidgetTree.Hint.Text #: /Game/Widgets/UMG_GameplayHint.UMG_GameplayHint_C:WidgetTree.Hint.Text msgid "Only you can enter a tent. You can share you home once you upgrade it to a wooden house and share the keycode with your friends"
msgstr "Hanya kamu yang dapat memasuki tenda. Kamu dapat berbagi rumahmu ketika kamu sudah meningkatkannya ke rumah kayu dan membagikan kodenya ke temanmu"  #. Key:	E0D1F0DB4C643F1319C77699D8976EAB #. SourceLocation:	/Game/Widgets/UMG_GestureWheel_Equip.UMG_GestureWheel_Equip_C:WidgetTree.T_EquipHint.Text #: /Game/Widgets/UMG_GestureWheel_Equip.UMG_GestureWheel_Equip_C:WidgetTree.T_EquipHint.Text msgid "Select slot for "
msgstr "Pilih slot untuk"  #. Key:	8D99674D4B1C24BD49511D880366DB8A #. SourceLocation:	/Game/Widgets/UMG_GiftModal.UMG_GiftModal_C:WidgetTree.T_Message.Text #: /Game/Widgets/UMG_GiftModal.UMG_GiftModal_C:WidgetTree.T_Message.Text msgid "You received: "
msgstr "Anda menerima: "  #. Key:	52F660C44846D9B4DC642FAB7544AFCE #. SourceLocation:	/Game/Widgets/UMG_GiftModal.UMG_GiftModal_C:WidgetTree.T_Title.Text #: /Game/Widgets/UMG_GiftModal.UMG_GiftModal_C:WidgetTree.T_Title.Text msgid "You opened a gift"
msgstr "Anda Membuka Hadiah"  #. Key:	C82564CA46FFDD9AFE92D78B2001916A #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.JoinServer.Text #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.JoinServer.Text msgid "Join server"
msgstr "Bergabung server"  #. Key:	9D96FE254A1047AF2E6DC7AFD834620A #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.T_Title.Text #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.T_Title.Text msgid "New Hardcore Server!"
msgstr "Server Hardcore Baru!"  #. Key:	3C94CBB648E92CAF2FD5C1B8A72B8084 #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.TextBlock.Text #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.TextBlock.Text msgid "Remember: This mode is designed for experienced players seeking an intense, high-stakes experience. Join only if you're prepared for a true test of your survival skills!\r\n\r\n"
msgstr "Ingat: mode ini didesain untuk pemain berpengalaman yang mencari pengalaman intens dan taruhan tinggi. Bergabunglah hanya jika Anda siap untuk menguji kemampuan bertahan hidup Anda yang sesungguhnya!\\\r \r\n"  #. Key:	F31CF44845DBF645554F9CABC37E7AFA #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.TextBlock_0.Text msgid "Please Read Before Joining!\r\n\r\nWe're excited to introduce our new \"Hardcore\" ruleset, now available on one of our official servers. You can easily join by clicking the button in the corner. Below is a list of all the changes compared to our regular PVP server:"
msgstr "Mohon Baca Sebelum Bergabung!"  #. Key:	D3D323434EB68CFF19B99C84C334D545 #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "You drop 5% of your currency on death"
msgstr "Anda menjatuhkan 5% mata uang Anda saat mati"  #. Key:	30CA2D5C4525B8E0BD853AA03B445DC1 #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "Weapons do 50% more damage"
msgstr "Senjata memberikan kerusakan 50% lebih besar"  #. Key:	D43922C646F086EC13EBCDB4E77A5184 #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Energy drain from walking is reduced by 80%"
msgstr "Penyerapan energi dari berjalan dikurangi 80%"  #. Key:	5C55F8DA4BBBCEA5BDE8A085AD5C9E25 #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "Loot spawns respawn 2x faster"
msgstr "Loot memunculkan respawn 2x lebih cepat"  #. Key:	A489FEE5417324FF4721EB8EA11A231D #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "No code locks on houses or tents"
msgstr "Tidak ada kunci kode pada rumah atau tenda"  #. Key:	8EF7DBD4460E1247D2F72EB56FD49674 #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "Turrets can be destroyed"
msgstr "Turet dapat dihancurkan"  #. Key:	46BD706A4BEFCD31DCE1398471C88234 #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "No safe zone building areas"
msgstr "Tidak ada area bangunan di zona aman"  #. Key:	3A69F94B452E3287DF3BC185279571D3 #. SourceLocation:	/Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay #: /Game/Widgets/UMG_HardcoreNotification.UMG_HardcoreNotification_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay msgid "Prices change more drastically when buying from or selling to vendors"
msgstr "Harga berubah lebih drastis ketika membeli dari atau menjual ke vendo"  #. Key:	F40FB7564F5B7B5212C05F8455A950A8 #. SourceLocation:	/Game/Widgets/UMG_HouseBubble.UMG_HouseBubble_C:ExecuteUbergraph_UMG_HouseBubble [Script Bytecode] #: /Game/Widgets/UMG_HouseBubble.UMG_HouseBubble_C:ExecuteUbergraph_UMG_HouseBubble [Script Bytecode] msgid "Home"
