msgstr "Buka Toko"  #. Key:	26CD827149F6CBFFE557F3A0C09474C8 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_SteamInventory.UMG_SteamInventory_C:WidgetTree.TextBlock_3.Text #: /Game/Blueprints/CharacterCreation/UMG_SteamInventory.UMG_SteamInventory_C:WidgetTree.TextBlock_3.Text msgid "All Items"
msgstr "Semua Item"  #. Key:	53E6DC4C48FC145DDFF7B4977D8A9447 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_SteamInventory.UMG_SteamInventory_C:WidgetTree.TextBlock_77.Text #. Key:	C3E3C4AE4E95EB181BBFD4A0B91228FD #. SourceLocation:	/Game/Blueprints/Vendor/UMG_GeneralStore.UMG_GeneralStore_C:WidgetTree.TextBlock.Text #: /Game/Blueprints/CharacterCreation/UMG_SteamInventory.UMG_SteamInventory_C:WidgetTree.TextBlock_77.Text #: /Game/Blueprints/Vendor/UMG_GeneralStore.UMG_GeneralStore_C:WidgetTree.TextBlock.Text msgid "Your Items"
msgstr "Item Kamu"  #. Key:	196DAD0540AAE6D468A571A778698BBA #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_Steamitem.UMG_SteamItem_C:ExecuteUbergraph_UMG_SteamItem [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_Steamitem.UMG_SteamItem_C:ExecuteUbergraph_UMG_SteamItem [Script Bytecode] msgid "Pet Name"
msgstr "Nama Peliharaan"  #. Key:	164B61AA4A4F174174942A8BAFA6BD5F #. SourceLocation:	/Game/Widgets/Inventory/UMG_CookingCategory.UMG_CookingCategory_C:WidgetTree.T_EnergyAmount.Text #. Key:	1BB1ACC3435D9FF38DEC40B449BF79EE #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_Steamitem.UMG_SteamItem_C:WidgetTree.T_quantity.Text #. Key:	284C6C41456BF2EF1E079EBFD9B8C103 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_GeneralStore_Item.UMG_GeneralStore_Item_C:WidgetTree.price.Text #. Key:	9B22305443B611AF0A1C029F491282F3 #. SourceLocation:	/Game/Widgets/CraftingBook/UMG_CraftingItem.UMG_CraftingItem_C:WidgetTree.T_energyAmountText.Text #: /Game/Blueprints/CharacterCreation/UMG_Steamitem.UMG_SteamItem_C:WidgetTree.T_quantity.Text #: /Game/Blueprints/Vendor/UMG_GeneralStore_Item.UMG_GeneralStore_Item_C:WidgetTree.price.Text #: /Game/Widgets/CraftingBook/UMG_CraftingItem.UMG_CraftingItem_C:WidgetTree.T_energyAmountText.Text #: /Game/Widgets/Inventory/UMG_CookingCategory.UMG_CookingCategory_C:WidgetTree.T_EnergyAmount.Text msgid "+10"
msgstr "+10"  #. Key:	D722A1FA498FCE1CCA18D8804EA0CF24 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_StyleSelection.UMG_StyleSelection_C:ExecuteUbergraph_UMG_StyleSelection [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_StyleSelection.UMG_StyleSelection_C:ExecuteUbergraph_UMG_StyleSelection [Script Bytecode] msgid "Pet Name: {name}"
msgstr "Nama Hewan: {name}"  #. Key:	43DF0C3A4EC48586B513E6849038E78E #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_Summer24CatalogDropTable.UMG_Summer24CatalogDropTable_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay #. Key:	B6445DED4B09C6EA7D25BBA4AD7C3A58 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_Summer24CatalogBoostedDropTable1.UMG_Summer24CatalogBoostedDropTable1_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_Summer24CatalogBoostedDropTable1.UMG_Summer24CatalogBoostedDropTable1_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_Summer24CatalogDropTable.UMG_Summer24CatalogDropTable_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay msgid "Radiant Fireflies"
msgstr "Kunang-kunang Berseri"  #. Key:	3EFE2F0A4C7671207C412991635E7300 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_Summer24CatalogBoostedDropTable1.UMG_Summer24CatalogBoostedDropTable1_C:WidgetTree.UMG_BulletPoint_17.TextToDisplay #. Key:	96E0074F486704CA66AB2EBF9D32A967 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_Summer24CatalogDropTable.UMG_Summer24CatalogDropTable_C:WidgetTree.UMG_BulletPoint_17.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_Summer24CatalogBoostedDropTable1.UMG_Summer24CatalogBoostedDropTable1_C:WidgetTree.UMG_BulletPoint_17.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_Summer24CatalogDropTable.UMG_Summer24CatalogDropTable_C:WidgetTree.UMG_BulletPoint_17.TextToDisplay msgid "Blazing Fire"
msgstr "Api berkobar"  #. Key:	05863033416B1F3D9A3E15A29C273FCE #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "You have the option to redeem your playtime coins later via the settings. However, please note that this option will only be available until February 2024."
msgstr "Kamu memiliki opsi untuk menukarkan koin waktu bermainmu melalui pengaturan. Namun, harap diperhatikan opsi ini berlaku sampai februari 2024."  #. Key:	316CF7824555688BE64693A1547EEB27 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "Redeem Later"
msgstr "Ambil Nanti"  #. Key:	5F9599B64373B3C19191C6A711453C1A #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "If you've spent a good amount of time playing Longvinter, you can now claim Vintercoins retroactively based on your playtime. Simply ensure your playtime settings are public, then click 'continue' to claim your reward."
msgstr "Jika Anda telah menghabiskan cukup banyak waktu untuk bermain Longvinter, kini Anda dapat mengklaim Vintercoin secara retroaktif berdasarkan waktu bermain Anda. Cukup pastikan pengaturan waktu bermain Anda bersifat publik, lalu klik 'lanjutkan' untuk mengklaim hadiah Anda."  #. Key:	6A33108442E7509FC5E1BCB6675B60B7 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "You can directly purchase items from the shop or opt to open Tackle Boxes with lures to discover unique items not available in the store. While Tackle Boxes are earned through gameplay, keys to unlock them are available for purchase. Remember, these boxes contain exclusive items you won't find in the regular shop."
msgstr "Anda dapat langsung membeli item dari toko atau memilih untuk membuka Box Pancing dengan umpan untuk menemukan item unik yang tidak tersedia di toko. Meskipun Box Pancing hanya diperoleh melalui permainan, kunci untuk membukanya dapat dibeli. Ingat, kotak-kotak ini berisi barang-barang eksklusif yang tidak akan Anda temukan di toko biasa."  #. Key:	6E006FB1425F75F0982F0E886E49B3A1 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "Earn Vintercoins Based on Your Playtime!"
msgstr "Dapatkan Vintercoin Berdasarkan Waktu Bermain Anda!"  #. Key:	759B7CDE47430B319232D48591906270 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "Earn 500 Vintercoins daily by playing actively for at least 30 minutes! Additionally, Vintercoins are available for purchase in the shop."
msgstr "Dapatkan 500 Vintercoin setiap hari dengan bermain secara aktif selama minimal 30 menit! Selain itu, Vintercoin juga dapat dibeli di toko."  #. Key:	8565AA4044FBA20E4C791F9B4C568BC4 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "You can use Vintercoins to buy items in the store. These coins will reside in your Steam inventory and are not marketable."
msgstr "Anda bisa menggunakan Vintercoins untuk membeli item di toko. Koin-koin ini akan disimpan dalam inventaris Steam Anda dan tidak dapat dipasarkan."  #. Key:	BED688A54DDBBE749104CF8352FC9483 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "How To Earn?"
msgstr "Bagaimana Cara Menghasilkan Uang?"  #. Key:	C473E74547526933E6632B88A014F9FA #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] msgid "Vintercoins"
msgstr "Koin Musim Dingin"  #. Key:	1E8B855748368AD19E5A0E9AE73DAE8E #. SourceLocation:	/Game/Blueprints/Vendor/A_Vendor_PlayerPlaced_Shop.Default__A_Vendor_PlayerPlaced_Shop_C.Vendor Name #. Key:	DBABEAC34496F89468A5F99B6211CD45 #. SourceLocation:	/Game/Widgets/Inventory/UMG_HouseUpgrade.UMG_HouseUpgrade_C:ExecuteUbergraph_UMG_HouseUpgrade [Script Bytecode] #. Key:	ED63758C4479B2AF072D10AD063EC0E4 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/Vendor/A_Vendor_PlayerPlaced_Shop.Default__A_Vendor_PlayerPlaced_Shop_C.Vendor Name #: /Game/Widgets/Inventory/UMG_HouseUpgrade.UMG_HouseUpgrade_C:ExecuteUbergraph_UMG_HouseUpgrade [Script Bytecode] msgid "Shop"
msgstr "Toko"  #. Key:	0A4F763044BBCBC7657BBEA18CC42325 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:ExecuteUbergraph_UMG_Feedbackform [Script Bytecode] #. Key:	AE4A939F4CC6F6D4CBB7449AFDB5B49A #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #. Key:	F4C29ECA47792879948CD2AAEE243E6F #. SourceLocation:	/Game/Widgets/MainMenu/UMG_QueueScreen.UMG_QueueScreen_C:ExecuteUbergraph_UMG_QueueScreen [Script Bytecode] #. Key:	F69701E94194800E34061DB69F8E2522 #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:ExecuteUbergraph_UMG_Feedbackform [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_QueueScreen.UMG_QueueScreen_C:ExecuteUbergraph_UMG_QueueScreen [Script Bytecode] #: /Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] msgid "Error"
msgstr "Galat (Error)"  #. Key:	2E9C23CF4EE991A4CAFD1AA5E2861165 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #. Key:	4645DD63447646C830136386374654E5 #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] msgid "An unexpected error occurred. Please try again later!"
msgstr "Terjadi kesalahan secara tiba-tiba. Silakan coba lagi nanti!"  #. Key:	38FC8075461E177636586B9B12DBE8F9 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #. Key:	AB86DDBE49AC2F8122EEBFB0058B2889 #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] msgid "Success!"
msgstr "Berhasil Gan!"  #. Key:	3E603AC943BD422B51C571A53B94A15F #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #. Key:	4F75CA884EA2B4B70C4A77A4064AD20A #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] msgid "Cant access your games"
msgstr "Tidak dapat mengakses permainan Anda"  #. Key:	4AEEA2774B3BCD53C90D889F418EF2AE #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] #. Key:	671D263B4EAFBF3652FC19803AFFC13B #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #. Key:	99B1185B47FB0E67D58245A4230074A1 #. Key:	BA1811B6404885C6293427B93623DD17 #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] msgid "Try again"
msgstr "Coba lagi"  #. Key:	4FAC738B45FC11A56BE5C3922ACD1E78 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #. Key:	9AE66C8E47A091CB48212CB952A4EE08 #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] msgid "Navigate to: Steam Profile > Edit Profile > My Privacy Settings > Game Details, then set it to 'Public'. After making this change, try again."
msgstr "Navigasi ke: Profil Steam > Edit Profil > Pengaturan Privasi Saya > Detail Game, lalu atur ke 'Publik'. Setelah melakukan perubahan ini, coba lagi."  #. Key:	6B22639F48C9100C5C8C35A1248D3FE8 #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] #. Key:	882F7E984EFBD27BC72805AB12CDC184 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Blueprints/CharacterCreation/UMG_VintercoinRedeemScreen.UMG_VintercoinRedeemScreen_C:ExecuteUbergraph_UMG_VintercoinRedeemScreen [Script Bytecode] #: /Game/Widgets/SettingsMenu/Pages/GeneralSettingsPage.GeneralSettingsPage_C:ExecuteUbergraph_GeneralSettingsPage [Script Bytecode] msgid "Vintercoins have been credited to your account."
msgstr "Vintercoin telah dikreditkan ke akun Anda."  #. Key:	132FC6E74D014819D5DE27A46FBFAB40 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_WinterCatalogBoostedDropTable.UMG_WinterCatalogBoostedDropTable_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_WinterCatalogBoostedDropTable.UMG_WinterCatalogBoostedDropTable_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "10% change of getting ONE of these items WITH effect"
msgstr "10% kesempatan untuk mendapatkan SATU dari beberapa item DENGAN efek"  #. Key:	859E8B6E4567C98D8DF6F69D83452007 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_WinterCatalogBoostedDropTable.UMG_WinterCatalogBoostedDropTable_C:WidgetTree.UMG_BulletPoint_12.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_WinterCatalogBoostedDropTable.UMG_WinterCatalogBoostedDropTable_C:WidgetTree.UMG_BulletPoint_12.TextToDisplay msgid "90% change of getting ONE of these items"
msgstr "90% kesempatan untuk mendapatkan SATU dari beberapa item"  #. Key:	7A05588948552AB2BE9BD7898733D19D #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_WinterCatalogDropTable.UMG_WinterCatalogDropTable_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay #. Key:	D57460064F6C721A22AD16B51FFAE95C #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_WinterCatalogBoostedDropTable.UMG_WinterCatalogBoostedDropTable_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_WinterCatalogBoostedDropTable.UMG_WinterCatalogBoostedDropTable_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_WinterCatalogDropTable.UMG_WinterCatalogDropTable_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay msgid "Flying Candy"
msgstr "Permen Terbang"  #. Key:	35D4A5AE44918B90A7AD0A933FD9FAEC #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_WinterCatalogDropTable.UMG_WinterCatalogDropTable_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_WinterCatalogDropTable.UMG_WinterCatalogDropTable_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "2% change of getting ONE of these items WITH effect"
msgstr "2% kesempatan untuk mendapatkan SATU dari beberapa item DENGAN efek"  #. Key:	A26A2A58411BFC46A665AB9DDB7F3704 #. SourceLocation:	/Game/Blueprints/CharacterCreation/UMG_WinterCatalogDropTable.UMG_WinterCatalogDropTable_C:WidgetTree.UMG_BulletPoint_12.TextToDisplay #: /Game/Blueprints/CharacterCreation/UMG_WinterCatalogDropTable.UMG_WinterCatalogDropTable_C:WidgetTree.UMG_BulletPoint_12.TextToDisplay msgid "8% change of getting ONE of these items"
msgstr "8% kesempatan untuk mendapatkan SATU dari beberapa item"  #. Key:	F5E39AC2494E24FA04E6B49B863CF893 #. SourceLocation:	/Game/Blueprints/CraftingStatus.CraftingStatus.DisplayNameMap(0 - Value).DisplayNameMap #: /Game/Blueprints/CraftingStatus.CraftingStatus.DisplayNameMap(0 - Value).DisplayNameMap msgid "No Crafting"
msgstr "Tidak Dapat Diubah"  #. Key:	8283F860427A39F585072AAB28520B71 #. SourceLocation:	/Game/Blueprints/CraftingStatus.CraftingStatus.DisplayNameMap(1 - Value).DisplayNameMap #: /Game/Blueprints/CraftingStatus.CraftingStatus.DisplayNameMap(1 - Value).DisplayNameMap msgid "Crafting Bench"
msgstr "Pabrik Kerajinan"  #. Key:	71369F354388EF84BF8F20BAA7AC60E8 #. SourceLocation:	/Game/Blueprints/CraftingStatus.CraftingStatus.DisplayNameMap(2 - Value).DisplayNameMap #: /Game/Blueprints/CraftingStatus.CraftingStatus.DisplayNameMap(2 - Value).DisplayNameMap msgid "Inventory Crafting"
