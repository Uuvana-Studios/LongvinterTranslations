msgstr "Sambungankan ke Alamat"  #. Key:	664F615A4B50FBE23E45D989DA710C12 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_Password.UMG_Password_C:WidgetTree.T_WindowName_1.Text #. Key:	91ABA93649255F227DA6768DEB4FED2A #. SourceLocation:	/Game/Widgets/MainMenu/UMG_ConnectToAddress.UMG_ConnectToAddress_C:WidgetTree.T_WindowName_1.Text #: /Game/Widgets/MainMenu/UMG_ConnectToAddress.UMG_ConnectToAddress_C:WidgetTree.T_WindowName_1.Text #: /Game/Widgets/MainMenu/UMG_Password.UMG_Password_C:WidgetTree.T_WindowName_1.Text msgid "Connect"
