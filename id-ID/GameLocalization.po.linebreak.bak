msgid "crafting"
msgstr "membuat"  #. Key:	WorkbenchUse_Keywords_Index3 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Keywords_3_4813D612475BFE69FB46CBB6EF7E240C(3).Keywords_3_4813D612475BFE69FB46CBB6EF7E240C #: /Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Keywords_3_4813D612475BFE69FB46CBB6EF7E240C(3).Keywords_3_4813D612475BFE69FB46CBB6EF7E240C msgctxt "DT_ChatResponses"
msgid "make"
msgstr "membuat"  #. Key:	WorkbenchUse_Responses_Index0 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(0).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E #: /Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(0).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E msgctxt "DT_ChatResponses"
msgid "Workbench unlocks everything!"
msgstr "Meja kerja membuka semua!"  #. Key:	WorkbenchUse_Responses_Index1 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(1).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E #: /Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(1).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E msgctxt "DT_ChatResponses"
msgid "100 logs for cabin upgrade."
msgstr "100 kayu untuk peningkatan kabin."  #. Key:	WorkbenchUse_Responses_Index2 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(2).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E #: /Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(2).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E msgctxt "DT_ChatResponses"
msgid "Check crafting book for recipes."
msgstr "Periksa buku kerajinan untuk resep."  #. Key:	WorkbenchUse_Responses_Index3 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(3).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E #: /Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(3).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E msgctxt "DT_ChatResponses"
msgid "Watch that decay timer!"
msgstr "Awas timer penurunan!"  #. Key:	5B3697384820259355703F88EF553287 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeAreNeighbors.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeAreNeighbors.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgid "Awesome, we are neighbors"
msgstr "Bagus, kita adalah tetangga"  #. Key:	SgtLakeArrived_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeArrived.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeArrived.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "We have arrived!"
msgstr "Kita telah tiba!"  #. Key:	SgtLakeBerries_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeBerries.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeBerries.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Oh, look! There are berries!"
msgstr "Wah, lihat! Ada buah berry!"  #. Key:	SgtLakeCampfireWarmth_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeCampfireWarmth.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeCampfireWarmth.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Here, warm up in this campfire."
msgstr "Di sini, hangatkan diri di api unggun ini."  #. Key:	SgtLakeChestWonder_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeChestWonder.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeChestWonder.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "I wonder how that chest ended up there..."
msgstr "Aku bertanya-tanya bagaimana peti itu bisa sampai di sana..."  #. Key:	SgtLakeFishingSoup_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeFishingSoup.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeFishingSoup.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Lots of fish here. Try cooking a soup!"
msgstr "Banyak ikan di sini. Cobalah memasak sup!"  #. Key:	SgtLakeFishingTip_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeFishingTip.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeFishingTip.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "A fishing rod helps; you can fish and cook to regain energy."
msgstr "Alat pancing membantu; Anda bisa memancing dan memasak untuk memulihkan energi."  #. Key:	4CFD2B8541CD052C7A9DD98E7A84C7AE #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeFishingTip2.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeFishingTip2.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgid "You can fish and cook to regain energy."
msgstr "Anda dapat memancing dan memasak untuk memulihkan energi."  #. Key:	SgtLakeHeadToOutpost_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeHeadToOutpost.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeHeadToOutpost.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Okay, let's start to head out to my outpost."
msgstr "Oke, mari kita mulai berangkat ke pos saya."  #. Key:	SgtLakeJuliaSells_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeJuliaSells.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeJuliaSells.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "She sells all sorts of stuff!"
msgstr "Dia menjual semua jenis barang!"  #. Key:	SgtLakeJuliaShop_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeJuliaShop.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeJuliaShop.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Oh, there's Julia's shop."
msgstr "Oh, itu toko Julia."  #. Key:	SgtLakeLowEnergy_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeLowEnergy.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeLowEnergy.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Take care, your energy is low."
msgstr "Hati-hati, energi Anda rendah."  #. Key:	SgtLakeMushrooms_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeMushrooms.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeMushrooms.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Mushrooms!"
msgstr "Jamur!"  #. Key:	SgtLakeMyHome_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeMyHome.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeMyHome.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "This is my home!"
msgstr "Ini rumahku!"  #. Key:	SgtLakeNeighbors_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeNeighbors.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeNeighbors.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "We're going to be neighbors."
msgstr "Kita akan menjadi tetangga."  #. Key:	SgtLakeNorthPrep_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeNorthPrep.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeNorthPrep.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Make sure you have ammo and a weapon"
msgstr "Pastikan Anda memiliki amunisi dan senjata"  #. Key:	EAAD5B0A487F7F5D61CAD692B0FE66F6 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeNorthPrep2.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeNorthPrep2.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Before heading out to the North."
msgstr "Sebelum berangkat ke Utara."  #. Key:	SgtLakeRedChest_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeRedChest.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeRedChest.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "I believe there's a red chest behind that cliff."
msgstr "Aku yakin ada peti merah di balik tebing itu."  #. Key:	SgtLakeSnowWarning_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeSnowWarning.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeSnowWarning.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Snow depletes your energy faster."
msgstr "Salju mempercepat penurunan energimu."  #. Key:	SgtLakeStrangeOres_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeStrangeOres.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeStrangeOres.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "I have never seen these ores."
msgstr "Aku belum pernah melihat bijih-bijih ini."  #. Key:	SgtLakeTargetPractice_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeTargetPractice.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeTargetPractice.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "A little target practice never hurts."
msgstr "Sedikit latihan menembak tidak pernah menyakitkan."  #. Key:	SgtLakeWhereGoing_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeWhereGoing.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeWhereGoing.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "Where are you going?!"
msgstr "Kamu mau ke mana?!"  #. Key:	SgtLakeWoodCabin_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeWoodCabin.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeWoodCabin.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "I got wood for my cabin from this forest."
msgstr "Saya mendapatkan kayu untuk pondok saya dari hutan ini."  #. Key:	SgtLakeWoodMatches_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeWoodMatches.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeWoodMatches.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "You should always have wood and matches with you."
msgstr "Anda harus selalu membawa kayu dan korek api."  #. Key:	SgtLakeWrongDirection_DialogueText #. SourceLocation:	/Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeWrongDirection.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A #: /Game/Blueprints/NewQuests/DT_Dialogue.DT_Dialogue.SgtLakeWrongDirection.DialogueText_3_A9C5DFDC46C401473F93E1A1C4D4CD4A msgctxt "DT_Dialogue"
msgid "I don't think the base camp is in this direction..."
msgstr "Aku rasa markas utama tidak berada di arah ini..."  #. Key:	025E80F642C22EB08AD5B5B32B27E0CD #. SourceLocation:	/Game/Blueprints/NewQuests/QuestManagerComponent.QuestManagerComponent_C:CompleteQuest [Script Bytecode] #. Key:	38D12304411ADD98110D4C97CB8B1772 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/QuestComponent.QuestComponent_C:CheckIfQuestIsCompleted [Script Bytecode] #: /Game/Blueprints/NewQuests/QuestManagerComponent.QuestManagerComponent_C:CompleteQuest [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/QuestComponent.QuestComponent_C:CheckIfQuestIsCompleted [Script Bytecode] msgid "You received"
msgstr "Anda menerima"  #. Key:	125390CE4FA0AA109425CB92758344B1 #. SourceLocation:	/Game/Blueprints/NewQuests/QuestManagerComponent.QuestManagerComponent_C:CompleteQuest [Script Bytecode] #. Key:	4483D4D2460C4FCED0103888F06170AA #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/QuestComponent.QuestComponent_C:CheckIfQuestIsCompleted [Script Bytecode] #: /Game/Blueprints/NewQuests/QuestManagerComponent.QuestManagerComponent_C:CompleteQuest [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/QuestComponent.QuestComponent_C:CheckIfQuestIsCompleted [Script Bytecode] msgid "No room in inventory"
msgstr "Tidak ada ruang di inventaris"  #. Key:	244342A44C1EEE98AF7EB6B262EA7A81 #. SourceLocation:	/Game/Blueprints/NewQuests/QuestManagerComponent.QuestManagerComponent_C:CompleteQuest [Script Bytecode] #. Key:	4991836347E5F8285857AFA47B7D028C #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/QuestComponent.QuestComponent_C:CheckIfQuestIsCompleted [Script Bytecode] #: /Game/Blueprints/NewQuests/QuestManagerComponent.QuestManagerComponent_C:CompleteQuest [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/QuestComponent.QuestComponent_C:CheckIfQuestIsCompleted [Script Bytecode] msgid "items dropped to ground"
msgstr "barang dijatuhkan ke tanah"  #. Key:	59606B8847995B3955DFDEB5F1FE2E45 #. SourceLocation:	/Game/Blueprints/NewQuests/QuestManagerComponent.QuestManagerComponent_C:CompleteQuest [Script Bytecode] #. Key:	908ACA074CCFBBA44C35588B59727E99 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/QuestComponent.QuestComponent_C:CheckIfQuestIsCompleted [Script Bytecode] #: /Game/Blueprints/NewQuests/QuestManagerComponent.QuestManagerComponent_C:CompleteQuest [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/QuestComponent.QuestComponent_C:CheckIfQuestIsCompleted [Script Bytecode] msgid "for reward"
