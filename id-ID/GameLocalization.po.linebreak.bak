msgstr "Terlalu dekat dengan bangunan lain lain"  #. Key:	A7333393424D10961C2295BD3EB50F61 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Item has to face outside your building area"
