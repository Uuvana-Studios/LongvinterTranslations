msgid "Open Inventory"
msgstr "Buka Inventaris"  #. Key:	B36AFC7147630EE6D159AAB31B0EFA71 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PickUpWoodFromChest.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PickUpWoodFromChest.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgid "Find a container with wood to gather building materials"
msgstr "Temukan wadah dengan kayu untuk mengumpulkan bahan bangunan"  #. Key:	0A2699FA4D551637380F8D9AC476422B #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PickUpWoodFromChest.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PickUpWoodFromChest.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgid "Find Wood Container"
msgstr "Temukan Wadah Kayu"  #. Key:	PlaceTent_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceTent.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceTent.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Place your Tent next to Sgt. Lake's Home to establish your base"
msgstr "Pasang Tendamu di samping Rumah Sgt. Lake untuk membangun pangkalan"  #. Key:	PlaceTent_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceTent.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceTent.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Place Your Tent"
msgstr "Letakkan Tendamu"  #. Key:	PlaceWeatherStation_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceWeatherStation.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceWeatherStation.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Place the Weather Station at your Home to begin collecting data"
msgstr "Letakkan Stasiun Cuaca di Rumah Anda untuk mulai mengumpulkan data"  #. Key:	PlaceWeatherStation_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceWeatherStation.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceWeatherStation.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Place Weather Station"
msgstr "Tempatkan Stasiun Cuaca"  #. Key:	PlaceWorkbench_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceWorkbench.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceWorkbench.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Place the Workbench inside your Tent to create your personal workshop"
msgstr "Tempatkan Bangku Kerja di dalam Tenda untuk menciptakan bengkel pribadi Anda"  #. Key:	PlaceWorkbench_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceWorkbench.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PlaceWorkbench.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Place Workbench"
msgstr "Letakkan Meja Kerja"  #. Key:	PurchaseAmmo_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseAmmo.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseAmmo.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "A weapon is useless without ammunition. Stock up before you head out"
msgstr "Senjata tak berguna tanpa amunisi. Siapkan persediaan sebelum berangkat"  #. Key:	PurchaseAmmo_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseAmmo.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseAmmo.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Purchase Ammunition"
msgstr "Beli Amunisi"  #. Key:	PurchaseLongvinterTicket_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseLongvinterTicket.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseLongvinterTicket.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Purchase a ticket to Longvinter Island to continue your adventure"
msgstr "Beli tiket ke Pulau Longvinter untuk melanjutkan petualanganmu"  #. Key:	PurchaseLongvinterTicket_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseLongvinterTicket.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseLongvinterTicket.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Purchase Ticket to Longvinter Island"
msgstr "Beli Tiket ke Pulau Longvinter"  #. Key:	PurchaseSolarPanels_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseSolarPanels.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseSolarPanels.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Purchase Solar Panels to generate sustainable power for your cabin"
msgstr "Beli Panel Surya untuk menghasilkan energi berkelanjutan untuk kabin Anda"  #. Key:	PurchaseSolarPanels_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseSolarPanels.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseSolarPanels.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Purchase Solar Panels"
msgstr "Beli Panel Surya"  #. Key:	PurchaseTent_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseTent.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseTent.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Use your earnings to purchase a Tent from a Vendor"
msgstr "Gunakan penghasilan Anda untuk membeli Tenda dari Vendor"  #. Key:	PurchaseTent_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseTent.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseTent.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Purchase a Tent"
msgstr "Beli Tenda"  #. Key:	PurchaseWeapon_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseWeapon.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseWeapon.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "To hunt effectively, you'll need a weapon. Purchase one from a Vendor"
msgstr "Untuk berburu dengan efektif, Anda membutuhkan senjata. Beli satu dari Vendor"  #. Key:	PurchaseWeapon_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseWeapon.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseWeapon.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Purchase a Weapon"
msgstr "Beli Senjata"  #. Key:	PurchaseWorkbench_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseWorkbench.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseWorkbench.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "A Workbench is essential for advanced crafting. Purchase one from a Vendor"
msgstr "Meja kerja sangat penting untuk kerajinan tingkat lanjut. Belilah dari Vendor"  #. Key:	PurchaseWorkbench_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseWorkbench.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.PurchaseWorkbench.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Purchase Workbench"
msgstr "Beli Bangku Kerja"  #. Key:	RecoverMkFromWeatherStation_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.RecoverMkFromWeatherStation.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.RecoverMkFromWeatherStation.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "The Weather Station contains valuable Mk components. Recover them for your expedition"
msgstr "Stasiun Cuaca berisi komponen Mk berharga. Ambil untuk ekspedisi Anda"  #. Key:	RecoverMkFromWeatherStation_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.RecoverMkFromWeatherStation.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.RecoverMkFromWeatherStation.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Recover Mk Component"
msgstr "Pulihkan Komponen Mk"  #. Key:	SellFeathers5_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.SellFeathers5.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.SellFeathers5.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "The feathers from your hunt can be sold for a profit. Sell 3 of them"
msgstr "Bulu dari hasil buruan Anda dapat dijual untuk mendapatkan keuntungan. Jual 3 bulu tersebut"  #. Key:	SellFeathers5_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.SellFeathers5.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.SellFeathers5.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Sell Feathers"
msgstr "Jual Bulu"  #. Key:	SellItems10_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.SellItems10.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.SellItems10.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Sell 10 items to any Vendor to earn some currency"
msgstr "Jual 10 barang ke Vendor mana saja untuk mendapatkan mata uang"  #. Key:	SellItems10_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.SellItems10.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.SellItems10.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Sell Items"
msgstr "Jual Item"  #. Key:	5026D81744C54ADD071731880C5AD139 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.StockUpAmmo.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.StockUpAmmo.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Stock Up on Ammo"
msgstr "Isi Ulang Amunisi"  #. Key:	StockUpSupplies_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.StockUpFood.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.StockUpFood.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Stock up on Ammo and Food for your journey to the North Outpost"
msgstr "Persediakan Ammo dan Makanan untuk perjalanan Anda ke Pos Terdepan Utara"  #. Key:	StockUpSupplies_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.StockUpFood.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.StockUpFood.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Stock Up on Food"
msgstr "Persediaan Makanan"  #. Key:	UpgradeElectricityTransmitter_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.UpgradeElectricityTransmitter.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.UpgradeElectricityTransmitter.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Upgrade the Electricity Transmitter in your cabin to handle more power"
msgstr "Tingkatkan Pemancar Listrik di kabin Anda untuk menangani lebih banyak daya"  #. Key:	UpgradeElectricityTransmitter_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.UpgradeElectricityTransmitter.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.UpgradeElectricityTransmitter.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
msgid "Upgrade Electricity Transmitter"
msgstr "Tingkatkan Transmiter Listrik"  #. Key:	UpgradeTentToHouse_Description #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.UpgradeTentToHouse.Description_12_D8207A4B495263BEED9C6A9F794B18FF #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.UpgradeTentToHouse.Description_12_D8207A4B495263BEED9C6A9F794B18FF msgctxt "DT_AllTasks"
msgid "Use the Workbench and the Wood you've gathered to upgrade your Tent into a sturdy Cabin"
msgstr "Gunakan Meja Kerja dan Kayu yang kamu kumpulkan untuk meningkatkan Tenda menjadi Pondok yang kokoh"  #. Key:	UpgradeTentToHouse_TranslatedName #. SourceLocation:	/Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.UpgradeTentToHouse.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 #: /Game/Blueprints/NewQuests/DT_AllTasks.DT_AllTasks.UpgradeTentToHouse.TranslatedName_29_C60BF5914C9CF76161B4D29D35405374 msgctxt "DT_AllTasks"
