msgstr "Menghasilkan banyak listrik gratis dengan menggunakan air. Terbuka untuk semua orang."  #. Key:	A3721AFB47B6A0CFB875CFA492F4C208 #. SourceLocation:	/Game/Widgets/Inventory/UMG_HouseUpgrade.UMG_HouseUpgrade_C:ExecuteUbergraph_UMG_HouseUpgrade [Script Bytecode] #: /Game/Widgets/Inventory/UMG_HouseUpgrade.UMG_HouseUpgrade_C:ExecuteUbergraph_UMG_HouseUpgrade [Script Bytecode] msgid "Set turrets to active!"
