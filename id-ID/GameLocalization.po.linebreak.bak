msgstr "Rentetan "  #. Key:	0296DDA54E72832D5E5FAF9B66ADA257 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_VendorEditor.UMG_VendorEditor_C:WidgetTree.EditableText_423.Text #. Key:	307C974A4B25C61C72BCF5A9B88645C1 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:WidgetTree.T_TitleStreak_1.Text #. Key:	630209EB472EAD4D0A35E89AE03B9EC5 #. SourceLocation:	/Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:WidgetTree.TextBlock_5.Text #. Key:	85DA138F4D91CE821B5B959FECFC8E07 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboardTeamContent.UMG_GlobalLeaderboardTeamContent_C:WidgetTree.T_Placement.Text #. Key:	D8A6A19A47DDAADB848D9FB553074BC1 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:ExecuteUbergraph_UMG_DiceGame_LiarsDice_Hand [Script Bytecode] #. Key:	E6F18AC94D9A2767B398F99CEA69573D #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_LeaderboardTeamContent.UMG_LeaderboardTeamContent_C:WidgetTree.T_Placement.Text #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:WidgetTree.T_TitleStreak_1.Text #: /Game/Blueprints/Vendor/UMG_VendorEditor.UMG_VendorEditor_C:WidgetTree.EditableText_423.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:ExecuteUbergraph_UMG_DiceGame_LiarsDice_Hand [Script Bytecode] #: /Game/Widgets/Inventory/UMG_Inventory.UMG_Inventory_C:WidgetTree.TextBlock_5.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboardTeamContent.UMG_GlobalLeaderboardTeamContent_C:WidgetTree.T_Placement.Text #: /Game/Widgets/Leaderboard/UMG_LeaderboardTeamContent.UMG_LeaderboardTeamContent_C:WidgetTree.T_Placement.Text msgid "1"
msgstr "1"  #. Key:	6811D39F451E310FE17E4CA6D68A8B17 #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:WidgetTree.TextBDescription.Text #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:WidgetTree.TextBDescription.Text msgid "Fill all shipments before the timer runs out to sell items at higher profits. After each successful shipment, your payment will increase!\r\n\r\n\r\nIMPORTANT: No payment is given for partially filled shipments! If some items are fully filled, those will give 50% rewards."
msgstr "Selesaikan semua pengiriman sebelum batas waktu habis untuk menjual barang dengan keuntungan yang lebih tinggi. Setelah setiap pengiriman yang berhasil, pembayaran Anda akan meningkat!\r\n\r\n\r\nPENTING: Tidak ada pembayaran yang diberikan untuk pengiriman yang terisi sebagian! Jika beberapa item terisi penuh, maka akan mendapatkan imbalan 50%."  #. Key:	2B92618245E5DFE71BEE8CB78C76DD6D #. SourceLocation:	/Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:WidgetTree.TextBlock_2.Text #: /Game/Blueprints/Vendor/UMG_Vendor_IslandBenefits.UMG_Vendor_IslandBenefits_C:WidgetTree.TextBlock_2.Text msgid "Your Vault"
