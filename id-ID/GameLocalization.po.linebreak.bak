msgstr "Kamu hanya bisa meletakkan 1 Rumah Kaca dekat rumahmu"  #. Key:	47C7D20B4D8B85A9DF840C9BD4DC2A85 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Too close to other base"
msgstr "Terlalu dekat dengan Base lain"  #. Key:	4E1059A54932E764F7C500ADB5C9601A #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "This item can only be placed outside!"
msgstr "Barang ini hanya bisa ditaruh di luar!"  #. Key:	5041DEB84E995BF8B14B87BD41BA8F60 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "Cannot place in water!"
msgstr "Tidak bisa ditaruh di air!"  #. Key:	5A695F8143738DC350E413B466B4BE66 #. SourceLocation:	/Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] #: /Game/ThirdPersonCPP/Blueprints/ItemPlacingComponent.ItemPlacingComponent_C:getOverlapResult [Script Bytecode] msgid "You already have max homes in this area"
