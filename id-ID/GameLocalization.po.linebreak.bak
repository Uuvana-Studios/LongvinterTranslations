msgstr "Zona-zona penempatan:"  #. Key:	31A60D0242334B1878E909B752B91936 #. SourceLocation:	/Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] #: /Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] msgid "Reserved build area"
msgstr "Area pembangunan dipesan"  #. Key:	3AAF65EA469416D8D3E7A58D5B0A095A #. SourceLocation:	/Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] #: /Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] msgid "Leave easy access to players to shop in your store"
msgstr "Berikan akses yang mudah bagi para pemain untuk berbelanja di toko Anda"  #. Key:	465E9F1343D0F83D5FC09C9C3C6BB76F #. SourceLocation:	/Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] #: /Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] msgid "Sandbags are allowed to be placed near the Point Of Interests areas. But not close to vendors and hubs"
msgstr "Karung pasir diperbolehkan untuk ditempatkan di dekat area tertentu. Tetapi tidak dekat dengan vendor dan hub-hub"  #. Key:	7104432D410BAE9E0EEE3B9F0A039936 #. SourceLocation:	/Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] #: /Game/Widgets/PlacingHints/UMG_PlacingHints.UMG_PlacingHints_C:ExecuteUbergraph_UMG_PlacingHints [Script Bytecode] msgid "Allowed area"
