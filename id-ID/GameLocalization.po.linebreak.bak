#: /Game/AI/AI_Character.AI_Character_C:AI_Vendor_GEN_VARIABLE.Vendor_GEN_VARIABLE_A_Vendor_NoHitbox_C_CAT.Vendor Name
msgid "Wandering Trader"
msgstr "Pedagang Keliling"  #. Key:	92A43D5D405436E780D2BEA919D76CDA #. SourceLocation:	/Game/AI/AI_Character.AI_Character_C:AI_Vendor_GEN_VARIABLE.Vendor_GEN_VARIABLE_A_Vendor_NoHitbox_C_CAT.VendorDescription #: /Game/AI/AI_Character.AI_Character_C:AI_Vendor_GEN_VARIABLE.Vendor_GEN_VARIABLE_A_Vendor_NoHitbox_C_CAT.VendorDescription msgid "Oh, howdy, fellow researcher! Have you seen anything worthwhile while exploring? Take a look at what I have found and pick anything that piques your interest. The price is always right for you!"
msgstr "Apa kabar, sesama peneliti! Sudahkah Anda melihat sesuatu yang berharga saat menjelajah? Lihatlah apa yang saya temukan dan pilih apa saja yang menarik minat Anda. Harganya selalu tepat untuk Anda!"  #. Key:	DECD344C49FF65864DC4EE8AB9061238 #. SourceLocation:	/Game/AI/AI_Character.AI_Character_C:ExecuteUbergraph_AI_Character [Script Bytecode] #: /Game/AI/AI_Character.AI_Character_C:ExecuteUbergraph_AI_Character [Script Bytecode] msgid "+{Amount}"
msgstr "+{Jumlah}"  #. Key:	F7D280A34462A8A81A2207A367514802 #. SourceLocation:	/Game/AI/BehaviourTrees/Decorators/Enum_FloatCompare.Enum_FloatCompare.DisplayNameMap(0 - Value).DisplayNameMap #: /Game/AI/BehaviourTrees/Decorators/Enum_FloatCompare.Enum_FloatCompare.DisplayNameMap(0 - Value).DisplayNameMap msgid "<"
