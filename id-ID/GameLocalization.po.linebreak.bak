msgstr "Email:"  #. Key:	02FB3885403DC5924F232881929F6FA9 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.T_Title.Text #: /Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.T_Title.Text msgid "Feedback"
msgstr "Masukan"  #. Key:	A9F9E83D4A4AAC5654A968B67B2FD333 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_2.Text #: /Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_2.Text msgid "Open topic"
msgstr "Membuka topik"  #. Key:	379EEAA44B7FF83E6A1F9D889025C0CA #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_3.Text #: /Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_3.Text msgid "Idea"
msgstr "Ide"  #. Key:	9C191FC44BD90E68039FCA884ADB8AF0 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_4.Text #: /Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_4.Text msgid "Bug"
msgstr "Bug"  #. Key:	3ECD101D4859115B5C184A90ADC27F67 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_5.Text #. Key:	5946DD2E4E14A6F2D6992A87618B79D9 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_ReportPlayerList.UMG_ReportPlayerList_C:WidgetTree.T_Title.Text #. Key:	C26A53134B628F7D87806E9C54F1E450 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_PlayerReport.UMG_PlayerReport_C:WidgetTree.T_Title.Text #: /Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_5.Text #: /Game/Widgets/MainMenu/UMG_PlayerReport.UMG_PlayerReport_C:WidgetTree.T_Title.Text #: /Game/Widgets/MainMenu/UMG_ReportPlayerList.UMG_ReportPlayerList_C:WidgetTree.T_Title.Text msgid "Report player"
msgstr "Laporkan pemain"  #. Key:	AD363C7A4D422E6E14321FB73C97D6C9 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_6.Text #: /Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.TextBlock_6.Text msgid "Open github"
msgstr "Buka github"  #. Key:	75EEFB2849C52ABC811488A4AB40EF7B #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:ExecuteUbergraph_UMG_FriendTile [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:ExecuteUbergraph_UMG_FriendTile [Script Bytecode] msgid "Reason: "
msgstr "Alasan: "  #. Key:	D209F7794429EC0287C537B2CDA877E2 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:ExecuteUbergraph_UMG_FriendTile [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:ExecuteUbergraph_UMG_FriendTile [Script Bytecode] msgid "If this continues, try restarting the game. "
msgstr "Jika ini terus berlanjut, coba mulai ulang permainan."  #. Key:	2828C93743354D0FED226199D4D642BC #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:WidgetTree.joinText.Text #: /Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:WidgetTree.joinText.Text msgid "Join Game"
msgstr "Bergabung dengan Game"  #. Key:	1AFF6E7C4789C2A64BC0ACAEB5632BFD #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:WidgetTree.TextBlock.Text #: /Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:WidgetTree.TextBlock.Text msgid "Loading..."
msgstr "Memuat..."  #. Key:	837007F84DBC0F1507997796A3BAD1BE #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:WidgetTree.TextBlock_1.Text #: /Game/Widgets/MainMenu/UMG_FriendTile.UMG_FriendTile_C:WidgetTree.TextBlock_1.Text msgid "In main menu"
msgstr "Di menu utama"  #. Key:	9EDE7209467494C926179DA79B3738AC #. SourceLocation:	/Game/Widgets/MainMenu/UMG_HelpWindow.UMG_HelpWindow_C:WidgetTree.T_WindowDesc.Text #: /Game/Widgets/MainMenu/UMG_HelpWindow.UMG_HelpWindow_C:WidgetTree.T_WindowDesc.Text msgid "Beta 1.0"
msgstr "Beta 1.0"  #. Key:	245F9A654060375C8A5576B49C0F5C97 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_HelpWindow.UMG_HelpWindow_C:WidgetTree.T_WindowName.Text #. Key:	AB776A7C43694B1A461367B1EEA51E9A #. SourceLocation:	/Game/Widgets/MainMenu/UMG_MainMenu.UMG_MainMenu_C:WidgetTree.TextBlock_5.Text #: /Game/Widgets/MainMenu/UMG_HelpWindow.UMG_HelpWindow_C:WidgetTree.T_WindowName.Text #: /Game/Widgets/MainMenu/UMG_MainMenu.UMG_MainMenu_C:WidgetTree.TextBlock_5.Text msgid "How to Play?"
msgstr "Bagaimana cara bermain?"  #. Key:	B57FFA644B0A76CD49CFE090569CB878 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_HelpWindow.UMG_HelpWindow_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/MainMenu/UMG_HelpWindow.UMG_HelpWindow_C:WidgetTree.TextBlock_0.Text msgid "Quick start:\r\n- Your energy is your health. Maintain it to make sure you are not an easy kill to other players\r\n- If the outpost has turrets, do not aim your chainsaw or weapon or you'll be killed\r\n- Tents and houses are safe places. No one can raid you or steal your items\r\n- Use workbench to upgrade your tent\r\n- If you get stuck, type: /kill in the chat\r\n- C key to wave; X key to sit; Enter to chat\r\n\r\n[Step 1: Spawn]\r\nYou'll spawn on a predetermined outpost based on your SteamID and you're given some starting money (MK). Please use this MK to buy your first tool from the vendor next to your spawn point. Starter vendors have different items for sale, but we'll use the fishing rod as an example.\r\n\r\n[Step 2: Making MK by fishing]\r\nNow that you've bought yourself a fishing rod, you can start walking along the shore to look for fishing spots! To locate fishing spots, look for abnormalities in the water surface. Keep in mind that every fishing spot has a different set of fish you can catch, and the best fish is always up north. This rule applies to everything related to moneymaking or finding rare items. You'll have to explore to find the most valuable stuff.\r\n\r\nOnce you've caught enough fish, sell the fish to the vendor you bought the fishing rod from.\r\n\r\n[Step 3: Spend or Invest]\r\nYou've now made some MK, and you can do whatever you want with it. You should use the boat at the starting point to travel to Sgt. Lake's Outpost. There you can buy yourself a tent, a workbench for crafting and a container to store loot in.\r\n\r\nBuild yourself a base camp, make friends and build a village!"
msgstr "Mulai dengan cepat:\r\n- Energi Anda adalah darah Anda. Pertahankan untuk memastikan Anda tidak mudah dibunuh oleh pemain lain\r\n- Jika pos terdepan memiliki turet, jangan arahkan gergaji mesin atau senjata Anda atau Anda akan terbunuh\r\n- Tenda dan rumah adalah tempat yang aman. Tidak ada yang bisa menyerbu Anda atau mencuri barang-barang Anda\r\n- Gunakan meja kerja untuk meningkatkan tenda Anda\r\n- Jika Anda Stuck(nyangkut), ketik: /kill dalam obrolan\r\n- Tombol C untuk melambai; Tombol X untuk duduk; Enter untuk chat\r\n\r\n[Langkah 1: Spawn]\r\nAnda akan spawn di pos yang telah ditentukan berdasarkan SteamID Anda dan Anda akan diberikan sejumlah uang awal (MK). Silakan gunakan MK ini untuk membeli alat pertama Anda dari vendor di sebelah titik spawn Anda. Vendor awal memiliki item yang berbeda untuk dijual, tetapi kami akan menggunakan joran sebagai contoh.\r\n\r\n[Langkah 2: Membuat MK dengan cara memancing]\r\nSetelah Anda membeli joran, Anda bisa mulai berjalan di sepanjang pantai untuk mencari tempat memancing! Untuk menemukan tempat memancing, carilah ketidaknormalan di permukaan air. Ingatlah bahwa setiap tempat memancing memiliki jenis ikan yang berbeda yang dapat Anda tangkap, dan ikan terbaik selalu berada di bagian utara. Aturan ini berlaku untuk semua hal yang berhubungan dengan menghasilkan uang atau menemukan barang langka. Anda harus menjelajah untuk menemukan barang yang paling berharga.\r\n\r\nSetelah Anda menangkap cukup banyak ikan, jual ikan ke penjual tempat Anda membeli joran.\r\n\r\n[Langkah 3: Belanjakan atau Investasikan]\r\nAnda sekarang telah membuat beberapa MK, dan Anda dapat melakukan apa pun yang Anda inginkan. Anda harus menggunakan perahu di titik awal untuk melakukan perjalanan ke Pos Sersan Lake. Di sana Anda dapat membeli tenda, meja kerja untuk membuat kerajinan tangan, dan wadah untuk menyimpan jarahan.\r\n\r\nBangunlah basecamp Anda sendiri, jalin pertemanan dan bangunlah sebuah desa!"  #. Key:	6E8A38AC4DF56D0E59F6769FC976943C #. SourceLocation:	/Game/Widgets/MainMenu/UMG_HostServerLoadingScreen.UMG_HostServerLoadingScreen_C:ExecuteUbergraph_UMG_HostServerLoadingScreen [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_HostServerLoadingScreen.UMG_HostServerLoadingScreen_C:ExecuteUbergraph_UMG_HostServerLoadingScreen [Script Bytecode] msgid "Server starting up"
msgstr "Server mulai menyala"  #. Key:	A460A8C04FCA20E0A6B932BD5D4BB91A #. SourceLocation:	/Game/Widgets/MainMenu/UMG_HostServerLoadingScreen.UMG_HostServerLoadingScreen_C:WidgetTree.T_StartText.Text #: /Game/Widgets/MainMenu/UMG_HostServerLoadingScreen.UMG_HostServerLoadingScreen_C:WidgetTree.T_StartText.Text msgid "Server starting up...."
msgstr "Server mulai menyala...."  #. Key:	406722734E11562BAA04DDA097CBE61F #. SourceLocation:	/Game/Widgets/MainMenu/UMG_InitLoadingScreen.UMG_InitLoadingScreen_C:ExecuteUbergraph_UMG_InitLoadingScreen [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_InitLoadingScreen.UMG_InitLoadingScreen_C:ExecuteUbergraph_UMG_InitLoadingScreen [Script Bytecode] msgid "Starting up"
msgstr "Mulai"  #. Key:	14DFAAEF47307740DDC82C9657F63869 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_InitLoadingScreen.UMG_InitLoadingScreen_C:WidgetTree.T_StartText.Text #: /Game/Widgets/MainMenu/UMG_InitLoadingScreen.UMG_InitLoadingScreen_C:WidgetTree.T_StartText.Text msgid "Starting up...."
msgstr "Mulai...."  #. Key:	E6CE42804E7129C53DA8708B878D4062 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(0).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(0).Tips msgid "Tip: Bring a campfire with you everywhere you go. It regenerates your energy passively when you stand next to it"
msgstr "Tip: Bawa api unggun ke mana pun Anda pergi. Itu memulihkan energi Anda secara pasif ketika Anda berdiri di dekatnya"  #. Key:	914E0AE54B8C540829510A9339B023F5 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(1).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(1).Tips msgid "Tip: Build structures around your tent to prevent other campers from placing their tent too close to yours"
msgstr "Tip: Bangun struktur di sekitar tenda Anda untuk mencegah berkemah lain menempatkan tenda mereka terlalu dekat dengan tenda Anda"  #. Key:	1EB33C7D43C7F08C6AB7A786B8B5B437 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(2).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(2).Tips msgid "Tip: Some plants grow faster near water and some in dry areas. Double the growing rate by choosing the right spots"
msgstr "Tip: Beberapa tanaman tumbuh lebih cepat ketika dekat dengan air dan beberapa ketika kering. Dengan memilih tempat yang tepat mereka bisa tumbuh dua kali lebih cepat"  #. Key:	19F05B1E4C9104C3CA41A0A0FC11EA88 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(3).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(3).Tips msgid "Tip: Avoid walking in deep water. It consumes a lot of energy and makes you defenceless"
msgstr "Tip: Hindari berjalan di air yang dalam. Sangat menguras tenaga dan kamu tidak bisa berbuat apa-apa"  #. Key:	CC28F7EF4C2F167F5156C697330B3E4C #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(4).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(4).Tips msgid "Tip: The research tent requires a lot of space. Remove the surrounding trees with a chainsaw and try placing it again"
msgstr "Tip: Tenda penelitian memerlukan banyak ruang. Hilangkan pohon di sekitarnya dengan gergaji mesin dan coba letakkan lagi"  #. Key:	DCAD568C492451B41B55FE95AE4A6FC7 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(5).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(5).Tips msgid "Tip: The best fishing spots are never near the fishing vendor. Try small islands and spots around other vendors"
msgstr "Kiat: Lokasi memancing terbaik tidak pernah dekat dengan penjual memancing. Coba pulau-pulau kecil dan lokasi di sekitar penjual lainnya."  #. Key:	0086549242DB71BE092B7A8DBE0CC65E #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(6).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(6).Tips msgid "Tip: Stay still while firing a weapon. Moving will make your accuracy worse"
msgstr "Tip: Tetap diam saat menembakkan senjata. Bergerak akan memperburuk akurasi Anda"  #. Key:	6602BEB24B3984DC0D93E992208780DA #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(7).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(7).Tips msgid "Tip: High value vendors are located in the northern parts of the island, which makes the surrounding areas more competetive and dangerous"
msgstr "Tip: Pedagang dengan harga tinggi terletak pada bagian utara pulau, yang mana menyebabkan area sekitarnya menjadi lebih kompetitif dan berbahaya"  #. Key:	94D896AD4DA2BB01704F66A19619D68F #. SourceLocation:	/Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(8).Tips #: /Game/Widgets/MainMenu/UMG_LoadingScreen.Default__UMG_LoadingScreen_C.Tips(8).Tips msgid "Tip: You can locate fishing spots by looking for abnormalities on the water surface"
