msgstr "Rumah perlu kayu secara berkala!"  #. Key:	BaseUpkeep_Responses_Index1 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.BaseUpkeep.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(1).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E #: /Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.BaseUpkeep.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(1).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E msgctxt "DT_ChatResponses"
