msgstr "R"  #. Key:	8B1736364E80AD482F48A18B5A510581 #. SourceLocation:	/Game/Widgets/UMG_Inputs.UMG_Inputs_C:WidgetTree.TextBlock_32.Text #. Key:	9335E80142F802C3AF276AAD1FDE7AE6 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_19.ActionDescription #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_19.ActionDescription #: /Game/Widgets/UMG_Inputs.UMG_Inputs_C:WidgetTree.TextBlock_32.Text msgid "Gesture Wheel"
