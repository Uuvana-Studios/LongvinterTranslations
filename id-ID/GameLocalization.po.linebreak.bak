msgstr "x5"  #. Key:	A7A7464E47AA1084C489D38ACDC54BEF #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:ExecuteUbergraph_UMG_QuestDetails [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:ExecuteUbergraph_UMG_QuestDetails [Script Bytecode] msgid "Are you sure you want to delete this quest?"
msgstr "Apakah Anda yakin ingin menghapus misi ini?"  #. Key:	D1E66899437A3D4C7A67C9AB1E9D939B #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:ExecuteUbergraph_UMG_QuestDetails [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:ExecuteUbergraph_UMG_QuestDetails [Script Bytecode] msgid "Delete"
msgstr "Hapus"  #. Key:	0300D81945B24324BC99668BE1A99DAA #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "This will get you started on farming."
msgstr "Mulailah bertani."  #. Key:	0381BFA6430BE33F98A4DCB46112A677 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "To have access to best gear you first need to prove yourself. Hunt and gather all the feathers!"
msgstr "Untuk bisa mengakses perlengkapan terbaik ayo buktikan dirimu. Cari dan kumpulkan semua bulu!"  #. Key:	1570B7C94DB585DEED98CFB3D7437DB3 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Lets see what you can do, craft the following items."
msgstr "Lihat apa yang bisa kamu lakukan, buat beberapa item berikut."  #. Key:	16A9029B40C25C49A3FD63BAF679FFAB #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Who said fishing is boring? It's exploring with a big reward in the end. Mysterious fish can be found everywhere."
msgstr "Siapa bilang memancing itu membosankan? Itu menjelajah dengan hadiah besar di akhir. Ikan misterius bisa ditemukan di mana saja."  #. Key:	178117BD4C48AF461430AAAA3356652A #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Explore all the House upgrade paths to discover new possibilities."
msgstr "Jelajahi semua jalur peningkatan Rumah untuk menemukan berbagai kemungkinan baru."  #. Key:	260D6CDA4A9EB8AD08F627B5828CE66F #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Be ready for nights when there's no solar power!"
msgstr "Bersiaplah untuk malam hari ketika tidak ada tenaga surya!"  #. Key:	2944073B49A41E8A6D6CE4B335B554E1 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "To become a master fisher. You will need to find catch all the fishes there is."
msgstr "Untuk menjadi seorang nelayan ulung. Anda harus menemukan semua ikan yang ada."  #. Key:	3223971F4720B4FD53627AB71562FA5E #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Travel to warm Kolkka."
msgstr "Perjalanan ke Kolkka yang hangat."  #. Key:	3FFA5EC643468FD456468E86887FFB53 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Rumors of extraordinary animals have been going around for a while. It's time to find out if they are true."
msgstr "Rumor tentang hewan luar biasa telah beredar selama beberapa waktu. Saatnya mencari tahu apakah itu benar."  #. Key:	49270AFD4D72ED029E5F9296F9668852 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Before you can head into the mines, you will need to prepare accordingly."
msgstr "Sebelum Anda bisa masuk ke dalam tambang, Anda harus mempersiapkan diri dengan baik."  #. Key:	4E8CB8374C952366548557939B7DD928 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Cooking is much like art. Experiment with different ingredients and challenge yourself to cook every dish to perfection!"
msgstr "Memasak itu seperti seni. Bereksperimenlah dengan bahan-bahan yang berbeda dan tantang diri Anda untuk memasak setiap hidangan dengan sempurna!"  #. Key:	548AD88C47DDD857CAED4F9BD13D8A71 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Now that you have collected new ores, it's time to start making ingots!"
msgstr "Setelah Anda mengumpulkan bijih baru, sekarang saatnya untuk mulai membuat ingot!"  #. Key:	58DF9606488AED1328F92DB36D229AB1 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Travel to barren Krokon."
msgstr "Pergi ke Krokon yang tandus."  #. Key:	5D70698E4A3E8730880FE18C7BF801AB #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "There is a second, even bigger mine. Go and find out what lies within!"
msgstr "Ada tambang kedua yang lebih besar lagi. Pergi dan cari tahu apa yang ada di dalamnya!"  #. Key:	621552EB4E0D225287B5B3A190841960 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "All researches need a base of operation."
msgstr "Semua penelitian membutuhkan basis operasi."  #. Key:	627CE9FC488C26B54C9EA3B8682525DC #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Brighten up your yard with beautiful colors!"
msgstr "Cerahkan halaman Anda dengan warna-warna yang indah!"  #. Key:	65C8E9214CDF4A393D44A0ADEFC70C0D #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Go to the mines and access the facility's loot rooms. You might discover something valuable!"
msgstr "Pergilah ke tambang dan akses ruang jarahan di fasilitas ini. Anda mungkin akan menemukan sesuatu yang berharga!"  #. Key:	7207383841F9E31FA71166B24D10BC51 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Travel to Norra and Grunni. Visit the arenas and try your luck with the loot! "
msgstr "Pergian ke Norra dan Grunni. Kunjungi arena dan cobalah keberuntungan Anda dengan jarahan!"  #. Key:	79BFED3547BB76648BB97CB22A9B1667 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Upgrade your tent to a house. "
msgstr "Tingkatkan tenda menjadi sebuah rumah. "  #. Key:	7A6E8E4D462D9447DA8277BDD7782CD0 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Deal with the birds. You can keep the feathers."
msgstr "Berurusan dengan burung. Anda bisa menyimpan bulunya."  #. Key:	835079A141AD412AD51AE38152EE73C8 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Locally produced food is always best."
msgstr "Makanan yang diproduksi secara lokal selalu yang terbaik."  #. Key:	841B99BD44AE34F4B33FE5BC56C75584 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Your house needs wood deposits to stay intact."
msgstr "Rumah Anda membutuhkan simpanan kayu agar tetap utuh."  #. Key:	9C6C29AE44D88E87C3F820858DA2D84C #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "The fuel prices are outrageous these days! It's time to find the LRI oil rig and make some fuel by yourself."
msgstr "Harga bahan bakar saat ini sungguh keterlaluan! Sudah waktunya mencari rig minyak LRI dan membuat bahan bakar sendiri."  #. Key:	9CAB5E654975D5FBD46987A4C89767A4 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Travel to beautiful Isla Inocentes."
msgstr "Bepergian ke Isla Inocentes yang indah."  #. Key:	A661DF0842CB060312194C941D9F1983 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Sirola has the best selection of items that are needed for upgrading your house."
msgstr "Sirola memiliki pilihan barang terbaik yang dibutuhkan untuk meningkatkan kualitas rumah Anda."  #. Key:	AF2515DE449DB78F09C12AA870210753 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Although LRI can be jerks sometimes, they've actually set up some pretty cool stuff for us here on the island."
msgstr "Meskipun LRI terkadang bisa menjadi orang yang menyebalkan, mereka sebenarnya telah menyiapkan beberapa hal yang cukup keren untuk kita di pulau ini."  #. Key:	AFE04D2D442B1FA65FB16F935186F28B #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Farming is honest work but first requires you to explore the island and find plants to farm on your own."
msgstr "Bertani adalah pekerjaan yang jujur, tetapi pertama-tama Anda harus menjelajahi pulau dan menemukan tanaman untuk ditanami sendiri."  #. Key:	B2759ED144749D1315D4DDBCE13743BF #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Travel to faraway Jumo."
msgstr "Bepergian ke Jumo yang jauh."  #. Key:	B498F6EA46EC7F66A94F97969719B312 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Mix it up for fun. "
msgstr "Campurkan untuk bersenang-senang. "  #. Key:	C579980F4F04DFDF945CCF8AFE1CDB29 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Others stealing your crops? The farming vendor is selling AutoDefenders to help you with that."
msgstr "Orang lain mencuri hasil panenmu? Penjual pertanian menjual AutoDefender untuk membantumu mengatasinya."  #. Key:	D1117DF642D0D06098457C9215B9851C #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Hats aren't just for fashion; they hold surprisingly useful effects as well. Let's see if you can collect these ones."
msgstr "Topi tidak hanya untuk gaya; mereka juga menyimpan efek berguna yang mengejutkan. Mari lihat apakah Anda bisa mengumpulkan ini."  #. Key:	D26C2F4F41E4740FB3351FA79F0657D5 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "A collar, you say? Perfect! Swap it at the vendor for your own speedy mount. Adventure awaits!"
msgstr "Kerah, katamu? Sempurna! Tukarkan pada penjual untuk tunggangan cepat milikmu sendiri. Petualangan menanti!"  #. Key:	D4535122400B36F42FA575B7256C441D #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Travel to north of Nauvo."
msgstr "Pergi ke bagian Utara Nauvo."  #. Key:	D6F09ADD4B9270DAC4CFF8AF8ECADA7A #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Welcome to Longvinter island! Start earning some Mk to buy your own tent. Following these tasks will help you get started!"
msgstr "Selamat datang di pulau Longvinter! Mulai mengumpulkan beberapa Mk untuk membeli tenda Anda sendiri. Mengikuti tugas-tugas ini akan membantu Anda memulai!"  #. Key:	D799974942F9D4030FBC7F8C6ACE03D2 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Customize your weapons to suit your style better."
msgstr "Sesuaikan senjata Anda agar lebih sesuai dengan gaya Anda."  #. Key:	D8712B784A30A3B6533A029EDAC6A133 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Do you have what it takes to get to the gold?"
msgstr "Bisakah kamu mencapai emas?"  #. Key:	D910B9F748E9D80446E99C8D97B96B71 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "LRI has a vast reach everywhere. Swing by the supply depot and see what's in store for you."
msgstr "LRI memiliki jangkauan luas di mana-mana. Singgahlah ke depot persediaan dan lihat apa yang tersedia untukmu."  #. Key:	DF0010D34D891C2DB09C1EA1117752B3 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Discover the mine, gather minerals, and explore while keeping an eye out for other miners!"
msgstr "Temukan tambang, kumpulkan mineral, dan jelajahi sambil mengawasi penambang lain!"  #. Key:	EE918C66480FADEC4E6A0B90463EFA8B #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Fond of mining? Collect more resources from beneath the ground to obtain a golden ingot!"
msgstr "Suka menambang? Kumpulkan lebih banyak sumber daya dari bawah tanah untuk mendapatkan ingot emas!"  #. Key:	F043B5DE4BE06D6CCB4B5CA0AB8CEAF2 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Everyday activities."
msgstr "Aktivitas sehari-hari."  #. Key:	F160B6D541AF6C88C999E995D93E99F7 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Now that you've gotten the hang of it, it's time to get out of your comfort zone and start exploring the island!"
msgstr "Sekarang Anda sudah mulai terbiasa, waktunya keluar dari zona nyaman dan mulai menjelajahi pulau!"  #. Key:	F2D77B4744AED97AB01F5DA87815139A #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Travel to endless Kupmo."
msgstr "Bepergian ke Kupmo tak terbatas."  #. Key:	F3C4247548BD31033618328020EE0110 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Hermit is a grumpy old man. You will need to warm him up with some chanterelle soup!"
msgstr "Petapa adalah seorang lelaki tua yang pemarah. Anda perlu menghangatkannya dengan sup chanterelle!"  #. Key:	FF298B9941C08AD9EC9234BB204F751E #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:GetQuestDescription [Script Bytecode] msgid "Now something bit more unique."
msgstr "Sekarang sesuatu yang lebih unik."  #. Key:	65E930B74A36BD2E986A72BC5E05C44F #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:WidgetTree.dismiss.Text #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:WidgetTree.dismiss.Text msgid "Dismiss"
msgstr "Abaikan"  #. Key:	B9F01C8B45A9EE1A907F92AC32B67A63 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:WidgetTree.T_QuestName_2.Text #: /Game/Widgets/Inventory/UMG_QuestDetails.UMG_QuestDetails_C:WidgetTree.T_QuestName_2.Text msgid "Reward: "
msgstr "Hadiah: "  #. Key:	007846D24785C7D75478FE8528BCB655 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You should find some in the Green Chest."
msgstr "Kamu bisa menemukan beberapa di Kotak berwarna hijau."  #. Key:	0571D2B24F6127BBBD8601BAC869621D #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can purchase an AutoDefender from the farming vendor"
msgstr "Kamu bisa membel AutoDefender dari penjual alat tani"  #. Key:	064432694F7A980F7CB4F3A3AE604F0F #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "They usually hide away for a few seconds after being shot"
msgstr "Mereka biasanya bersembunyi beberapa detik setelah ditembak"  #. Key:	07B26A274713CE70E8E3F793A602D42F #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Alpha Animals can drop this hat."
msgstr "Binatang-binatang Alfa dapat menjatuhkan topi ini."  #. Key:	0930FE1D49194C29CFC1D5B007DCAA17 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "To catch some fish you need a tool for that. Buy fishing rod by clicking the vending machine near the dock."
msgstr "Untuk memancing ikan kamu membutuhkan alat. Beli tongkat pancing dengan klik mesin penjual otomatis dekat dermaga."  #. Key:	0B8E3A4E438B300E7E230A8FD787056A #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Miner in Sgt. Lake sells it for a good price."
msgstr "Penambang di Danau Sgt. menjualnya dengan harga bagus."  #. Key:	0E2D42644FB049F04C907BA2E4BD0C54 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can use a basic pickaxe"
msgstr "Anda bisa menggunakan pakur biasa"  #. Key:	11045F9E47DE163D7B7716800D9669B7 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Hermit is in Skabban island"
msgstr "Si Hermit berada di pulau Skabban"  #. Key:	1584542E4885FEE83881EA8D39F550BD #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Check out different vendors and buy a research tent. You will need it to survive."
msgstr "Kunjungi berbagai vendor dan belilah tenda penelitian. Anda akan membutuhkannya untuk bertahan hidup."  #. Key:	15B6BD324A7FC1581BCEDB8468E0EFEA #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Combine all the pristine trophies in the Advanced Workbench."
msgstr "Gabungkan semua trofi murni di Advanced Workbench."  #. Key:	1855F8A54A3C983CEA04F9BEACFB839B #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Can be found in legendary orange chests."
msgstr "Dapat ditemukan di peti oranye legenda."  #. Key:	1868E02B4B10918513CA8F8936D90158 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Northern islands have better loot."
msgstr "Pulau-pulau bagian utara memiliki jarahan lebih baik."  #. Key:	1BE53ED0473C9023F039879A7991B965 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Talk with the vendor on Koilot Island."
msgstr "Bicaralah dengan penjual di Pulau Koilot."  #. Key:	1FAA9A8B4B99F7A7DEABC98A63AADA98 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Trace the pipelines to locate the refinery atop the oil rig."
msgstr "Lacak pipa-pipa untuk menemukan kilang di atas rig minyak."  #. Key:	2013509D4436F33852DB51A6F8A34457 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Add crude oil to the refinery. Wait briefly for fuel to be produced."
msgstr "Tambahkan minyak mentah ke pabrik penyulingan. Tunggu sebentar agar bahan bakar diproduksi."  #. Key:	218A49DD41E28C759B7134AD83FD4D0C #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Find and get rid of them. "
msgstr "Temukan dan singkirkan mereka "  #. Key:	21FDAA55494E1E0FE47FD68E94F81402 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Collect wheat you have planted yourself."
msgstr "Kumpulkan gandum yang Anda tanam sendiri."  #. Key:	23B853094A221CF2AFDE82ACD14EE896 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Place this inside your tent."
msgstr "Letakkan ini di dalam tenda kamu."  #. Key:	2444930F421D8D29590FA1AE6CCC05FE #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can buy and sell items to vending machines."
msgstr "Anda dapat membeli dan menjual barang ke mesin penjual otomatis."  #. Key:	31269F1E4C63DABA27742195CE0933CD #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Cook food from plants you have harvested."
msgstr "Masaklah makanan dari tanaman yang telah Anda panen."  #. Key:	3189B7FB43A397C597A8179D9C9D2A95 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Weapons can be crucial. Remember to bring backup, as he's rumored to be a tough one"
msgstr "Senjata bisa sangat penting. Ingatlah untuk membawa cadangan, karena ia dikabarkan sangat tangguh"  #. Key:	3319689F4C187CEF279F7F95EEF1A457 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "After compendium completion, Filemon will offer you to buy a Hunting Hat. Visit him."
msgstr "Setelah Kompendium selesai, Filemon akan menawarkan Anda untuk membeli Topi Berburu. Kunjungi dia."  #. Key:	34052DE44132E089C80D9698585977E4 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Good old bench, you can use this forever."
msgstr "Bangku tua yang bagus, Anda dapat menggunakannya selamanya."  #. Key:	36A564144D57D5ECDF1023B5583EAF02 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Look for a black stuff that is attached to rocks"
msgstr "Carilah benda hitam yang menempel di bebatuan"  #. Key:	3A1AE59944305FFC73E04BAAEB1BDC99 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Travel via boat or swim to the island."
msgstr "Bepergian dengan perahu atau berenang ke pulau tersebut."  #. Key:	3AD50D764422D3D7614FA090A679E9E1 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Even a chainsaw will do!"
msgstr "Bahkan gergaji mesin pun bisa digunakan!"  #. Key:	3ADC67A4475E49BD4540D69E6779B828 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Islands vegetation can be collected. Try clicking on stuff or press [SPACE] to interact with objects around you."
msgstr "Vegetasi pulau dapat dikumpulkan. Coba klik pada benda-benda atau tekan [SPASI] untuk berinteraksi dengan benda-benda di sekitar Anda."  #. Key:	3B93A9DA4D5CFAF1BE8CBAA955252616 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Travel to the coordinates and see if you find anything interesting."
msgstr "Bepergian ke koordinat dan lihat apakah Anda menemukan sesuatu yang menarik."  #. Key:	3CA4716D4399653D9A9739902ED72DF2 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Talk with the vendor on Heisala Island."
msgstr "Bicaralah dengan penjual di Pulau Heisala."  #. Key:	411A95C447392535AA90C3ACAE67EB06 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Try to see if vendors sell it or craft one"
msgstr "Coba lihat apakah vendor menjualnya atau membuatnya sendiri"  #. Key:	420464FD4F39E804B193E89AA2355F07 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Alpha animals can appear in any regular animal spot, but they are bigger."
msgstr "Hewan-hewan alpha dapat muncul di tempat hewan biasa, tetapi mereka lebih besar."  #. Key:	4271B2E34EFD004A40B895970808065E #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Wonderful tool to help you craft things. You should get one."
msgstr "Alat yang luar biasa untuk membantu Anda membuat sesuatu. Anda harus memilikinya."  #. Key:	463CF1104D6164BAA4C3368C6F6A9664 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Keep hunting for birds to get those pristine feathers!"
msgstr "Teruslah berburu burung untuk mendapatkan bulu-bulu yang masih asli!"  #. Key:	46A1A1EC47DEBE552330249154FE2E95 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Just have the soup in your inventory. It will be delivered automatically"
msgstr "Cukup sediakan sup dalam inventaris Anda. Ini akan dikirim secara otomatis"  #. Key:	473C86C54BD5328244EBA8B5F5457C6D #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Once in the bunker, enter the locked room and find the documents. You may need a keycard."
msgstr "Setelah berada di dalam bunker, masuklah ke dalam ruangan yang terkunci dan temukan dokumen-dokumen tersebut. Anda mungkin membutuhkan kartu kunci."  #. Key:	4B1A605C45EAB967C293A2A6D486006D #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "All of the spots that you know already can turn into special ones."
msgstr "Semua tempat yang Anda ketahui sebelumnya dapat berubah menjadi yang istimewa."  #. Key:	4CF376614D1F5FDB127A6180039091E4 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Just add them to the painting station!"
msgstr "Cukup tambahkan saja ke Alat pengecatan!"  #. Key:	4E4357B947284C3FF5BABFAB4FDA1CE7 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can pick up by right-clicking any placed item."
msgstr "Anda dapat mengambil dengan mengklik kanan item yang ditempatkan."  #. Key:	587EECB24810A909BC3592961973A518 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can find the control room by following the lines painted on the ground."
msgstr "Anda dapat menemukan ruang kendali dengan mengikuti garis yang dilukis di tanah."  #. Key:	5BD1B9C24C914E7E24EFF2AE38C3EFAD #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Explore the coast and seas for fish spots."
msgstr "Jelajahi pantai dan lautan untuk mencari ikan."  #. Key:	6027AC424F09266DECC1C5BB415DEAA5 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Different biomes yield different amounts of ores."
msgstr "Bioma yang berbeda menghasilkan jumlah bijih yang berbeda pula."  #. Key:	62337E124E742CB0D8F80A80411DFC77 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Travel around the island and find the bunker entrance."
msgstr "Berkelilinglah di sekitar pulau dan temukan pintu masuk bunker."  #. Key:	62B4A6484FC0E331621F3F8FE9DC1258 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "After finding half of the feathers, you can go hunting birds in Padva. It also has cool vendors that buy and sell hunting stuff."
msgstr "Setelah menemukan setengah dari bulu-bulu tersebut, Anda bisa berburu burung di Padva. Tempat ini juga memiliki pedagang keren yang membeli dan menjual barang-barang berburu."  #. Key:	634E48354FCE6D36F5ECE487173006CA #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Catch fishes."
msgstr "Menangkap ikan."  #. Key:	6BF6CD51446D2A64944438AA7482F770 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Explore the island and locate a cave entrance"
msgstr "Jelajahi pulau dan temukan pintu masuk gua"  #. Key:	6C2365C44B4FC756DB6569AD0936D7B5 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Check the crafting book to learn how to make them."
msgstr "Lihat buku kerajinan tangan untuk mempelajari cara membuatnya."  #. Key:	6F97DEE343C7A73905D86B928DC5A9C7 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Use the charger to charge batteries, then put the full batteries into the Backup Station."
msgstr "Gunakan pengisi daya untuk mengisi daya baterai, lalu masukkan baterai yang sudah penuh ke dalam Stasiun Cadangan."  #. Key:	703F922340FB2A5098D4D1A1E9E4CD34 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You may need to destroy turrets and activate buttons to gain access"
msgstr "Anda mungkin perlu menghancurkan menara dan mengaktifkan tombol untuk mendapatkan akses"  #. Key:	7122093742DA516B6A63809BCC88BB86 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can find dice games at Lighthouses."
msgstr "Anda dapat menemukan permainan dadu di Mercusuar."  #. Key:	7190A6594896AD144D197FB7B9B11CFD #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "To get power things you will need the electricity transmitter."
msgstr "Untuk mendapatkan daya, Anda membutuhkan pemancar listrik."  #. Key:	741252924224E2E8EDF2328F452CA957 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Both normal and alpha animals can drop pristine trophies."
msgstr "Hewan normal dan alfa dapat menjatuhkan trofi asli."  #. Key:	75971CC04C03F2C7464713B229AC5268 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Check to see if any vendors or loot chests have those"
msgstr "Periksa apakah ada vendor atau peti jarahan yang memilikinya"  #. Key:	77D298104D20E3AC9ED3F78E3D893104 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "The rumor suggests it's situated to the south of Ekholmen Island, at coordinates 50°S / 10°W"
msgstr "Rumornya, pulau ini terletak di sebelah selatan Pulau Ekholmen, pada koordinat 50°Selatan / 10°Barat"  #. Key:	7AB45DDD48E223DCF7ED6D9AD241C150 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Combine 4 of the same plant into crafting bench and make seed pack"
msgstr "Gabungkan 4 tanaman yang sama ke dalam bangku kerajinan dan buatlah paket benih"  #. Key:	7E82FF0E4A8742DBF4480CA6621A35CE #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "The nearest travel point is Diogo's docks, this beautiful island is home to mushrooms and rare birds."
msgstr "Titik perjalanan terdekat adalah dermaga Diogo, pulau yang indah ini merupakan rumah bagi jamur dan burung-burung langka."  #. Key:	7F851A0E4F4E23CB0A7E6EAFDDE6D5EF #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Loot chests near warehouses and harbours and bunkers to find gun parts and craft a gun."
msgstr "Peti Jarah di dekat gudang, pelabuhan, dan bunker untuk menemukan suku cadang senjata dan membuat senjata."  #. Key:	876D9980426C56B800263C86769B76EA #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Get anything that gives you energy"
msgstr "Dapatkan apa pun yang memberi Anda energi"  #. Key:	899B2C59441464C418C47B85C339E11B #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Shows you every recipe. Very handy."
msgstr "Menampilkan setiap resep. Sangat berguna."  #. Key:	8A7F3A86466ADC2E00D0ACB3E8DF62C5 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Use Cooking book to see how to cook stuff"
msgstr "Gunakan buku Memasak untuk melihat cara memasak makanan"  #. Key:	95351ED64CBC727BB682C9AA5B7D2819 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Try buying thing from general store!"
msgstr "Cobalah membeli barang dari toko umum!"  #. Key:	971139FD450627D4AD2868998880939B #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Once you have obtained the blueprint, you can then refer to the crafting book to learn how to craft it."
msgstr "Setelah Anda mendapatkan cetak biru, Anda dapat merujuk pada buku kerajinan untuk mempelajari cara membuatnya."  #. Key:	988E7A144C086B9499EA5792D070BADF #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can find the shooting range on Padva Island."
msgstr "Anda dapat menemukan lapangan tembak di Pulau Padva."  #. Key:	9D098C1E4DE01C6AC7F40EBBA495A849 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You will need to acquire research papers from the other quests in order to obtain blueprints. Check other vendors"
msgstr "Anda harus mendapatkan makalah penelitian dari misi-misi lain untuk mendapatkan cetak biru. Periksa vendor lain"  #. Key:	A1DDA750438FB5AB7F7B749A4DC93C48 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Add 2 wood to crafting bench."
msgstr "Tambahkan 2 kayu ke meja kerajinan."  #. Key:	A3D4A62F4FB9EE6FD86D9C98D6836A7A #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Once you have the keycard, go back to lighthouse casino and steal the gold. Its on the third floor."
msgstr "Setelah Anda mendapatkan kartu kuncinya, kembalilah ke mercusuar kasino dan curi emasnya. Ada di lantai tiga."  #. Key:	A617D22944DF1E87BC8EEA83BCE24251 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You should find some in blue boxes."
msgstr "Kamu bisa menemukan beberapa di Kotak berwarna Biru."  #. Key:	AB2592464A00013EC03EEE8C77E709B2 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "If you place items and they have a blue color. They can be picked up by anyone."
msgstr "Jika Anda meletakkan barang dan warnanya biru. Barang tersebut dapat diambil oleh siapa saja."  #. Key:	ADB6FE6847463CF19AA72E9FF77F7FD6 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Try asking your neighbors!"
msgstr "Cobalah bertanya kepada tetangga Anda!"  #. Key:	B20851AA4965F15EBB2924B68B55F2F3 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Explore islands and find wildlife, hunt it and pick up what they drop!"
msgstr "Jelajahi pulau-pulau dan temukan satwa liar, buru dan ambil apa yang mereka jatuhkan!"  #. Key:	B3FBFC5E41E2B55EA93AD9A06663978F #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can travel there using the boat in Sgt. Lake Base Camp"
msgstr "Anda dapat melakukan perjalanan ke sana menggunakan perahu di Sersan Lake Base Camp"  #. Key:	B6C78DA8454D7CDF4A91D59D7AFAB848 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "After finding half of the plants you can move your house to Heisala which has the best vendors and other items for sale."
msgstr "Setelah menemukan setengah dari tanaman, Anda dapat memindahkan rumah Anda ke Heisala yang memiliki vendor terbaik dan barang-barang lainnya untuk dijual."  #. Key:	B8CDE26D45ACFFA61AEFB08816C924BC #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Talk with the vendor on Padva Island."
msgstr "Bicara dengan penjual di Pulau Padva."  #. Key:	BCDFB033436760E184CF9397D419FBB1 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Collect blackberries you have planted yourself."
msgstr "Kumpulkan blackberries yang Anda tanam sendiri."  #. Key:	C09F5BF2403320892D04A680D654E16A #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You will need coal to power the smelter"
msgstr "Anda akan membutuhkan batu bara untuk menyalakan smelter"  #. Key:	C60BCCE248F5A3FDCE1301ABED4B200D #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Try looking into the bunkers for the keycard"
msgstr "Coba lihat di dalam bunker untuk mendapatkan kartu kunci"  #. Key:	C79138B2411265F34758ABAC8FE2AC46 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Gather plants you find in the wild"
msgstr "Kumpulkan tumbuhan yang Anda temukan di alam liar"  #. Key:	C80187D246A3C8D5A49CB69AD2BD7D87 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Collect wood and upgrade the tent into a wooden house."
msgstr "Kumpulkan kayu dan tingkatkan tendamu menjadi rumah kayu."  #. Key:	C99EE3E04CB7F6481CFA1989187BADD8 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Once you have enough money, travel to main hub by clicking on the boat."
msgstr "Setelah Anda memiliki cukup uang, pergilah ke pusat utama dengan mengeklik kapal."  #. Key:	CB3E245D448DFA7993F121AC055B9C0C #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can buy it from Kyrre's Equipment!"
msgstr "Anda dapat membelinya dari Peralatan Kyrre!"  #. Key:	D0257300448CE1571A44C4AFBA229E85 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Explore islands and pick up new things you see. Make sure to pack food and firewood for a cosy journey!"
msgstr "Jelajahi pulau-pulau dan ambil hal-hal baru yang Anda lihat. Pastikan membawa makanan dan kayu bakar untuk perjalanan yang menyenangkan!"  #. Key:	D0FE1AC246DFCBE0A28E418B83FDF153 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You will need an advanced pickaxe"
msgstr "Anda akan membutuhkan pickaxe tingkat lanjut"  #. Key:	D217CFDD46548F3C2811D793F230D7E5 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "To upgrade your base further you will need this."
msgstr "Untuk meningkatkan basis Anda lebih lanjut, Anda akan memerlukan ini."  #. Key:	D2827C0C40322268CBF9958DD9AF0C47 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "After catching half of the fishes, you can enter the fishing island that has the best vendors and other fishing items for sale!"
msgstr "Setelah menangkap setengah dari ikan-ikan, Anda dapat memasuki pulau memancing yang memiliki penjual terbaik dan item-item memancing lainnya untuk dijual!"  #. Key:	D35A00C04AA583672935C79A2A1A1798 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "After compendium completion, Angel will offer you to buy a Farming Hat. Visit her."
msgstr "Setelah menyelesaikan kompendium, Angel akan menawarkan untuk membeli Topi Petani. Kunjungi dia."  #. Key:	D47F05B24868A3764222119FB3030C98 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Visit all islands to find the rest of the plants!"
msgstr "Kunjungi seluruh pelosok pulau dan temukan sisa tanaman!"  #. Key:	D7C0784F4D873487EFCB259160C6CCDF #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Catch all other fishes that you are still missing, and use worms and blackberry's to lure rarer fishes to the spots."
msgstr "Tangkap semua ikan lain yang masih kurang, dan gunakan cacing serta blackberry untuk memikat ikan langka ke tempat-tempat."  #. Key:	DD1294B94BC9C10302562EB03CB79356 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Try looking in bunkers!"
msgstr "Coba lihat di bunker!"  #. Key:	DF16ED9A48E6240FBEB952BE98601D4B #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can find it when cutting down trees."
msgstr "Kamu bisa menemukannya ketika memangkas pohon."  #. Key:	DF6F739B47FA421350F9BD8B4E03FB8D #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "After compendium completion, Sgt. Lake will offer you to buy a Fishing Hat. Visit him."
msgstr "Setelah ringkasan selesai, Sersan Lake akan menawarkan Anda untuk membeli Topi Pancing. Kunjungi dia."  #. Key:	E128ADFB491297657B2E76BB0726D929 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Crude oil generates slowly at the pump. Open the highlighted object to collect it."
msgstr "Minyak mentah dihasilkan secara perlahan di pompa. Buka objek yang disorot untuk mengumpulkannya."  #. Key:	E15ACF3B4DBF4D4BD5077E823A42C1BC #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Use your knowledge to complete this task."
msgstr "Gunakan pengetahuan Anda untuk menyelesaikan tugas ini."  #. Key:	E25C81FD42E19252259C59A8A582E261 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can buy cash from Kyrre's equipment vendor or from the lighthouse."
msgstr "Anda dapat membeli uang tunai dari penjual perlengkapan Kyrre atau dari mercusuar."  #. Key:	E4A8A3644CE04D3667DC3BA03CA32403 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Just strike the rocks with your pickaxe"
msgstr "Pukul saja batu-batu dengan kapakmu"  #. Key:	E7D82C40414DD12E609C03A535147656 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Combine the resin you found while cutting down trees."
msgstr "Gabungkan resin yang ditemukan saat menebang pohon."  #. Key:	E8D08860445B4495BEC9EC996AB99651 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can use grenades to blow up the wall in order to access them"
msgstr "Anda dapat menggunakan granat untuk meledakkan dinding agar dapat mengaksesnya."  #. Key:	ED3B63D948798D07F5E9E2B15FA54089 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Open the decay tab and deposit wood to prevent decay."
msgstr "Buka tab pelapukan dan simpan kayu untuk mencegah pelapukan."  #. Key:	EDF3E6AB4509CADF587C4AA9B7C8A688 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Find a nice spot and click the tent in your inventory and place it down."
msgstr "Temukan tempat yang bagus dan klik tenda dalam penyimpananmu dan letakkan."  #. Key:	EE91DD5D4D1BF4D184458295944AC7FC #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Can be found on a raid island! 50°S / 10°W"
msgstr "Dapat ditemukan di pulau rampok! 50°S / 10°W"  #. Key:	EF3BE0714E3579BB765F978205BE814A #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "You can find them at  16°N / 72°E, 53°S / 63°W, and 37°N / 82°W."
msgstr "Anda dapat menemukannya di 16°N / 72°E, 53°S / 63°W, dan 37°N / 82°W."  #. Key:	F3BA85A448D1FD6925D3D0ABCF5F9FA6 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Eliminate the guards and press the button on the padded area to deactivate the lasers"
msgstr "Singkirkan penjaga dan tekan tombol di area berlapis untuk menonaktifkan laser"  #. Key:	F4F7C59F4356E70726404BB812B3B564 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "If an placeable is green while placing. Only you can pick it up."
msgstr "Jika benda yang diletakkan berwarna hijau saat ditempatkan. Hanya Anda yang dapat mengambilnya."  #. Key:	F59DDF6047784D087EB6038817574AE8 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Click on the \"New Attachment\" tab in the crafting menu."
msgstr "Klik pada tab \"Lampiran Baru\" di menu pengrajin."  #. Key:	FCDACF4A4B57CF05320B68B9041EC925 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "The tent must be placed near water to enable the upgrade."
msgstr "Tenda harus diletakkan dekat air untuk mengaktifkan upgrade."  #. Key:	FD63DFD1421BFA15FF74CBA1D70D8C28 #. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] #: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode] msgid "Click on the fishing spots near the beach and press [E] repeatedly when you catch a fish to obtain it!"
msgstr "Klik pada titik-titik memancing di dekat pantai dan tekan [E] berulang kali saat Anda menangkap ikan untuk mendapatkannya!"  #. Key:	CF8C4F9946140D98A1BDCB830FA617DE #. SourceLocation:	/Game/Widgets/Inventory/UMG_ShareHouseBtn.UMG_ShareHouseBtn_C:WidgetTree.TextBlock_10.Text #: /Game/Widgets/Inventory/UMG_ShareHouseBtn.UMG_ShareHouseBtn_C:WidgetTree.TextBlock_10.Text msgid "Share House With Team"
msgstr "Bagi Rumah Dengan Tim"  #. Key:	B840555F433C1A85476EDFBAEB4B6A79 #. SourceLocation:	/Game/Widgets/Inventory/UMG_TeamMember.UMG_TeamMember_C:Get T Energy Consumption 1 Text 0 [Script Bytecode] #: /Game/Widgets/Inventory/UMG_TeamMember.UMG_TeamMember_C:Get T Energy Consumption 1 Text 0 [Script Bytecode] msgid "Score:"
msgstr "Skor:"  #. Key:	D191455945DC7F6E179925A72D32DDCF #. SourceLocation:	/Game/Widgets/Inventory/UMG_TeamMember.UMG_TeamMember_C:WidgetTree.T_EnergyConsumption_1.Text #: /Game/Widgets/Inventory/UMG_TeamMember.UMG_TeamMember_C:WidgetTree.T_EnergyConsumption_1.Text msgid "name"
msgstr "nama"  #. Key:	50C686DF441D07D3673B91AE18D7AB6B #. SourceLocation:	/Game/Widgets/Inventory/UMG_TeamMember.UMG_TeamMember_C:WidgetTree.T_money.Text #: /Game/Widgets/Inventory/UMG_TeamMember.UMG_TeamMember_C:WidgetTree.T_money.Text msgid "mk 299"
msgstr "mk 299"  #. Key:	050D94D34580B9A5D287AAB707C072A6 #. SourceLocation:	/Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:ExecuteUbergraph_UMG_UpgradeRequirements [Script Bytecode] #: /Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:ExecuteUbergraph_UMG_UpgradeRequirements [Script Bytecode] msgid "Depositing an item here will lock out other upgrade paths."
msgstr "Menyetor item disini akan mengunci opsi penigkatan lainnya."  #. Key:	6FD92C394A982DEAC7C435BB0D8D382C #. SourceLocation:	/Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:ExecuteUbergraph_UMG_UpgradeRequirements [Script Bytecode] #: /Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:ExecuteUbergraph_UMG_UpgradeRequirements [Script Bytecode] msgid "Depositing will lock upgrades!"
msgstr "Menyetor akan mengunci peningkatan!"  #. Key:	BB12AD2E467D059B68CD21A13EE621F8 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:ExecuteUbergraph_UMG_GlobalLeaderboard [Script Bytecode] #. Key:	C98753914349CC8B081293AEB46CF9EA #. SourceLocation:	/Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:ExecuteUbergraph_UMG_SmallGlobalLeaderboard [Script Bytecode] #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:ExecuteUbergraph_UMG_GlobalLeaderboard [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:ExecuteUbergraph_UMG_SmallGlobalLeaderboard [Script Bytecode] msgid "With Special Effect"
msgstr "Dengan Efek Khusus"  #. Key:	5909BE3C40E4B5D7316EA7B2AFEA5D9B #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:GetActionText [Script Bytecode] #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:GetActionText [Script Bytecode] msgid "Enter Bunker Loot Room"
