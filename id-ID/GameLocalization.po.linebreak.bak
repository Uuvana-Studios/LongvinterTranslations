msgstr "Berhenti, ayo pemanasan!"  #. Key:	16C8275B432C0FB364621CA443EC999A #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You should place your Tent next to my cabin!"
msgstr "Anda harus menempatkan Tenda Anda di sebelah pondok saya!"  #. Key:	1932065F4FC2A62656FD02BA53C70C06 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Here is a Container for you to put inside the Tent"
msgstr "Ini Kontainer yang bisa kamu letakkan di dalam Tenda"  #. Key:	1B75F85740025ABEB909BC83C92E19DF #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Hope that bird didn't suffer"
msgstr "Semoga burung itu tidak menderita"  #. Key:	1BDFD6654D0ED77A1762EEA9A6ECBB44 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Then you can buy the ticket to fly out"
msgstr "Kemudian Anda bisa membeli tiket untuk terbang keluar"  #. Key:	1CD857E745EB66A9A7E943BBC92494AC #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #. Key:	30228D0441B4F2184821A6B8A0ADCF0C #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Just say when you're ready to leave"
msgstr "Beritahu saja kalau kamu siap pergi"  #. Key:	27DD97C140DE2DB41BEEE591B0DB6034 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You are now ready"
msgstr "Anda sudah siap"  #. Key:	2A896DB2425ED5011B6C2B91D4DB9787 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Good choice for hunting"
msgstr "Pilihan bagus untuk berburu"  #. Key:	2D80DF6D4E0AB3B9E41CEFA0C15DB1BA #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Watch out! Guards!"
msgstr "Hati-hati! Penjaga!"  #. Key:	2FA0317C4DC3900A540F0C8E08CB3018 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid " I have the rest of the components for the upgrade in my yard."
msgstr "Aku punya komponen lain untuk peningkatan di halaman belakang rumahku."  #. Key:	360916E742C9EFB1FCD082B1F0D25A1C #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You'll see fish swimming in circles."
msgstr "Anda akan melihat ikan berenang berputar-putar."  #. Key:	3C0130304179E7A8C69A6DA47FF9CF8A #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "But remember buy Wood & Matches so we can warm up"
msgstr "Tapi ingatlah beli Kayu & Korek Api agar kita bisa menghangatkan diri"  #. Key:	3E6DCF844AF081CFE2D923B84FCC03AD #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "I just remembered something..."
msgstr "Aku baru saja mengingat sesuatu..."  #. Key:	3F1D30F94B2279CB81B10094EAE07AE1 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Upgrade it from the Workbench."
msgstr "Tingkatkan dari Bangku Kerja."  #. Key:	4259DB914921744FD1617E9DD4561613 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You need to place the Workbench inside your tent"
msgstr "Anda perlu menempatkan Workbench di dalam tenda Anda"  #. Key:	44CD52B840BD085DA2FE808ADE9C0832 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Your Ammo is low. Here's more!"
msgstr "Amunisimu habis. Ini lagi!"  #. Key:	458B45284A768A8D9D6AB9ABC9E314C3 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You can also fish anywhere by clicking the water."
msgstr "Anda juga bisa memancing di mana saja dengan mengklik air."  #. Key:	467A973240D5C4CEDFE16DB3696B1AFD #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Your Energy is low."
msgstr "Energi Anda rendah."  #. Key:	49CBE95B46FE7BA08653FF82592EDE3D #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "I have excess wood in a chest in my yard"
msgstr "Saya memiliki kayu berlebih di dalam peti di halaman saya"  #. Key:	5004570E47609923F80F7CABEE9DBBAF #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Let's go pew pew!"
msgstr "Ayo kita dor dor!"  #. Key:	5480A617444D881CFD16B3A35EC923CF #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "So you don't have to start from scratch again"
msgstr "Jadi Anda tidak perlu memulai dari awal lagi"  #. Key:	582979674807F197801FB59666478CA5 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Vendor sells Light Bulbs"
msgstr "Pedagang menjual Bola Lampu"  #. Key:	664EA609447F1DA409F38CB6D2AFAF21 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Try cooking a berry salad"
msgstr "Coba buat salad buah beri"  #. Key:	67263A3E4DD75EE166F52F938B25A92E #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "This isn't what I had in mind"
msgstr "Ini bukan yang aku bayangkan"  #. Key:	688CC10F4598BB3395D14898B1A34704 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You need an Electricity Transmitter."
msgstr "Anda membutuhkan Pemancar Listrik."  #. Key:	6AD07F3E44E5E6C9ED26D8B989AD0447 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Equip things by clicking on them!"
msgstr "Pasang item dengan mengkliknya!"  #. Key:	73382BE2411F7A353F130BB43EDE20FA #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Let's take a moment to warm up by the Campfire"
msgstr "Mari sejenak menghangatkan diri di dekat Api Unggun"  #. Key:	75CFBAC54C0D271B9A184BB2B1507B8E #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You are the money king!"
msgstr "Anda adalah raja uang!"  #. Key:	8069857E4EC25B2321F712816BED1251 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You can add any ingredients to spice up your dish"
msgstr "Anda dapat menambahkan bahan apa pun untuk membumbui hidangan Anda"  #. Key:	833ADB6B47D547D8501F2086D4F36B68 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Vendor sells the tickets."
msgstr "Pedagang menjual tiket."  #. Key:	87030CDE4E5405B98A3F7F960A374F04 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You're free to have it."
msgstr "Kamu bebas memilikinya."  #. Key:	87A660414F08E94CAE3C06AE715CBA9F #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Wait! Your Energy is low."
msgstr "Tunggu! Energi Anda rendah."  #. Key:	8E19C91448B2BCFC06CE62ADF05F1717 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Your Energy is displayed on the bottom right corner"
msgstr "Energi Anda ditampilkan di pojok kanan bawah"  #. Key:	8F7C40DA450A3E142D6B3A9A8CEF9C9E #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "I see you on Longvinter Island!"
msgstr "Aku melihatmu di Pulau Longvinter!"  #. Key:	924E33194D528A0F121D20801D16E0AE #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Oh you found it. Now lets go test it!"
msgstr "Oh kamu menemukannya. Sekarang mari kita uji!"  #. Key:	92759ADE4BE3E0BB341B03AA4D269D48 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Great! That should be enough"
msgstr "Hebat! Itu seharusnya cukup"  #. Key:	9611635F427FFA78056D19BA8E9D5CD9 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "I found it from my pocket"
msgstr "Aku menemukannya dari sakuku"  #. Key:	9618D064477306705DE94BB43F3A2261 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Before it starts to generate power"
msgstr "Sebelum mulai menghasilkan energi"  #. Key:	9828B6454E302322E9FD02A953587612 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Looks cozy in here!"
msgstr "Terlihat nyaman di sini!"  #. Key:	A5E1499049782D0EACED16B20BFD78F3 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "I just remembered"
msgstr "Baru saja teringat"  #. Key:	AACE46394B4BFAD1354EBE9D331C95D6 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Seems to be ecological food harvesting"
msgstr "Tampaknya ini panen makanan ramah lingkungan"  #. Key:	AD27DF55480DC2B45F864F8675F780E0 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Just add items to the Campfire"
msgstr "Cukup tambahkan barang ke Api Unggun"  #. Key:	B0E7E318448E1E62581228855CF9B6C9 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "You should check out the Vendors here"
msgstr "Kamu perlu melihat para Pedagang di sini"  #. Key:	B16ADBC0487A66F5846746BF9EE64B12 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Water's quite deep here"
msgstr "Airnya cukup dalam di sini"  #. Key:	B4640B2A4B5B0836D7C96FA60DBA1D64 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "repeatedly to catch the fish"
msgstr "berulang kali untuk menangkap ikan"  #. Key:	BDD669A5438CB2AD4F996BBC28DF4184 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Those are needed for the upgrade."
msgstr "Ini diperlukan untuk peningkatan."  #. Key:	CBB154EC40A72A0D9117A982ABF6427A #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Your energy drains faster when swimming"
msgstr "Energi Anda terkuras lebih cepat saat berenang"  #. Key:	D35BCFD04784DFB0604C0BAB8D8F29F4 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Look for fishing spots"
msgstr "Cari tempat memancing"  #. Key:	D9F9C7A64C053B3E4FAF4FA84178E990 #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "Now we just need Electricity Generation. "
