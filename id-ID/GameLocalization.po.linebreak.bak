msgstr "Keluar"  #. Key:	3326B2E94C0F4E362CD2B6BD44F9E040 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Chicken.UMG_DiceGame_Chicken_C:WidgetTree.T_WindowDesc.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Chicken.UMG_DiceGame_Chicken_C:WidgetTree.T_WindowDesc.Text msgid "Chicken game"
msgstr "Chicken game"  #. Key:	895BF6BC4D6506D95DCF68892279BC3E #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Chicken.UMG_DiceGame_Chicken_C:WidgetTree.T_WindowDesc_1.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Chicken.UMG_DiceGame_Chicken_C:WidgetTree.T_WindowDesc_1.Text msgid "How to play:\r\n- Player and house each roll a dice, higher number wins.\r\n- In ties, player rolls again and must roll higher than the tie in order to win"
msgstr "Cara bermain:\r\n- Pemain dan rumah masing-masing melempar dadu, angka yang lebih tinggi menang.\r\n- Dalam keadaan seri, pemain berguling lagi dan harus berguling lebih tinggi dari seri untuk menang"  #. Key:	3C5F048742FBEE1DE95483877D208340 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.T_WindowDesc_2.Text #. Key:	559D0A6E4C8B7EEA41F900A1A1864D1A #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Chicken.UMG_DiceGame_Chicken_C:WidgetTree.T_WindowDesc_2.Text #. Key:	EBF1B4D1445D556705983DB477A8165D #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.T_WindowDesc_2.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Chicken.UMG_DiceGame_Chicken_C:WidgetTree.T_WindowDesc_2.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.T_WindowDesc_2.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.T_WindowDesc_2.Text msgid "Bet deposit : "
