msgstr "Hujan! Meningkatkan kesempatan Anda untuk mendapatkan ikan yang lebih baik dengan"  #. Key:	8196BEC54F7B3F5B3035899654DBB51A #. SourceLocation:	/Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] #: /Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] msgid "Other player is already in a trade"
msgstr "Pemain lain sudah berada dalam pertukaran"  #. Key:	88B5B1A94D54CF32A5466FA6E598FA78 #. SourceLocation:	/Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] #: /Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] msgid "Admin has given you Mk"
msgstr "Admin telah memberi Anda Mk"  #. Key:	A0E0350547A005B125B007BDBB27CFBE #. SourceLocation:	/Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] #: /Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] msgid "This server does not allow connections with VPN. Please disable it and restart the game in order to continue."
msgstr "Server ini tidak mengizinkan koneksi dengan VPN. Harap nonaktifkan dan mulai ulang permainan untuk melanjutkan."  #. Key:	A3DC4F604CBC672070D6B3A278FD4291 #. SourceLocation:	/Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] #: /Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] msgid "Your house is now shared with team members!"
msgstr "Rumah Anda sekarang digunakan bersama dengan anggota tim!"  #. Key:	AFDB2C214C1BCDD18BE9A39903E70CDB #. SourceLocation:	/Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] #: /Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] msgid "Shared"
msgstr "Berbagi"  #. Key:	BEED64A147E218103BF1348215584FAF #. SourceLocation:	/Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] #: /Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] msgid "You got kicked from the team!"
msgstr "Kamu dikeluarkan dari tim!"  #. Key:	CB7F3B724E3CFF9EE8074399F5F10AE0 #. SourceLocation:	/Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] #: /Game/Blueprints/PC_Longvinter.PC_Longvinter_C:ExecuteUbergraph_PC_Longvinter [Script Bytecode] msgid "You have been banned from playing the game permanently. You cannot appeal."
