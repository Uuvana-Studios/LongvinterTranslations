msgstr "+100"  #. Key:	A848D73547A6E0C8FFF43BADCDDC6134 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:ExecuteUbergraph_UMG_DiceGame_Pig [Script Bytecode] #. Key:	E4F66DD8412D756E6C96ADBEEC410FB2 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:ExecuteUbergraph_UMG_DiceGame_Liar [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:ExecuteUbergraph_UMG_DiceGame_Liar [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:ExecuteUbergraph_UMG_DiceGame_Pig [Script Bytecode] msgid "Your bet is too low"
msgstr "Taruhan Anda terlalu rendah"  #. Key:	19421D3F43F2EFF4CC3F6CA8B22AB187 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:IncreaseDeposit [Script Bytecode] #. Key:	CA9E95954F1B1FF2937A8F86BA39A268 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:IncreaseDeposit [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:IncreaseDeposit [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:IncreaseDeposit [Script Bytecode] msgid "Can't afford to bet!"
msgstr "Tidak sanggup untuk bertaruh!"  #. Key:	1B12251545ABA2986D19248BBC932F99 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.add_fuel_text_10.Text #. Key:	8529E192499AA7B762CE1291A83B3CC1 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.add_fuel_text_10.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.add_fuel_text_10.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.add_fuel_text_10.Text msgid "Match the offer"
msgstr "Cocokkan penawaran"  #. Key:	0CDF96704A45F13565D37591A2EA1C9E #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.StartGameText_1.Text #. Key:	8A94130C46805CA24A3AF6B0E3A4C3CE #. SourceLocation:	/Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:WidgetTree.TextBlock_173.Text #. Key:	F324704A4B3ED1E80E2DE1B19D60AB8E #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.StartGameText_1.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.StartGameText_1.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.StartGameText_1.Text #: /Game/Widgets/Inventory/UMG_UpgradeRequirements.UMG_UpgradeRequirements_C:WidgetTree.TextBlock_173.Text msgid "Ready"
msgstr "Siap"  #. Key:	A0D36F584354D34B9E49D28188391911 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.T_WindowDesc.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.T_WindowDesc.Text msgid "Liar's Dice"
msgstr "Liar's Dice"  #. Key:	6721A9984AE0CD577C269C9550292252 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.T_WindowDesc_1.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.T_WindowDesc_1.Text msgid "How to play:\r\n- Players roll five dice each and keep their results hidden.\r\n- Players take turns to bid on the count and value of dice, such as \"four 3s\".\r\n- Players can challenge a bid if they think it’s false. \r\n- If the total number of dice matching the bid is equal to or greater than the bid, the bid is correct and the challenger loses. If the bid is incorrect, the bidder loses."
msgstr "Cara bermain:\r\n- Para pemain melempar masing-masing lima dadu dan merahasiakan hasilnya.\r\n- Para pemain bergiliran menyebutkan jumlah dan nilai dadu, seperti \"empat angka tiga\".\r\n- Pemain dapat menggugat jika mereka merasa klaim tersebut salah. \r\n- Jika jumlah total dadu yang cocok dengan tawaran sama dengan atau lebih besar dari tawaran, maka tawaran benar dan penantang kalah. Jika tawaran salah, penawar kalah."  #. Key:	02ABD0F04E62182B7523198EDDFA8195 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.T_WindowDesc_5.Text #. Key:	6AFF5C974166F1C902C388A70EC4899D #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.T_WindowDesc_5.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Liar.UMG_DiceGame_Liar_C:WidgetTree.T_WindowDesc_5.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.T_WindowDesc_5.Text msgid "Highest bet :"
msgstr "Taruhan tertinggi:"  #. Key:	839B12334EE068727DA171B77185C84F #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:ExecuteUbergraph_UMG_DiceGame_LiarsDice_Hand [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:ExecuteUbergraph_UMG_DiceGame_LiarsDice_Hand [Script Bytecode] msgid "Dice count or face must be higher than last bid"
msgstr "Jumlah dadu atau muka dadu harus lebih tinggi dari tawaran terakhir"  #. Key:	AF1735F4478889C593F18A8C798997E9 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:ExecuteUbergraph_UMG_DiceGame_LiarsDice_Hand [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:ExecuteUbergraph_UMG_DiceGame_LiarsDice_Hand [Script Bytecode] msgid "Select the die face for the bid"
msgstr "Pilih angka dadu untuk bertaruh"  #. Key:	37829AB74B4D995CA88A259E3AA4A78E #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.T_Bid.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.T_Bid.Text msgid "Bid!"
msgstr "Tawar!"  #. Key:	05D0D6C74044C8108852139C49DD8D0E #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.T_BidDiceCount.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.T_BidDiceCount.Text msgid "5 x"
msgstr "5 x"  #. Key:	75489EE243699E2FE35AC8815B794EA8 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.T_BidDiceCount_1.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.T_BidDiceCount_1.Text msgid "x"
msgstr "x"  #. Key:	4A58E8574D9A3770DEB4F2833488C03C #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.T_Challenge.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.T_Challenge.Text msgid "Challenge!"
msgstr "Tantangan!"  #. Key:	28CE3CFF41E5BE10FA2872BFAAB048F1 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.Text.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.Text.Text msgid "Winner!"
msgstr "Pemenang!"  #. Key:	9BFC7DAD4F4917A6645E67AE1B953B82 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.Text_1.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.Text_1.Text msgid "Loser!"
msgstr "Pecundang!"  #. Key:	02E4B5064C5255B87A45F2B43AC54641 #. SourceLocation:	/Game/Widgets/Inventory/UMG_HouseUpgrade.UMG_HouseUpgrade_C:WidgetTree.T_notify.Text #. Key:	43A9E6E947C14F122155F79CA3FA8D78 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.TurnIndicator.Text #. Key:	963EDF494C2B34025A1B079013F93848 #. SourceLocation:	/Game/Widgets/ErrorMessage/UMG_Error.UMG_Error_C:WidgetTree.T_Content.Text #. Key:	B8ACBD614B24EE51B6A6FDB6FAD68EAC #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.Text_3.Text #. Key:	F08B7DBB46FC58B8D5DC09B884254708 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStageOtherPlayerView.UMG_DiceGame_Pig_PlayingStageOtherPlayerView_C:WidgetTree.Text_3.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Hand.UMG_DiceGame_LiarsDice_Hand_C:WidgetTree.TurnIndicator.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.Text_3.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStageOtherPlayerView.UMG_DiceGame_Pig_PlayingStageOtherPlayerView_C:WidgetTree.Text_3.Text #: /Game/Widgets/ErrorMessage/UMG_Error.UMG_Error_C:WidgetTree.T_Content.Text #: /Game/Widgets/Inventory/UMG_HouseUpgrade.UMG_HouseUpgrade_C:WidgetTree.T_notify.Text msgid "!"
msgstr "!"  #. Key:	B10B0815432766C63FBC0C8B67AEFE13 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Playing.UMG_DiceGame_LiarsDice_Playing_C:WidgetTree.T_Bid.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Playing.UMG_DiceGame_LiarsDice_Playing_C:WidgetTree.T_Bid.Text msgid "Bid"
msgstr "Tawar"  #. Key:	6FB3567A48D2CFABCE1C5C9BE12006D9 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Playing.UMG_DiceGame_LiarsDice_Playing_C:WidgetTree.T_DiceCount.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Playing.UMG_DiceGame_LiarsDice_Playing_C:WidgetTree.T_DiceCount.Text msgid "Dice count"
msgstr "Jumlah dadu"  #. Key:	161762D84E2ACCD8AA646BBF7970CA56 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Playing.UMG_DiceGame_LiarsDice_Playing_C:WidgetTree.T_FaceValue.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_LiarsDice_Playing.UMG_DiceGame_LiarsDice_Playing_C:WidgetTree.T_FaceValue.Text msgid "Face value"
msgstr "Nilai nominal"  #. Key:	1D4509B14E383A404A29E0B0B35F9D10 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.T_WindowDesc.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.T_WindowDesc.Text msgid "Pig game"
msgstr "Pig game"  #. Key:	8B24F6C24A0324BDCF3F76ABEBCF0AC4 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.T_WindowDesc_1.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig.UMG_DiceGame_Pig_C:WidgetTree.T_WindowDesc_1.Text msgid "How to play:\r\n- Player take turns to roll a single dice as many times as they wish, adding all roll results to a running total, but losing their gained score for the turn if they roll a 1.\r\n- First to 100 points wins."
msgstr "Cara bermain:\r\n- Pemain bergiliran melempar satu dadu sebanyak yang mereka inginkan, menambahkan semua hasil lemparan ke total yang sedang berjalan, tetapi kehilangan skor yang mereka peroleh untuk giliran tersebut jika mereka melempar 1.\r\n- Yang pertama mendapatkan 100 poin menang."  #. Key:	666444B949764A2C9B6951B29D073138 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:ExecuteUbergraph_UMG_DiceGame_Pig_PlayingStage [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:ExecuteUbergraph_UMG_DiceGame_Pig_PlayingStage [Script Bytecode] msgid "Are you idle?"
msgstr "Apakah Anda menganggur?"  #. Key:	ABFC2DCB4B5F81DF991A4E9854A3F8AC #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:ExecuteUbergraph_UMG_DiceGame_Pig_PlayingStage [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:ExecuteUbergraph_UMG_DiceGame_Pig_PlayingStage [Script Bytecode] msgid "Take action or you get kicked from the game!"
msgstr "Ambil tindakan atau Anda akan dikeluarkan dari permainan!"  #. Key:	B324D9A6488585182FF6AEB284E8D67D #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:ExecuteUbergraph_UMG_DiceGame_Pig_PlayingStage [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:ExecuteUbergraph_UMG_DiceGame_Pig_PlayingStage [Script Bytecode] msgid "You have been kicked from the dice game!"
msgstr "Anda telah dikeluarkan dari permainan dadu!"  #. Key:	44C359D84799B3E2F7EB4B823125A49B #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.add_fuel_text.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.add_fuel_text.Text msgid "Reroll"
msgstr "Gulir"  #. Key:	7264D0D247AD54EF954A4F863233A175 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.add_fuel_text_4.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.add_fuel_text_4.Text msgid "Roll"
msgstr "Roll"  #. Key:	1A87BC3F475CAA437662B88C33D8D0F6 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.add_fuel_text_5.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.add_fuel_text_5.Text msgid "Hold"
msgstr "Tahan"  #. Key:	77D5F10D462F90E32EB0FE8BCCB70AB1 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.T_AddedScore.Text #. Key:	F4C2A99D4D579866DD7B19AF0461505D #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStageOtherPlayerView.UMG_DiceGame_Pig_PlayingStageOtherPlayerView_C:WidgetTree.T_AddedScore.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.T_AddedScore.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStageOtherPlayerView.UMG_DiceGame_Pig_PlayingStageOtherPlayerView_C:WidgetTree.T_AddedScore.Text msgid "+3"
msgstr "+3"  #. Key:	C6B95E6E46C88815D79B959F52453D49 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStageOtherPlayerView.UMG_DiceGame_Pig_PlayingStageOtherPlayerView_C:WidgetTree.T_StreakLost.Text #. Key:	DBD3429C49EFBF92A26F86B6B5C204FB #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.T_StreakLost.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStage.UMG_DiceGame_Pig_PlayingStage_C:WidgetTree.T_StreakLost.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStageOtherPlayerView.UMG_DiceGame_Pig_PlayingStageOtherPlayerView_C:WidgetTree.T_StreakLost.Text msgid "Streak lost !"
msgstr "Streak hilang!"  #. Key:	1D01C5A94441A71709115FA9786C93E4 #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStageOtherPlayerView.UMG_DiceGame_Pig_PlayingStageOtherPlayerView_C:Get_Text_Text_0 [Script Bytecode] #: /Game/Widgets/DiceGames/UMG_DiceGame_Pig_PlayingStageOtherPlayerView.UMG_DiceGame_Pig_PlayingStageOtherPlayerView_C:Get_Text_Text_0 [Script Bytecode] msgid "WINS !"
msgstr "MENANG !"  #. Key:	469C44754F6877780F8F0BA8B35201A7 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_ServerContent.UMG_ServerContent_C:ExecuteUbergraph_UMG_ServerContent [Script Bytecode] #. Key:	A2D97662490556FAC48320A0520FF1DF #. SourceLocation:	/Game/Widgets/DiceGames/UMG_DiceGame_WaitingStage.UMG_DiceGame_WaitingStage_C:WidgetTree.add_fuel_text.Text #: /Game/Widgets/DiceGames/UMG_DiceGame_WaitingStage.UMG_DiceGame_WaitingStage_C:WidgetTree.add_fuel_text.Text #: /Game/Widgets/MainMenu/UMG_ServerContent.UMG_ServerContent_C:ExecuteUbergraph_UMG_ServerContent [Script Bytecode] msgid "Join"
