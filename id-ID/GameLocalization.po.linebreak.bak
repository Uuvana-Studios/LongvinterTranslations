msgstr "ID"  #. Key:	497D1FF944E2B74D51B69DAA018BCBF3 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_BanAppealTicket.UMG_BanAppealTicket_C:WidgetTree.T_bug_toGithub_1.Text #. Key:	51F29E6240C0E8683F7A43AB45A7B74B #. SourceLocation:	/Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.T_bug_toGithub_1.Text #: /Game/Widgets/MainMenu/UMG_BanAppealTicket.UMG_BanAppealTicket_C:WidgetTree.T_bug_toGithub_1.Text #: /Game/Widgets/MainMenu/UMG_FeedbackTicket.UMG_FeedbackTicket_C:WidgetTree.T_bug_toGithub_1.Text msgid "We have changed our ticketing system to chat based. You can access it from the link below"
msgstr "Kami telah mengubah sistem tiket kami menjadi berbasis obrolan. Anda dapat mengaksesnya dari tautan di bawah ini"  #. Key:	FFF5FB114AA76A1DE81CEE8A110B2098 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_BanAppealTicket.UMG_BanAppealTicket_C:WidgetTree.T_email.HintText #: /Game/Widgets/MainMenu/UMG_BanAppealTicket.UMG_BanAppealTicket_C:WidgetTree.T_email.HintText msgid "your email address"
