msgstr "Panel Admin"  #. Key:	572F697144CDCCE458EA08AF14827DC2 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_MainMenu.UMG_MainMenu_C:WipeInformation [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_MainMenu.UMG_MainMenu_C:WipeInformation [Script Bytecode] msgid "Progress Reset Alert"
msgstr "Peringatan Reset Kemajuan"  #. Key:	A55941E24D56737E16BB8380AC0F39EA #. SourceLocation:	/Game/Widgets/MainMenu/UMG_MainMenu.UMG_MainMenu_C:WipeInformation [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_MainMenu.UMG_MainMenu_C:WipeInformation [Script Bytecode] msgid "During development, we may occasionally reset gameplay progress on official servers. At times, updates might also erase progress. We'll notify you via devlogs and update notes. We apologize for any inconvenience this may cause."
msgstr "Selama pengembangan, kami mungkin sesekali mengatur ulang kemajuan permainan di server resmi. Terkadang, pembaruan juga dapat menghapus kemajuan. Kami akan memberi tahu Anda melalui devlog dan catatan pembaruan. Kami mohon maaf atas ketidaknyamanan yang ditimbulkan."  #. Key:	470962A549E0902B7990DD8579209635 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_News.UMG_News_C:WidgetTree.T_Category.Text #: /Game/Widgets/MainMenu/UMG_News.UMG_News_C:WidgetTree.T_Category.Text msgid "Latest News!"
