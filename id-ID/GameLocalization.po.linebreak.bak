msgstr "G"  #. Key:	408D1C334C8EA41330A20E89A6CDC872 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_2.ActionDescription #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_2.ActionDescription msgid "Interact / Pickup loot"
msgstr "Berinteraksi / Mengambil jarahan"  #. Key:	020EF1F34FDDB20F8A994F9A53F5A7E2 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_20.ActionDescription #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_20.ActionDescription msgid "Last Gesture"
msgstr "Gerakan terakhir"  #. Key:	DB00FF5647644127C1298589AE3E1F19 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_20.Key #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_20.Key msgid "F"
msgstr "F"  #. Key:	DF08E85F41D4EF4C667245A10A0ED03A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_8.Key #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_8.Key msgid "Escape"
msgstr "Keluar"  #. Key:	2291067E4562367A5DCD03B98F6262BC #. SourceLocation:	/Game/Widgets/UMG_MapGrid.UMG_MapGrid_C:WidgetTree.TextBlock_3.Text #. Key:	C55F67B147DFEFE66F35479F493C3E87 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_9.Key #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_9.Key #: /Game/Widgets/UMG_MapGrid.UMG_MapGrid_C:WidgetTree.TextBlock_3.Text msgid "W"
msgstr "W"  #. Key:	1537777B4E3EF8564EDFDF888AB85B56 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Blueprints_Tutorial.UMG_Blueprints_Tutorial_C:WidgetTree.TextBlock_0.Text #. Key:	1729E80443EE96DF2962938BC660F905 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Quests_Tutorial.UMG_Quests_Tutorial_C:WidgetTree.TextBlock_0.Text #. Key:	4A448596491D2D6FFF32D086DCACD612 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Crafting_Tutorial.UMG_Crafting_Tutorial_C:WidgetTree.TextBlock_0.Text #. Key:	611EC3C24BDE5DC6CF76B9B51312F725 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Mining_Tutorial.UMG_Mining_Tutorial_C:WidgetTree.TextBlock_0.Text #. Key:	D4BEE1204C6232F6DEF46590F5A6881B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Bunkers_Tutorial.UMG_Bunkers_Tutorial_C:WidgetTree.TextBlock_0.Text #. Key:	F07E7DB348E181A6E47552BC98267736 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Buffs_Tutorial.UMG_Buffs_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Blueprints_Tutorial.UMG_Blueprints_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Buffs_Tutorial.UMG_Buffs_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Bunkers_Tutorial.UMG_Bunkers_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Crafting_Tutorial.UMG_Crafting_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Mining_Tutorial.UMG_Mining_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Quests_Tutorial.UMG_Quests_Tutorial_C:WidgetTree.TextBlock_0.Text msgid "1. Text"
msgstr "1. Teks"  #. Key:	C1789FAF4BB6F0E8342F1A8878460FEE #. SourceLocation:	/Game/Widgets/Tutorials/UMG_BulletPoint.Default__UMG_BulletPoint_C.TextToDisplay #: /Game/Widgets/Tutorials/UMG_BulletPoint.Default__UMG_BulletPoint_C.TextToDisplay msgid "Your backpack automatically opens with the TAB key, revealing 20 slots for your items and gear."
msgstr "Ransel Anda secara otomatis terbuka dengan tombol TAB, memperlihatkan 20 slot untuk barang dan perlengkapan Anda."  #. Key:	D44245984451F8C8C7A206AEAFC4503A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2.Text msgid "Energy Restoration via Consumables"
msgstr "Pemulihan Tenaga melalui Konsumabel"  #. Key:	0380A2D84C6A8C8C59743CAB81B2D35B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2_1.Text #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2_1.Text msgid "You Can Cook With:"
msgstr "Kamu bisa memasak dengan:"  #. Key:	F823F60F45461A4ADB5759A0F452804F #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2_2.Text #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2_2.Text msgid "Update 1.12 - New Cooking Mechanics"
msgstr "Pembaruan 1.12 - Mekanika Memasak Baru"  #. Key:	2C1FFA424A7C42FA928AC8A5B22AF3F4 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2_3.Text #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2_3.Text msgid "Other Mechanics Of Cooking"
msgstr "Mekanisme Memasak Lainnya"  #. Key:	EE220A4B4DB3722CDBC887A17A00988D #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2_4.Text #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.Title2_4.Text msgid "Cooking Steps"
msgstr "Langkah Memasak"  #. Key:	462C77D2471D5F296F42F8ACA03E2B1A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Consumables are key to restoring energy."
msgstr "Bahan habis pakai adalah kunci untuk memulihkan energi."  #. Key:	CBF8EF3642096AAE90AF8EBC6FC152B6 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "The energy return rate varies with the quality of the consumable."
msgstr "Tingkat pengembalian energi bervariasi dengan kualitas barang konsumsi."  #. Key:	B678865B436EFA0DCC4F21BA4B6070ED #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay msgid "You're not limited to the book; experiment by adding various ingredients to the pot."
msgstr "Anda tidak terbatas pada buku; bereksperimenlah dengan menambahkan berbagai bahan ke dalam panci."  #. Key:	C8D19E01483FB2D07AFA68ABD9446664 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_11.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_11.TextToDisplay msgid "Approach the fireplace and click it with your M1 (mouse button)."
msgstr "Mendekati perapian dan klik dengan M1 (tombol mouse)."  #. Key:	CEAB84974C5AFEC39BEAC794CA2864F0 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_12.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_12.TextToDisplay msgid "If an ingredient has an effect or buff, it transfers to the finished dish. However, a dish can only hold one effect or buff at a time."
msgstr "Jika sebuah bahan memiliki efek atau penguatan, efek itu akan ditransfer ke makanan jadi. Namun, sebuah masakan hanya dapat memegang satu efek atau penguatan dalam satu waktu."  #. Key:	84D903934A99406AC2A51796CB914D95 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_13.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_13.TextToDisplay msgid "You cannot consume another food with the same status effect until the first one has worn off."
msgstr "Anda tidak dapat mengonsumsi makanan lain dengan efek status yang sama hingga efek status yang pertama hilang."  #. Key:	EC60611D430A8F2CBB2F99875B559613 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_14.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_14.TextToDisplay msgid "Foods providing more than 35 Energy trigger a cooldown period before you can eat again. This cooldown time is calculated based on the amount of energy in the food, with the cooldown status indicated by an icon on your screen's bottom left."
msgstr "Makanan yang memberikan lebih dari 35 Energi memicu periode pendinginan sebelum Anda dapat makan lagi. Waktu pendinginan ini dihitung berdasarkan jumlah energi dalam makanan, dengan status pendinginan ditunjukkan oleh ikon di pojok kiri bawah layar Anda."  #. Key:	D4556361401230048AE08C910787A79E #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_15.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_15.TextToDisplay msgid "Select the items you wish to cook from your backpack."
msgstr "Pilih barang yang ingin dimasak dari ransel anda."  #. Key:	2C1B25204B250D5BCB1638A1EA315318 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_16.TextToDisplay msgid "Once ready, click the “Cook” button and wait for the meal to finish cooking. From there transfer the meal to your backpack."
msgstr "Setelah siap, klik tombol \"Masak\" dan tunggu hingga makanan selesai dimasak. Setelah itu, pindahkan makanan ke dalam ransel Anda."  #. Key:	CD565E7F4A0E584ACA515084EC8058BE #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_17.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_17.TextToDisplay msgid "A green energy icon signals that the food is consumable and ready to eat."
msgstr "Ikon energi hijau menandakan bahwa makanan siap dimakan."  #. Key:	9EA093DA40A79D9168B7298C8150110C #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Fireplace: It must be placed inside your house and also heals your character."
msgstr "Perapian: harus ditempatkan di dalam rumah Anda dan juga menyembuhkan karakter Anda."  #. Key:	E5505113462C5C8DE8A3C3B96C7643F4 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "The Cooking Book is your go-to resource for all game recipes."
msgstr "Buku Memasak adalah sumber daya andalan Anda untuk semua resep permainan."  #. Key:	6B168626406E134D9F3548B5DCA87F9E #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "Campfire: A normal cooking process that heals your character if you stay close."
msgstr "Api unggun: Proses memasak normal yang menyembuhkan karakter Anda jika Anda tetap berada di dekatnya."  #. Key:	CD0B06EA4B41D6C2CC6A0A9C880C8DEC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "Ball Grill: Similar to a campfire, it wount heal but it cannot despawn like the campfire"
msgstr "Panggangan Bola: Mirip dengan perapian, tidak akan menyembuhkan tetapi tidak dapat hilang seperti perapian"  #. Key:	B55C7BC2445277C6F23C41A1F3DBD70F #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "Gas Stove: Provides a better cooking process compared to the others. Items have more energy"
msgstr "Gas Stove: Provides a better cooking process compared to the others. Items have more energy"  #. Key:	A37C8CA04226427D822260A812648D54 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay msgid "Meals can now  require a category of item, not just something specific."
msgstr "Makanan sekarang memerlukan kategori item, bukan hanya sesuatu yang spesifik."  #. Key:	FE7FA36E40E761F1CA9C95860D28FCA3 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay msgid "Cooking Book Contains a list of craftable items and essential recipes."
msgstr "Buku Memasak Berisi daftar bahan kerajinan dan resep penting."  #. Key:	804F9A444592BEA06A30A5A109CE5923 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_9.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Cooking_Tutorial.UMG_Cooking_Tutorial_C:WidgetTree.UMG_BulletPoint_9.TextToDisplay msgid "Some hidden recipes require studying a Cooking Recipe to learn."
msgstr "Beberapa resep tersembunyi memerlukan mempelajari Resep Memasak untuk mempelajarinya."  #. Key:	03DBD4574B50ADA2AF216FB507F165EF #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.Title2.Text msgid "Other Tips"
msgstr "Petunjuk lainnya"  #. Key:	040DDCC144DE2E5C1ECD989785A6EAFC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.Title2_1.Text #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.Title2_1.Text msgid "Placeables"
msgstr "Item yang dapat ditempatkan"  #. Key:	1EF1ABED4B629C41C7F4ABA4B8D37892 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.Title2_2.Text #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.Title2_2.Text msgid "How to Power Things?"
msgstr "Bagaimana cara memberi tenaga?"  #. Key:	00E7D1AD4105BBF4864CF0B7B0B8631A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Certain placeables need energy to function. To check, place the item on the ground and hover your cursor over it. This will display its electricity needs and current status."
msgstr "Barang tertentu memerlukan energi untuk berfungsi. Untuk memeriksanya, letakkan barang di tanah dan arahkan kursormu ke barang tersebut. Hal ini akan menampilkan listrik yang dibutuhkan dan status saat ini."  #. Key:	4387F06E463BB97CAA0F709116046C44 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "Try clicking on different placeables since they can show additional functionality "
msgstr "Coba klik pada Barang yang berbeda karena dapat menampilkan fungsionalitas tambahan "  #. Key:	45BB81614EBF721EE5FBBF97E2C53A97 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay msgid "Employ gates and fences for controlled yard access. Remember, fences can be damaged by weapons, so it's essential to guard them with turrets."
msgstr "Gunakan gerbang dan pagar untuk akses halaman yang terkontrol. Ingat, pagar dapat rusak oleh senjata, jadi sangat penting untuk menjaganya dengan menara."  #. Key:	29F03A2343B5E04EFA2FD8AB115848B5 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_11.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_11.TextToDisplay msgid "In normal mode (indicated by a yellow light), turrets only target hostiles outside your yard, allowing safe passage between homes."
msgstr "Dalam mode normal (ditandai dengan lampu kuning), menara hanya menargetkan musuh di luar halaman Anda, sehingga memungkinkan jalan yang aman di antara rumah-rumah."  #. Key:	33F3750D495B5BB2726DB79ED70948D5 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Begin by upgrading your tent to a cabin, then choose one of two upgrade paths: Sustainable or Fuel-powered. Sustainable offers steady energy, albeit less than the Fuel-powered option, which requires adding fuel via the workbench menu."
msgstr "Mulailah dengan meningkatkan tenda Anda menjadi kabin, lalu pilih salah satu dari dua jalur tingkatan: Berkelanjutan atau Bertenaga Bahan Bakar. Berkelanjutan menawarkan energi yang stabil, meskipun lebih sedikit daripada opsi bertenaga bahan bakar, yang memerlukan penambahan bahan bakar melalui menu meja kerja."  #. Key:	F988343943C1A5F6474B06B582E9DCDE #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "Start with an electricity transmitter from the workbench's home upgrades section."
msgstr "Mulai dengan transmiter listrik dari bagian upgrade rumah di bangku kerja."  #. Key:	77B4BD584B3734B9FD8525804F5DFE0A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "The game features over 100 distinct placeables, each with different purposes, ranging from functional to purely aesthetic."
msgstr "Gim ini menampilkan lebih dari 100 Barang yang berbeda, masing-masing dengan tujuan yang berbeda, mulai dari yang fungsional hingga yang murni estetis."  #. Key:	3AF181DE437F95CD4B2203951BCF362A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "Once your tent has been upgraded to a cabin, items placed within it will appear green during placement. These can only be retrieved by players who have been inside your house."
msgstr "Setelah tenda Anda ditingkatkan menjadi kabin, barang-barang yang ditempatkan di dalamnya akan terlihat hijau selama penempatan. Barang-barang ini hanya dapat diambil oleh pemain yang telah berada di dalam rumah Anda."  #. Key:	5535EEC9492F810432D6918A6AAC0BE9 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "Next, you can either enhance your house to have integrated energy or employ various placeables like solar panels or coal generators. Position them within your home's radius (indicated by a green color when placing), and they will sync with the wireless transmitter and activate. This synchronization may take time, so patience is key!"
msgstr "Selanjutnya, Anda dapat meningkatkan rumah Anda agar memiliki energi yang terintegrasi atau menggunakan berbagai perangkat lainnya seperti panel surya atau generator batu bara. Posisikan alat ini dalam radius rumah Anda (ditandai dengan warna hijau saat menempatkannya), dan alat ini akan tersinkronisasi dengan pemancar nirkabel dan menyala. Sinkronisasi ini mungkin memerlukan waktu, jadi bersabarlah!"  #. Key:	48CED5A3482987C64501BF9B13D90155 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay msgid "Turrets can be set to passive mode, making them only target players who display aggression, which is useful for hosting yard parties or allowing initial entry to non-team members. You can share your house with teammates through the workbench home menu."
msgstr "Turet dapat diatur ke mode pasif, sehingga hanya menargetkan pemain yang menunjukkan agresi, hal ini berguna untuk mengadakan pesta di halaman atau mengizinkan masuknya anggota non-tim. Anda dapat berbagi rumah dengan rekan satu tim melalui menu rumah di meja kerja."  #. Key:	A662F3244F9AF9D508AF9F89944C4B37 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay msgid "Keep in mind that while others cannot enter your tent or house, they may attempt to damage objects in your yard. It's wise to only place items outside that you're willing to lose until you can protect them with turrets."
msgstr "Ingatlah bahwa meskipun orang lain tidak dapat memasuki tenda atau rumah Anda, mereka mungkin akan berusaha merusak benda-benda di halaman Anda. Sebaiknya letakkan barang-barang di luar yang Anda tidak ingin kehilangannya sampai Anda bisa melindunginya dengan turet."  #. Key:	F2A3E3F2441833D3EC1F3691C7FE6712 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_9.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Electricity_Tutorial.UMG_Electricity_Tutorial_C:WidgetTree.UMG_BulletPoint_9.TextToDisplay msgid "Turrets are indestructible but can be temporarily disabled for 40 seconds if they sustain significant damage."
msgstr "Meriam tidak dapat dihancurkan tetapi dapat dilumpuhkan sementara selama 40 detik jika menerima kerusakan signifikan."  #. Key:	0F0A6A5F4FED3A501B17CFAD5B787664 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.TextBlock_0.Text msgid "Your character's energy can decrease in several ways:"
msgstr "Energi karakter anda dapat menurun dengan beberaba cara:"  #. Key:	5BA28FCF4ED86652AC89D789D7DB698D #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.Title2.Text msgid "Restoring Energy"
msgstr "Memulihkan Energi"  #. Key:	54ED30DE4E68816F2C496483B255DD19 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.Title2_1.Text #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.Title2_1.Text msgid "Energy Overview"
msgstr "Statistik Listrik"  #. Key:	F7C60FE940CBCB432D3FD4AFDC254E08 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.Title2_2.Text #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.Title2_2.Text msgid "Losing Energy"
msgstr "Kehilangan Energi"  #. Key:	304D313A4BF4363CB555048E06454018 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Getting hurt in combat, either from other players or NPCs, also reduces energy."
msgstr "Terluka dalam pertempuran, baik dari pemain lain atau NPC, juga mengurangi energi."  #. Key:	769B801848F8E9E5AD6130955B58D0E7 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "Consumables: These items, indicated by an energy icon, are your go-to for replenishing energy. The better the consumable, the more energy you'll get back."
msgstr "Barang habis pakai: Barang-barang ini, yang ditunjukkan dengan ikon energi, adalah andalan Anda untuk mengisi ulang energi. Semakin baik bahan habis pakai, semakin banyak energi yang akan Anda dapatkan kembali."  #. Key:	48EE478C4FB7A7121B3427BDC21F9FA7 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Swimming burns energy faster than walking."
msgstr "Berenang menghabiskan energi lebih cepat daripada berjalan kaki."  #. Key:	D2A0810842900CBEEF0041AADD899B33 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "Campfire: Sitting next to a campfire is a great way to rest and recover your energy."
msgstr "Perapian: Duduk di samping perapian adalah cara yang bagus untuk beristirahat dan memulihkan energi Anda."  #. Key:	3863A3124C3C09C3C9B25BB8D053702B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "Think of your character's energy as their health."
msgstr "Bayangkan energi karakter Anda sebagai darah mereka."  #. Key:	889680D34E3FBECAD999F1BAD0BC8C38 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "You can find your energy level on the bottom right of your screen."
msgstr "Anda dapat menemukan tingkat energi Anda di bagian kanan bawah layar."  #. Key:	0B37F5A34FF0B09CFF706D9CB72B1629 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "Walking depletes energy gradually."
msgstr "Berjalan mengurangi stamina secara berkala."  #. Key:	71EEEE4E40A3ACF596D5E89F578E35FA #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Energy_Tutorial.UMG_Energy_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay msgid "When you join the server for the first time, you'll temporarily not lose any energy. You can see this affect above your energy"
msgstr "Ketika Anda bergabung dengan server untuk pertama kalinya, Anda tidak akan kehilangan energi untuk sementara waktu. Anda dapat melihat pengaruh ini di atas energi Anda"  #. Key:	180F320841D718D560635689605A6B20 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.TextBlock.Text #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.TextBlock.Text msgid "Crops will grow at varying speeds, influenced by their environment:"
msgstr "Tanaman tumbuh dengan kecepatan yang berbeda-beda, dan terpengaruh dengan lingkungan:"  #. Key:	66D1CBAF43EACE3B4A23EB84523E68F0 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.TextBlock_0.Text msgid "To begin farming, you will need seeds. The types of seeds available for farming include those for berries, trees, beets, and flowers. You can create these seeds at a workbench by combining four of the specific plant you wish to grow."
msgstr "Untuk memulai bercocok tanam, Anda membutuhkan benih. Jenis benih yang tersedia untuk bercocok tanam antara lain benih buah beri, pohon, bit, dan bunga. Anda dapat membuat benih ini di meja kerja dengan menggabungkan empat tanaman tertentu yang ingin Anda tanam."  #. Key:	9FADF5F44793F96483390ABA95022B7D #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.Title2.Text msgid "Acquiring a Farmer's Hat"
msgstr "Mendapatkan Topi Petani"  #. Key:	1620AE7A47F65B17A69CA08A9A8199DF #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.Title2_1.Text #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.Title2_1.Text msgid "Crop Growth Rates"
msgstr "Laju pertumbuhan tanaman"  #. Key:	9AA0DCFA40B4267E59EC0FAFC19A3A52 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.Title2_2.Text #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.Title2_2.Text msgid "Increasing Your Harvest"
msgstr "Meningkatkan Hasil Panen Anda"  #. Key:	DC3EB75D4896D4A60DD8749C33696452 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.Title2_3.Text #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.Title2_3.Text msgid "Tips for Farming Efficiency"
msgstr "Kiat untuk Efisiensi Bertani"  #. Key:	B4932AE3418C044C2AFA5F88ECFD31BC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Farmer hats, which aid in your farming efforts, can be bought from the Farming NPC located on Heisala Island."
msgstr "Topi petani, yang membantu usaha pertanian Anda, dapat dibeli dari NPC Pertanian yang terletak di Pulau Heisala."  #. Key:	A9E2EAAF46A586DE3F9ED591D394F999 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "Note: You must have discovered all the plants listed in the compendium tab before making a purchase."
msgstr "Catatan: Anda harus menemukan semua tanaman yang tercantum dalam tab ringkasan sebelum melakukan pembelian."  #. Key:	B0790DE3408CA85855D0E0B71FA8829D #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay msgid "Keep in mind that different crops, plants, and trees have varying market values, with the black lotus being among the most valuable. Consider this when planning your farming strategy to maximize profits."
msgstr "Perlu diingat bahwa tanaman, tumbuhan, dan pohon yang berbeda memiliki nilai pasar yang berbeda-beda, dan teratai hitam termasuk yang paling berharga. Pertimbangkan hal ini saat merencanakan strategi pertanian Anda untuk memaksimalkan keuntungan."  #. Key:	6E2E36FD4E79036017D227A1B7B80C2F #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "To boost your chances of obtaining more produce, consider wearing a farmer’s hat. This increases the likelihood of a more bountiful harvest."
msgstr "Untuk meningkatkan peluang Anda mendapatkan hasil panen yang lebih banyak, pertimbangkan untuk mengenakan topi petani. Hal ini akan meningkatkan kemungkinan panen yang lebih banyak."  #. Key:	319694744973544F45E7B0A11D6DAAA6 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "Standard growth rate (Speed 1x) when planted directly on the ground."
msgstr "Laju pertumbuhan standar (Kecepatan 1x) saat ditanam langsung di tanah."  #. Key:	FC89B5484A1ABF97D4CA11A1A9186A9A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "Enhanced growth rate (Speed 2x) when using a pot box."
msgstr "Tingkat pertumbuhan ditingkatkan (Kecepatan 2x) saat menggunakan pot box."  #. Key:	98C14BC24948C82CCE73F3A90BE469BD #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "Proximity to water’s edge also offers an enhanced growth rate (Speed 2x)."
msgstr "Kedekatannya dengan tepi air juga menawarkan tingkat pertumbuhan yang lebih tinggi (Kecepatan 2x)."  #. Key:	64B7DAA1402C9928CDE6F2B42EB8800E #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "Occasionally, you might get two or more fruits or seeds from a single crop."
msgstr "Terkadang, Anda mungkin mendapatkan dua atau lebih buah atau biji dari satu tanaman."  #. Key:	FFC68CD5476050804AD7F19EE8E10B6A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay msgid "For the quickest growth (Speed 2.5x), use a pot box combined with a sprinkler."
msgstr "Untuk pertumbuhan tercepat (Kecepatan 2,5x), gunakan kotak pot yang dikombinasikan dengan alat penyiram."  #. Key:	D32A8461438CC3C0637B588E3D01F86F #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay msgid "Greenhouses can automate the farming process. Obtain one from an NPC, place it, and use the green box inside to plant your seeds for automatic planting and harvesting."
msgstr "Rumah kaca dapat mengotomatiskan proses pertanian. Dapatkan satu dari NPC, letakkan, dan gunakan kotak hijau di dalamnya untuk menanam benih Anda untuk penanaman dan panen otomatis."  #. Key:	2D88333340829A22D87DFA8C2D6D9153 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_9.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Farming_Tutorial.UMG_Farming_Tutorial_C:WidgetTree.UMG_BulletPoint_9.TextToDisplay msgid "Growing trees inside your greenhouse is a smart way to produce wood for your house upkeep."
msgstr "Menanam pohon di dalam rumah kaca adalah cara cerdas untuk menghasilkan kayu untuk perawatan rumah Anda."  #. Key:	2A6ED5B94E28A9977F01F9B21D59E1A3 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.Title2.Text msgid "Buy Fishing Rod"
msgstr "Beli Alat Pancing"  #. Key:	F02BE09642ADF23A73369BA7661A2BB5 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.Title2_1.Text #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.Title2_1.Text msgid "Start Fishing"
msgstr "Mulai Memancing"  #. Key:	2E9058A6483CF2D34ABC36B14C12FF5B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Fishing is a great way to earn Mk (currency) when you're new to the game."
msgstr "Memancing adalah cara terbaik untuk mendapatkan Mk (mata uang) saat Anda baru mengenal game ini."  #. Key:	F293E5C84E80CD07661476A9AE168724 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "To acquire a fishing rod, navigate to the vending machine located near your starting point. Interact with the machine by clicking on it."
msgstr "Untuk memperoleh pancingan, menuju ke mesin penjual dekat titik awal Anda. Berinteraksi dengan mesin dengan mengekliknya."  #. Key:	3481F12646ACFB0C3F1505B45B10954D #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay msgid "Purchase a fishing hat from a fishing vendor after collecting all fishes to your compendium."
msgstr "Belilah topi pancing dari penjual ikan setelah mengumpulkan semua ikan ke dalam Kompendium Anda."  #. Key:	20B8189949C81ECEDF719785B9A3AFEB #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_11.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_11.TextToDisplay msgid "Wearing this hat allows you to see which fish are available at any given fishing spot."
msgstr "Mengenakan topi ini memungkinkan Anda untuk melihat ikan apa saja yang tersedia di tempat pemancingan tertentu."  #. Key:	BB0E912A43AF9F77F3DE43B20896AB24 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Look for fishing spots throughout the game world, identifiable by fish circling on the water's surface."
msgstr "Carilah tempat memancing di seluruh dunia game, yang dapat dikenali dari ikan yang berputar-putar di permukaan air."  #. Key:	80A12B1D42500E0444BBF6B5A8E8D429 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "After buying your rod, press [TAB] to open your backpack and click on the rod to equip it."
msgstr "Setelah membeli tongkat, tekan [TAB] untuk membuka tas ransel Anda dan klik tongkat untuk menggunakannya."  #. Key:	A9AC8BAA43E9B10EE4562889720EB778 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "Click on a fishing spot to begin fishing."
msgstr "Klik pada tempat memancing untuk mulai memancing."  #. Key:	DCF830334D83BD527DF880BBD70D61F4 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "Different fish are found at different locations."
msgstr "Ikan yang berbeda ditemukan di lokasi yang berbeda."  #. Key:	A79C6B6A4172BBEA5D7834AE25F0816C #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "When a fish bites, press [E] quickly to hook it."
msgstr "Apabila ada ikan yang menggigit, tekan [E] dengan cepat untuk mengaitkannya."  #. Key:	12F49BE245EF9C6224F4B99982E7B401 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay msgid "Press TAB to view the fish you've caught in your backpack."
msgstr "Tekan TAB untuk melhat ikan apa saja yang telah kamu tangkap dalam tas kami."  #. Key:	2AA68EE046877CCD88EE6FB6EE501BEF #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay msgid "For a catalog of all the fish in Longvinter, click the Book icon at the bottom of the screen."
msgstr "Untuk melihat katalog semua ikan di Longvinter, klik ikon Buku di bagian bawah layar."  #. Key:	01937A5E4F98C15D3759CAACF77B4C4D #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_9.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Fishing_Tutorial.UMG_Fishing_Tutorial_C:WidgetTree.UMG_BulletPoint_9.TextToDisplay msgid "Fish that appear gray are ones you haven't caught yet."
msgstr "Ikan berwarna abu-abu adalah ikan yang belum kamu tangkap."  #. Key:	39A7B8D54D8A37AED8E6338FE89E316C #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.Title2.Text msgid "Workbench For Upgrading"
msgstr "Meja Kerja untuk Peningkatan"  #. Key:	05EB718E4F166EB82FEA92BC87FA795F #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.Title2_1.Text #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.Title2_1.Text msgid "Using the Workbench"
msgstr "Menggunakan meja kerja"  #. Key:	3D2337A240C6F771B4A8A6AF77E0292C #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.Title2_2.Text #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.Title2_2.Text msgid "Acquiring Materials"
msgstr "Memperoleh Bahan"  #. Key:	69DC48914F4416FBEBDDED8148A4C3C3 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Click on the workbench to start the upgrade to a cabin by depositing 100 wood logs."
msgstr "Klik meja kerja untuk memulai peningkatan ke kabin dengan menyetor 100 batang kayu."  #. Key:	E4DD41FE4D8C26CD4D07F9ADE7A50DAF #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "Crafting: Use the crafting window to create various items. Refer to the crafting book for details on what items you can craft."
msgstr "Kerajinan: Gunakan jendela kerajinan untuk membuat berbagai barang. Lihat buku kerajinan untuk detail barang apa yang bisa Anda buat."  #. Key:	1C7E2E294D28E9AD1D4DC0B330ECFE71 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Place the workbench inside your tent from your backpack."
msgstr "Letakkan meja kerja di dalam tenda Anda dari ransel Anda."  #. Key:	817DAC6248C7463ED253C5BECA126A9B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "Obtain logs for the upgrade by using a hatchet or chainsaw."
msgstr "Dapatkan kayu untuk peningkatan dengan menggunakan kapak atau gergaji mesin."  #. Key:	A285B2AD4C826E1474CB94A29A24BF7B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "Click on the workbench within your tent to use it."
msgstr "Klik pada meja kerja di dalam tenda Anda untuk menggunakannya."  #. Key:	6B2087004B66320B3508148E2FC7B291 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "Deposit 100 logs at the workbench to upgrade your tent to a cabin."
msgstr "Setor 100 batang kayu di meja kerja untuk meningkatkan tenda Anda menjadi kabin."  #. Key:	65A775CD40F7AC5F1917D2A97B02E4BE #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "Acquire a Workbench: Head to Sgt Lake's to buy a workbench from the vending machine. "
msgstr "Dapatkan Meja Kerja: Pergilah ke Sersan Lake untuk membeli meja kerja dari mesin penjual otomatis "  #. Key:	F487E9E24AC4C131E11B54A0DA9327C4 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay msgid "Hatchets and chainsaws are located in storage boxes scattered around the world."
msgstr "Kapak dan gergaji mesin terletak di kotak penyimpanan yang tersebar di seluruh dunia."  #. Key:	06BF95AE42F30BB723329F8C353529E6 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay #: /Game/Widgets/Tutorials/UMG_House_Tutorial.UMG_House_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay msgid "Decay Information: The Decay tab provides information on when your tent will decay if not upgraded to a cabin or house."
msgstr "Info Peluruhan: Tab Peluruhan memberikan informasi kapan tenda akan rusak jika tidak ditingkatkan menjadi kabin atau rumah."  #. Key:	C86B7FC649461ADE72C2EBBC50F48542 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.TextBlock.Text #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.TextBlock.Text msgid "This option will be available once you have upgraded your tent to a cabin"
msgstr "Opsi ini akan tersedia setelah Anda memperbaharui tenda Anda menjadi pondok"  #. Key:	09A307DA47C68ED998C03FBD83D66BCC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.TextBlock_0.Text msgid "When you place a workbench inside your house and interact with it, the house upgrade interface will appear. Here's a detailed guide to understanding and using this interface."
msgstr "Ketka kamu meletakkan dan berinteraksi dengan meja kerja didalam rumahmu, antarmuka peningkatan rumah akan muncul. Berikut ini panduan rinci untuk memahami dan menggunakan antarmuka ini."  #. Key:	0E5E2CD744EE24B174D8878EBAB3AFFC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.Title2.Text msgid "Decay and Upkeep"
msgstr "Kerusakan dan pemeliharaan"  #. Key:	C5F43EA344DFFA142D2FEDB5D7EF43CC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.Title2_1.Text #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.Title2_1.Text msgid "Management Options"
msgstr "Opsi Manajemen"  #. Key:	7DBF532D47F041D2A9CFD7A804154972 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Base Upkeep Requirement: Owning a house isn't all fun and games; it requires maintenance. Specifically, you need to provide wood to prevent your house from decaying. Insert logs into your house through this interface to maintain it."
msgstr "Kebutuhan Pemeliharaan Dasar: Memiliki rumah tidak hanya menyenangkan; rumah juga membutuhkan perawatan. Secara khusus, Anda perlu menyediakan kayu untuk mencegah rumah Anda hancur. Masukkan batang kayu ke dalam rumah Anda melalui antarmuka ini untuk merawatnya."  #. Key:	391704A843793420E730448DA4C630CD #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "Decay Timer: The Decay tab displays the remaining time before your tent or house vanishes. This feature helps prevent the server from being overwhelmed with tents from inactive players. Note that base decay can be turned off if you're playing on a private server."
msgstr "Pengatur Waktu Peleburan: Tab Peleburan menampilkan waktu yang tersisa sebelum tenda atau rumah Anda lenyap. Fitur ini membantu mencegah server kewalahan dengan tenda dari pemain yang tidak aktif. Perhatikan bahwa peleburan markas dapat dimatikan jika Anda bermain di server pribadi."  #. Key:	D6CCFF2D47B7449402F65DA4A2339A7C #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Dismantle Feature: There's a \"Dismantle\" icon to be aware of. Clicking this will dismantle your tent, so use it cautiously."
msgstr "Fitur Membongkar: Ada ikon \"Membongkar\" yang perlu diperhatikan. Mengkliknya akan membongkar tenda Anda, jadi gunakan dengan hati-hati."  #. Key:	E9849C874643C1EB9298E9B297339740 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "In this section, you can change the code lock on your house. This may be necessary if you no longer wish certain individuals to enter. Changing the code will prompt visitors to enter the new code."
msgstr "Di bagian ini, Anda dapat mengubah kunci kode rumah Anda. Hal ini mungkin diperlukan jika Anda tidak lagi menginginkan individu tertentu untuk masuk. Mengubah kode akan meminta pengunjung untuk memasukkan kode baru."  #. Key:	F2C9A5E34E6D9B139CFF1FBB0B44F3C8 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "You also have the option to collect your vendor earnings and adjust your turrets to passive mode from here."
msgstr "Anda juga memiliki opsi untuk mengumpulkan pendapatan penjual dan menyesuaikan turet Anda ke mode pasif dari sini."  #. Key:	850419B645C2E4AE43E63DA63DEFC244 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_HouseTabs_Tutorial.UMG_HouseTabs_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "Initial Upgrade: The primary use of this section is to upgrade your tent into a house. After this initial upgrade, you can further enhance your house by selecting various upgrade paths."
msgstr "Peningkatan Awal: Penggunaan utama bagian ini adalah untuk meningkatkan tenda Anda menjadi rumah. Setelah peningkatan awal ini, Anda dapat meningkatkan rumah Anda lebih lanjut dengan memilih berbagai jalur peningkatan."  #. Key:	5B8678F9480F28032C5907A0FE3A2080 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock.Text msgid "The team tab is always active, showing a team by default. It provides detailed information about your teammates, including their scores and the MK they carry. You can also invite players to your team from here and view the Teams Leaderboard."
msgstr "Tab tim selalu aktif, menampilkan tim secara standar. Tab ini memberikan informasi mendetail tentang rekan satu tim Anda, termasuk skor dan MK yang mereka bawa. Anda juga dapat mengundang pemain ke tim Anda dari sini dan melihat Papan Peringkat Tim."  #. Key:	6C2D271A475EED4B4BFB15ABEDD7FBBF #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_0.Text msgid "Note: This guide walks you through all the tabs in their respective order, ensuring you understand each section and its purpose."
msgstr "Catatan: Panduan ini memandu Anda melalui semua tab sesuai dengan urutannya masing-masing, untuk memastikan bahwa Anda memahami setiap bagian dan tujuannya."  #. Key:	923874574B7C9A8BEBF5B59DEA602383 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_1.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_1.Text msgid "Your equipment section displays everything your character is currently wearing. Unequipping is as simple as clicking on the desired item."
msgstr "Bagian perlengkapan Anda menampilkan semua yang sedang dikenakan oleh karakter Anda. Membuka perlengkapan semudah mengklik item yang diinginkan."  #. Key:	DBBC303B45B7F412BA010ABF9C756463 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_2.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_2.Text msgid "The Quests Tab lists all quests you've taken on. For more details on any quest, a simple click will reveal all the necessary information."
msgstr "Tab Quest menyenaraikan semua tugas yang telah Anda ambil. Untuk rincian lebih lanjut tentang tugas apa pun, klik sederhana akan mengungkapkan semua informasi yang diperlukan."  #. Key:	EE9774F74722A9423459E489628ADD6B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_3.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_3.Text msgid "Backpack and Currency Management"
msgstr "Pengelolaan Tas Ransel dan Mata Uang"  #. Key:	A2B95A5C4CEB9B25D712909D83D30267 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_4.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_4.Text msgid "Here, you'll find your mount if you've equipped one. While your mount remains safe from being lost on death if equipped, it can also be unequipped from this section. Mounts can be acquired from compendium vendors across various islands. Hotkey for mounting is [B] by default"
msgstr "Di sini, Anda akan menemukan tunggangan Anda jika Anda telah digunakan. Meskipun tunggangan Anda tetap aman dari kematian jika digunakan, tunggangan Anda juga dapat tidak digunakan dari bagian ini. Tunggangan dapat diperoleh dari vendor Kompendium di berbagai pulau. Tombol pintas untuk menggunakan adalah [B] secara default"  #. Key:	20084B3E40E5355D5011EAA7F3AAB0FB #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_6.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.TextBlock_6.Text msgid "The Compendium tab holds records of your collection achievements. Note that progress in the Fishing Compendium is only made through your own fishing efforts. Completing categories in the Compendium gives you access to specific vendors scattered around the world."
msgstr "Tab Kompendium menyimpan catatan pencapaian koleksi Anda. Perhatikan bahwa kemajuan dalam Kompendium Memancing hanya diperoleh melalui upaya memancing Anda sendiri. Melengkapi kategori dalam Kompendium memberi Anda akses ke vendor tertentu yang tersebar di seluruh dunia."  #. Key:	EC50FF914A2FFD22DF159AB15247485F #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.Title1.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.Title1.Text msgid "Mount Tab"
msgstr "Gunung Tab"  #. Key:	8AC464CC46FDC06CAA34CD8100D795BA #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.Title2.Text msgid "Equipment Management"
msgstr "Equipment management"  #. Key:	1D62CFB145C8D836B4A85EA74D450CF6 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.Title_1.Text #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.Title_1.Text msgid "Team Tab"
msgstr "Tim Tab"  #. Key:	4685F9FC4FCEB53021E99780798FB08A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Your backpack opens with the [TAB] key, revealing 20 slots for your items and gear."
msgstr "Ransel Anda akan terbuka dengan tombol [TAB], yang akan membuka 20 slot untuk barang dan perlengkapan Anda."  #. Key:	7C03D72245284C1C692CE597036357C5 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "To use an item, click on it. To discard an item, right-click to drop it on the ground."
msgstr "Untuk menggunakan sebuah item, klik item tersebut. Untuk membuang item, klik kanan untuk menjatuhkannya ke tanah.Untuk menggunakan sebuah item, klik item tersebut. Untuk membuang item, klik kanan untuk menjatuhkannya ke tanah."  #. Key:	FAE3D9C0475A481FB9BCAC92809E3D23 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Inventory_Tutorial.UMG_Inventory_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Your MK (Longvinter’s Marks) is visible in the same window. To drop a specific amount of MK, click on your currency, enter the desired amount, and press Enter to confirm."
msgstr "Jumlah MK (Longvinter's Marks) Anda terlihat di jendela yang sama. Untuk menurunkan jumlah MK tertentu, klik pada mata uang Anda, masukkan jumlah yang diinginkan, dan tekan Enter untuk mengonfirmasi."  #. Key:	962987264B7393919747A4BD62A39BFD #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.TextBlock.Text #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.TextBlock.Text msgid "If you are playing on an official server, you can see global leaderboards in the main hub areas that show the global score for the best players. Each month, rare cosmetic items and Vintercoins are given to the best players!"
msgstr "Jika Anda bermain di server resmi, Anda dapat melihat papan peringkat global di area hub utama yang menunjukkan skor global untuk pemain terbaik. Setiap bulan, item kosmetik langka dan Vintercoins diberikan kepada pemain terbaik!"  #. Key:	3FB614874E8FF916DCC033891111EC7B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.TextBlock_0.Text msgid "Once they have accepted your invite, they will appear in the team panel that can be found when clicking the team button on the Inventory panel [TAB] by default."
msgstr "Setelah mereka menerima undangan Anda, mereka akan muncul di panel tim yang dapat ditemukan ketika mengklik tombol tim pada panel Inventaris [TAB] secara default."  #. Key:	E99FEFB841BECF0660A52F92B0962C21 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.Title2_2.Text #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.Title2_2.Text msgid "Managing Team"
msgstr "Mengelola Tim"  #. Key:	00E33EF345CD56C1586A19ADC91DEE53 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "By clicking the \"Teams Leaderboard\" button, you can see all the teams on the server and how much score they have."
msgstr "Dengan menekan tombol \"peringkat tim\", kamu bisa melihat seluruh tim yang ada di server beserta skor yang mereka miliki."  #. Key:	E40EB6FC4FEF4085FE80808A8D769803 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "You can also change the team name here."
msgstr "Anda juga dapat mengubah nama tim di sini."  #. Key:	29A03824496BA3543B344E98A6643CDC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "Score is gained by doing different things in the game. Different activities gain different amounts of score."
msgstr "Skor diperoleh dengan melakukan berbagai hal dalam permainan. Aktivitas yang berbeda mendapatkan jumlah skor yang berbeda."  #. Key:	58B38C074E900F6142EE9DA5FDD89903 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "Join teams with friends or other players"
msgstr "Bergabung tim dengan teman atau pemain lain"  #. Key:	B0A56CC941335D9B72CC129166C87108 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "You can invite anybody to your team by right-clicking them."
msgstr "Anda dapat mengundang siapa saja ke dalam tim Anda dengan mengeklik kanan mereka"  #. Key:	181F0B434E0530DA984C0D8639D2B2B8 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "You can see your team's score and team members' Mk"
msgstr "Kamu bisa melihat skor timmu dan anggota tim Mk"  #. Key:	204DEEA4451DB8B8381CC083E0188C06 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_7.TextToDisplay msgid "Score is gained from fishing, farming, hunting, cooking, crafting, selling items, gathering wood, and gathering rocks."
msgstr "Skor diperoleh dari memancing, bertani, berburu, memasak, membuat kerajinan, menjual barang, mengumpulkan kayu, dan mengumpulkan batu."  #. Key:	8381A5AB448D662B6F5C0689264C3397 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.UMG_BulletPoint_8.TextToDisplay msgid "You can see the players that are on your team regardless of where they are on the map. You can also share your house easily with them."
msgstr "Anda dapat melihat pemain yang ada di tim Anda di mana pun mereka berada di peta. Anda juga dapat berbagi rumah dengan mudah dengan mereka."  #. Key:	7CDCE9C644BBB1D00025088F235C8A42 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.Title2.Text #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.Title2.Text msgid "Acquiring and Setting Up a Tent"
msgstr "Memperoleh dan Mendirikan Tenda"  #. Key:	1D0BFE3B420D396D64D1AABAE8DBE08D #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.Title2_1.Text #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.Title2_1.Text msgid "Important Notes"
msgstr "Catatan Penting"  #. Key:	554C0B334E090DE1D99D31BEDFAAE1EC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.Title2_2.Text #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.Title2_2.Text msgid "Entering and Exiting Your Tent"
msgstr "Masuk dan Keluar Tenda Anda"  #. Key:	29C9F8E74EBDE2C20E5F05A828633F49 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "To enter, walk to the tent entrance and either click on the tent or press SPACE."
msgstr "Untuk masuk, berjalanlah ke pintu masuk tenda dan klik tenda atau tekan SPASI."  #. Key:	A3AE52D74CAF869148C6EFA7FA8C59FE #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "To exit, do the same – approach the exit and press SPACE or follow the exit prompt on-screen."
msgstr "Untuk keluar, lakukan hal yang sama - dekati pintu keluar dan tekan SPASI atau ikuti petunjuk keluar di layar."  #. Key:	E42E81034CCDCDD4FB4BF1B4D20EC01A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Select a comfortable spot, click on the tent in your backpack, and place it on the ground to set up camp."
msgstr "Pilih lokasi yang nyaman, klik tenda di ransel Anda, dan letakkan di tanah untuk mendirikan kemah."  #. Key:	44B860534963BA6EEE534C83DF61DC48 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "Initially, only you can access the tent, but after upgrading it to a cabin and adding a workbench, you can then share it with teammates."
msgstr "Awalnya, hanya Anda yang dapat mengakses tenda, tetapi setelah meningkatkannya menjadi kabin dan menambahkan meja kerja, Anda kemudian dapat membaginya dengan rekan satu tim."  #. Key:	47F35D6143A7CFA43602C295FB372B90 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "Items left outside your un-upgraded tent are free for anyone to take."
msgstr "Barang-barang yang tertinggal di luar tenda Anda yang belum di-upgrade bebas diambil oleh siapa pun."  #. Key:	9EF4A36D42DBFA87D8F1F083251FA059 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "Tents will decay after 24 hours, so upgrade to a cabin quickly to secure your land around your cabin."
msgstr "Tenda akan Hancur setelah 24 jam, jadi tingkatkan ke kabin dengan cepat untuk mengamankan lahan di sekitar kabin Anda."  #. Key:	E9C9A0AD44A5B4C6982C05B0668619B3 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay #: /Game/Widgets/Tutorials/UMG_Tent_Tutorial.UMG_Tent_Tutorial_C:WidgetTree.UMG_BulletPoint_6.TextToDisplay msgid "Head to Sgt. Lake’s Outpost and purchase a researcher's tent from Kyrre’s orange vending machine."
msgstr "Menuju Pos Pengawas Sgt. Lake dan membeli tenda peneliti dari mesin penjual oranye milik Kyrre."  #. Key:	81C2A04940C0E9A0CD521B9ECC857CF8 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_TutorialBook.UMG_TutorialBook_C:WidgetTree.T_CurrentTab.Text #: /Game/Widgets/Tutorials/UMG_TutorialBook.UMG_TutorialBook_C:WidgetTree.T_CurrentTab.Text msgid "Tutorials"
msgstr "Panduan"  #. Key:	4F6AA25140F44C0CDC439E8CA0DF6E1C #. SourceLocation:	/Game/Widgets/Tutorials/UMG_TutorialBook.UMG_TutorialBook_C:WidgetTree.T_WindowDesc.Text #: /Game/Widgets/Tutorials/UMG_TutorialBook.UMG_TutorialBook_C:WidgetTree.T_WindowDesc.Text msgid "Here are all the tutorials currently available. Read as much as you like!"
msgstr "Berikut adalah semua tutorial yang tersedia saat ini. Baca sebanyak yang Anda suka!"  #. Key:	3E1EE058418E33F470E69E8A39544637 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] #: /Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] msgid "Instructions for tent setup, use, and upgrade."
msgstr "Petunjuk untuk pemasangan, penggunaan, dan peningkatan tenda."  #. Key:	5F99E40640278A65A8C6A0A6E8E91DAC #. SourceLocation:	/Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] #: /Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] msgid "Farming items, processes, and efficiency tips."
msgstr "Item, proses, dan kiat-kiat efisiensi pertanian."  #. Key:	8A1D1A3F49E34DB904F5DCBB9C2FCC1A #. SourceLocation:	/Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] #: /Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] msgid "Earning currency through fishing."
msgstr "Menghasilkan uang melalui penangkapan ikan."  #. Key:	8C3C730F4F385DB3E506F893ACE9A955 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] #: /Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] msgid "Character energy management."
msgstr "Manajemen energi karakter."  #. Key:	8C6D812145B3974E45A7C4BBF2EAE017 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] #: /Game/Widgets/Tutorials/UMG_TutoriallTile.UMG_TutoriallTile_C:Get_T_WindowDesc_1_Text_0 [Script Bytecode] msgid "Placeables, powering methods, and protection tips."
