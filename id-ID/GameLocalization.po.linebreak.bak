msgstr "Ban berakhir: "  #. Key:	07AF23854FF8422AA28F059420280D87 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_BanMessage.UMG_BanMessage_C:WidgetTree.T_Issued.Text #. Key:	BA9849B04077719FFF0F0D90C98B022B #. SourceLocation:	/Game/Widgets/MainMenu/UMG_BanMessage.UMG_BanMessage_C:ExecuteUbergraph_UMG_BanMessage [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_BanMessage.UMG_BanMessage_C:ExecuteUbergraph_UMG_BanMessage [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_BanMessage.UMG_BanMessage_C:WidgetTree.T_Issued.Text msgid "Ban issued: "
