msgstr "Klik pada Perapian untuk memasak"  #. Key:	F201FDDF4122875FAF590C9489E6146A #. SourceLocation:	/Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] #: /Game/ThirdPersonCPP/Pets/A_TutorialPetCharacter.A_TutorialPetCharacter_C:ExecuteUbergraph_A_TutorialPetCharacter [Script Bytecode] msgid "They buy and sell all kinds of items"
