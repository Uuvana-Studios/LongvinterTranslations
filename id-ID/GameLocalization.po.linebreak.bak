msgid "Hidden in northern container."
msgstr "Tersembunyi di kontainer utara."  #. Key:	WeatherStation_Responses_Index3 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WeatherStation.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(3).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E #: /Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WeatherStation.Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E(3).Responses_5_8358BDE54DC0A531E08AD3921E6BDE3E msgctxt "DT_ChatResponses"
msgid "Passive income once placed!"
msgstr "Pendapatan pasif setelah ditempatkan!"  #. Key:	WorkbenchUse_Keywords_Index1 #. SourceLocation:	/Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Keywords_3_4813D612475BFE69FB46CBB6EF7E240C(1).Keywords_3_4813D612475BFE69FB46CBB6EF7E240C #: /Game/Blueprints/NewQuests/DT_ChatResponses.DT_ChatResponses.WorkbenchUse.Keywords_3_4813D612475BFE69FB46CBB6EF7E240C(1).Keywords_3_4813D612475BFE69FB46CBB6EF7E240C msgctxt "DT_ChatResponses"
