msgstr "Duduk"  #. Key:	12BA93C4468C4275D2F2F0A977FF70D7 #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/InputSettingsPage.InputSettingsPage_C:WidgetTree.InputRow_C.Label #. Key:	3395B3E2481845CA5DFE33B12EE097DF #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_6.ActionDescription #. Key:	607540A3465AF77FEE9C458873910285 #. SourceLocation:	/Game/Widgets/UMG_Inputs.UMG_Inputs_C:WidgetTree.TextBlock_1.Text #. Key:	C5B13E89439858F847460885FEDEF0D2 #. SourceLocation:	/Game/Widgets/Icons/Input/UMG_InputQuickstart.UMG_InputQuickstart_C:WidgetTree.UMG_InputKey_6.ActionDescription #: /Game/Widgets/Icons/Input/UMG_InputQuickstart.UMG_InputQuickstart_C:WidgetTree.UMG_InputKey_6.ActionDescription #: /Game/Widgets/SettingsMenu/Pages/InputSettingsPage.InputSettingsPage_C:WidgetTree.InputRow_C.Label #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_6.ActionDescription #: /Game/Widgets/UMG_Inputs.UMG_Inputs_C:WidgetTree.TextBlock_1.Text msgid "Wave"
msgstr "Ombak"  #. Key:	81342A5D45BA40A5349247A054DABC94 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_6.Key #. Key:	D1291BD443D11C9B99E237B77F391BE6 #. SourceLocation:	/Game/Widgets/Icons/Input/UMG_InputQuickstart.UMG_InputQuickstart_C:WidgetTree.UMG_InputKey_6.Key #: /Game/Widgets/Icons/Input/UMG_InputQuickstart.UMG_InputQuickstart_C:WidgetTree.UMG_InputKey_6.Key #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_6.Key msgid "C"
msgstr "C"  #. Key:	32F004FC455FDC5F17BE71A873214F9B #. SourceLocation:	/Game/Widgets/Icons/Input/UMG_InputQuickstart.UMG_InputQuickstart_C:WidgetTree.UMG_InputKey_7.ActionDescription #. Key:	839F06B947AB06EBF3655F9C9D3FE003 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_7.ActionDescription #. Key:	9372576E4A4F8D7E4FC314A0F6981C4F #. SourceLocation:	/Game/Widgets/SettingsMenu/Pages/InputSettingsPage.InputSettingsPage_C:WidgetTree.InputRow_C_18.Label #. Key:	EF0915E24823DE32C8627B8C3B5ABBD0 #. SourceLocation:	/Game/Widgets/UMG_Inputs.UMG_Inputs_C:WidgetTree.TextBlock_17.Text #: /Game/Widgets/Icons/Input/UMG_InputQuickstart.UMG_InputQuickstart_C:WidgetTree.UMG_InputKey_7.ActionDescription #: /Game/Widgets/SettingsMenu/Pages/InputSettingsPage.InputSettingsPage_C:WidgetTree.InputRow_C_18.Label #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_7.ActionDescription #: /Game/Widgets/UMG_Inputs.UMG_Inputs_C:WidgetTree.TextBlock_17.Text msgid "Chat"
msgstr "Obrolan"  #. Key:	5107EC3B48C09973DAD7019460799BB7 #. SourceLocation:	/Game/Widgets/Icons/Input/UMG_InputQuickstart.UMG_InputQuickstart_C:WidgetTree.UMG_InputKey_7.Key #. Key:	986C2F624F09CB82E42E34AAE67780D3 #. SourceLocation:	/Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_7.Key #: /Game/Widgets/Icons/Input/UMG_InputQuickstart.UMG_InputQuickstart_C:WidgetTree.UMG_InputKey_7.Key #: /Game/Widgets/Tutorials/UMG_AllKeyBinds.UMG_AllKeyBinds_C:WidgetTree.UMG_InputKey_7.Key msgid "Enter"
msgstr "Enter"  #. Key:	A64963E64131C7DA271B878ACE36E87C #. SourceLocation:	/Game/Widgets/MainMenu/UMG_QuickJoin.UMG_QuickJoin_C:WidgetTree.TextBlock_3.Text #. Key:	FD5EF5FB4048AB0EA606F5B0D1025CF6 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.JoinServer_1.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.JoinServer_1.Text #: /Game/Widgets/MainMenu/UMG_QuickJoin.UMG_QuickJoin_C:WidgetTree.TextBlock_3.Text msgid "Join Official"
msgstr "Gabung Official"  #. Key:	6846386A43190AD1333A5FABCA91A39C #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.JoinServer_2.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.JoinServer_2.Text msgid "Scoll Servers"
msgstr "Server Gulir"  #. Key:	4AAB6EF64C2A01104198F5862F6EBDCD #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.JoinServer_3.Text #. Key:	BE56000842DEADABFA8ACA90382E18AF #. SourceLocation:	/Game/Widgets/MainMenu/UMG_ServerBrowser.UMG_ServerBrowser_C:WidgetTree.add_fuel_text_3.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.JoinServer_3.Text #: /Game/Widgets/MainMenu/UMG_ServerBrowser.UMG_ServerBrowser_C:WidgetTree.add_fuel_text_3.Text msgid "Host Session"
msgstr "Sesi Tuan Rumah"  #. Key:	FC55EE3C4DB7A27FAB8DBB9D7FF29EDB #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.T_Title.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.T_Title.Text msgid "Important Information!"
msgstr "Informasi Penting!"  #. Key:	B0BC13E64F2FCA7C182F6E9C2B05E538 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock.Text msgid "Why Wipes?"
msgstr "Mengapa Tisu?"  #. Key:	E2F17E56431A52F3D9F00A98BB377AA2 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_0.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_0.Text msgid "Welcome to your adventure on Longvinter Island! We're thrilled to have you join us. "
msgstr "Selamat datang di petualangan Anda di Pulau Longvinter! Kami gembira Anda bergabung bersama kami."  #. Key:	11F993254B4489914866C3A7FD8AF526 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_1.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_1.Text msgid "Official Servers"
msgstr "Server Resmi"  #. Key:	4811857A49A5EC216A904D8DF3F8A0DB #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_2.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_2.Text msgid "Unofficial Servers"
msgstr "Server Tidak Resmi"  #. Key:	0EA016734A2D9052135769AC05C72760 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_3.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_3.Text msgid "Play on Your Own"
msgstr "Mainkan Sendiri"  #. Key:	52DD440845522BE414D45B80DAE0353C #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_4.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_4.Text msgid "Less-populated servers might last longer, but based on community feedback, wiping every 6 months balances players who enjoy long-term progress with those who love fresh starts. This also lets everyone compete for the best spots (like near Sgt. Lake Outpost!). Unofficial and self-hosted servers let you decide wipe schedules.\r\n\r\nHope to see you on Longvinter Island!\r\n\r\n– Sven"
msgstr "Kurang berpenduduk server mungkin bertahan lebih lama, tetapi berdasarkan umpan balik komunitas, penghapusan setiap 6 bulan menyeimbangkan pemain yang menikmati kemajuan jangka panjang dengan mereka yang mencintai awal baru. Ini juga memungkinkan semua orang bersaing untuk mendapatkan tempat terbaik (seperti dekat Pos Depan Danau Sgt!). Server tidak resmi dan self-hosted memungkinkan Anda memutuskan jadwal penghapusan.\r\n\r\nSemoga berjumpa di Pulau Longvinter!\r\n\r\n– Sven""  #. Key:	F23E7EB64FCBDD039AD5D3828640D3C1 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_5.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_5.Text msgid "Overcrowded servers can fill with so many objects that the game engine struggles to function. We’re constantly optimizing to avoid this, and we guarantee that official servers can run at least 6 months without a wipe."
msgstr "Server yang terlalu padat dapat dipenuhi dengan begitu banyak objek sehingga mesin game kesulitan untuk berfungsi. Kami terus mengoptimalkan untuk menghindari hal ini, dan kami menjamin bahwa server resmi dapat berjalan setidaknya 6 bulan tanpa penghapusan."  #. Key:	20F014DC43B82636DE7C35A5E2440314 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_6.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_6.Text msgid "Longvinter is an online game played on servers where your progress is saved. Different servers have different rules about progress resets (wipes), where all players lose their items and buildings and start fresh. You can see when the next reset happens for each server in the server browser. Some servers maintain permanent progress while others reset regularly."
msgstr "Longvinter adalah game online yang dimainkan di server di mana progres Anda tersimpan. Server yang berbeda memiliki aturan berbeda tentang pengaturan ulang progres (wipe), di mana semua pemain kehilangan item dan bangunan mereka dan memulai dari awal. Anda dapat melihat kapan pengaturan ulang berikutnya terjadi untuk setiap server di browser server. Beberapa server mempertahankan kemajuan permanen sedangkan yang lain diatur ulang secara teratur."  #. Key:	3602CF12418BE665E027D68FF5E4D3FC #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_7.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_7.Text msgid "Want to play without losing progress? Just click \"Host Session\" at the bottom to create your own private world!"
msgstr "Ingin bermain tanpa kehilangan progress? Cukup klik \"Host Session\" di bawah untuk membuat dunia pribadi Anda sendiri!"  #. Key:	1B3849814364BF0FC27097B9C6A11BDF #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_8.Text #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.TextBlock_8.Text msgid "Please read below for detailed information about our different server types and their wipe schedules to find the best way to play for you."
msgstr "Silakan baca di bawah ini untuk informasi terperinci tentang jenis server kami yang berbeda dan jadwal penghapusan mereka untuk menemukan cara terbaik bermain untuk Anda."  #. Key:	E81FE3DB49A2544D15328CADF3EC5453 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint.TextToDisplay #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint.TextToDisplay msgid "Hosted by Uuvana"
msgstr "Diselenggarakan oleh Uuvana"  #. Key:	5280A7654B3E0CC8ECFEE4AE88F64F0D #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_1.TextToDisplay msgid "Progress resets approximately every 6 months"
msgstr "Kemajuan direset kira-kira setiap 6 bulan"  #. Key:	74E288E24D27BA2655777EB229097E16 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_10.TextToDisplay msgid "Players on the same network can join easily; use port forwarding for external access"
msgstr "Pemain di jaringan yang sama dapat bergabung dengan mudah; gunakan penerusan port untuk akses eksternal"  #. Key:	EEF84B2C468571A8C6189387B3C97443 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_11.TextToDisplay #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_11.TextToDisplay msgid "Progress saves locally on your device"
msgstr "Kemajuan tersimpan secara lokal di perangkat Anda"  #. Key:	104258394F902D4205454D96CD4E2524 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_2.TextToDisplay msgid "Accessible via the server browser"
msgstr "Dapat diakses melalui penjelajah server"  #. Key:	63E47ED8450C0759EB3238A2600FD01F #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_3.TextToDisplay msgid "Community-maintained; may include custom mods, extra content, or gameplay modes"
msgstr "Dirawat komunitas; mungkin mencakup modifikasi khusus, konten tambahan, atau mode permainan"  #. Key:	DA169B29482A0BE906824C83959C8007 #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_4.TextToDisplay msgid "Default option when clicking “Play”"
msgstr "Opsi default saat mengklik \"Main\""  #. Key:	85666D5643091545489CF89973FF845A #. SourceLocation:	/Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay #: /Game/Widgets/InfoMessages/UMG_WipeInfo.UMG_WipeInfo_C:WidgetTree.UMG_BulletPoint_5.TextToDisplay msgid "Most populated and social experience"
