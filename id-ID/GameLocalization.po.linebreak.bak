msgstr "Bijih yang Diterima"  #. Key:	F00F66E04AB765CEB87539AA310A8982 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:GetRequirementText [Script Bytecode] #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:GetRequirementText [Script Bytecode] msgid "Accepted Fish"
msgstr "Ikan Diterima"  #. Key:	BF38A9E645B26D133F80D1AA13E7DC3B #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:MinimumAmounText [Script Bytecode] #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:MinimumAmounText [Script Bytecode] msgid "Complete"
msgstr "Berhasil"  #. Key:	F93B05A740FF5E2C935DB3A7CE60A3FC #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:MinimumAmounText [Script Bytecode] #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:MinimumAmounText [Script Bytecode] msgid "To Receive"
msgstr "Untuk Menerima"  #. Key:	4D07E4BD4CC27B39BF8289AE122E74C7 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:GetTimeLeft [Script Bytecode] #. Key:	C19060EB4E46365E59E7918DA0D58C94 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:TimeLeftText [Script Bytecode] #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:TimeLeftText [Script Bytecode] #: /Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:GetTimeLeft [Script Bytecode] msgid "Days"
msgstr "Hari"  #. Key:	1F54156C4F1A3759715746AF91923CBF #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.Price.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.Price.Text msgid "10 000"
msgstr "10 000"  #. Key:	713AB20B43308227F680FAA64C4417B2 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_1.Text #. Key:	AF72EA80417709BA2102558A52556C0B #. SourceLocation:	/Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.Title2.Text #. Key:	C4602BCD472695E07ABF988C24574D2F #. SourceLocation:	/Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:WidgetTree.TextBlock_1.Text #. Key:	FBD19EAF4371E5C7E3501FA8966A057A #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_Leaderboard.UMG_Leaderboard_C:WidgetTree.TextBlock_1.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_1.Text #: /Game/Widgets/Leaderboard/UMG_Leaderboard.UMG_Leaderboard_C:WidgetTree.TextBlock_1.Text #: /Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:WidgetTree.TextBlock_1.Text #: /Game/Widgets/Tutorials/UMG_Team_Tutorial.UMG_Team_Tutorial_C:WidgetTree.Title2.Text msgid "Score"
msgstr "Nilai"  #. Key:	F4BFCF38464B46024014B186F0A40674 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_12.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_12.Text msgid "Action"
msgstr "Tindakan"  #. Key:	764AC00943CCD50E66550ABF9692CC15 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_15.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_15.Text msgid "Participate in various events featuring activities like fishing, farming, or arena PVP. If no events are active, check back later for upcoming ones. Your actions count towards milestones, earning you vintercoins to purchase clothes from the shop. The top 10 performers even receive a custom hat with a special effect!"
msgstr "Berpartisipasilah dalam berbagai acara yang menampilkan kegiatan seperti memancing, bertani, atau arena PVP. Jika tidak ada acara yang aktif, periksa kembali nanti untuk acara yang akan datang. Tindakan Anda dihitung sebagai pencapaian, dan Anda akan mendapatkan vintercoin untuk membeli pakaian dari toko. 10 pemain teratas bahkan menerima topi khusus dengan efek khusus!"  #. Key:	68750B654943DB668A0693A20771A827 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_16.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_16.Text msgid "Not started yet"
msgstr "Belum dimulai"  #. Key:	9AFEBFEF4DE75D9DE6AA6489267A1830 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_17.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_17.Text msgid "Check back again later!"
msgstr "Periksa lagi nanti!"  #. Key:	2D2F16AB40AF6E1188D294B486763AAA #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_18.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_18.Text msgid "Event Will Start In"
msgstr "Acara akan dimulai dalam"  #. Key:	2E67DE5C402F1341E9E7EBB0AB7C957D #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_19.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_19.Text msgid "No Upcoming Events"
msgstr "Tidak ada Acara Mendatang"  #. Key:	5BE74F9A46A342D016ABD89253EA52E5 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_2.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_2.Text msgid "Global Scoreboard Challenge"
msgstr "Tantangan Papan Skor Global"  #. Key:	611A16794B3EE69D4F78C388AE3E3917 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_22.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_22.Text msgid "Note: Your score is submitted at logout."
msgstr "Catatan: Skor Anda akan dikirimkan saat Anda keluar."  #. Key:	BDB466684FD43282F466B686A35BEAF1 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_3.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_3.Text msgid "Every month, players with the highest scores are rewarded. The top 10 players receive a hat with a special effect, while the next 190 players get 10,000 Vintercoins. Score is earned through in-game activities like fishing, farming, hunting, rock harvesting, item selling, and cooking on any official servers."
msgstr "Setiap bulan, pemain dengan skor tertinggi akan mendapatkan hadiah. 10 pemain teratas menerima topi dengan efek khusus, sementara 190 pemain berikutnya mendapatkan 10.000 Vintercoin. Skor diperoleh melalui aktivitas dalam game seperti memancing, bertani, berburu, memanen batu, menjual item, dan memasak di server resmi mana pun."  #. Key:	99253278428807A83139A8BD65DF4783 #. SourceLocation:	/Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:WidgetTree.TextBlock_4.Text #. Key:	D6D549784239B4B90B8C4B80E34508AA #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_4.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_4.Text #: /Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:WidgetTree.TextBlock_4.Text msgid "Top 10 Prize"
msgstr "Hadiah 10 Besar"  #. Key:	F3BC10374EC9AEF626B51B978FA065A3 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_5.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_5.Text msgid "Prize For Position 10 - 200"
msgstr "Hadiah Untuk Posisi 10 - 200"  #. Key:	DC8137B345DE2E226E347A810027F1FB #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_7.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_7.Text msgid "Join events on any official server by completing tasks listed below. Finish enough tasks to earn Vintercoins, and if you're in the top 10, you'll get a special hat. No event right now? Check back later. Events include fishing, farming, looting, and Arena PVP."
msgstr "Ikuti acara di server resmi mana pun dengan menyelesaikan tugas di bawah ini. Selesaikan cukup banyak tugas untuk mendapatkan Vintercoins, dan jika Anda berada di 10 besar, Anda akan mendapatkan topi khusus. Tidak ada acara sekarang? Cek kembali nanti. Acara termasuk memancing, bertani, merampok, dan PVP Arena."  #. Key:	EA4FA8604B31A2EB319F518DE74B0C2D #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.upgrade_tab_text.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.upgrade_tab_text.Text msgid "Scoreboard"
msgstr "Papan Skor"  #. Key:	6505A20248FE712FBEAA15B58E91E3D0 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.upgrade_tab_text_1.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.upgrade_tab_text_1.Text msgid "Event Competition"
msgstr "Acara Kompetisi"  #. Key:	518118CC468F870060AC669025B58336 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_LeaderboardTeamContent.UMG_LeaderboardTeamContent_C:WidgetTree.T_Players.Text #. Key:	939C709A4A4BAEAF8CD704A7BD248B27 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboardTeamContent.UMG_GlobalLeaderboardTeamContent_C:WidgetTree.T_Players.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboardTeamContent.UMG_GlobalLeaderboardTeamContent_C:WidgetTree.T_Players.Text #: /Game/Widgets/Leaderboard/UMG_LeaderboardTeamContent.UMG_LeaderboardTeamContent_C:WidgetTree.T_Players.Text msgid "8"
msgstr ""  #. Key:	53A092174DFD8B40BA2B1EA8F3DC4951 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboardTeamContent.UMG_GlobalLeaderboardTeamContent_C:WidgetTree.T_Score.Text #. Key:	EE765079493FBA755A8495A9C516D661 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_LeaderboardTeamContent.UMG_LeaderboardTeamContent_C:WidgetTree.T_Score.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboardTeamContent.UMG_GlobalLeaderboardTeamContent_C:WidgetTree.T_Score.Text #: /Game/Widgets/Leaderboard/UMG_LeaderboardTeamContent.UMG_LeaderboardTeamContent_C:WidgetTree.T_Score.Text msgid "7560"
msgstr "7560"  #. Key:	82588ED045FB91E70EE497B67FEDC821 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_LeaderboardTeamContent.UMG_LeaderboardTeamContent_C:WidgetTree.T_TeamName.Text #. Key:	BF46703441388EEB03AEEBA02BAD6462 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboardTeamContent.UMG_GlobalLeaderboardTeamContent_C:WidgetTree.T_TeamName.Text #: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboardTeamContent.UMG_GlobalLeaderboardTeamContent_C:WidgetTree.T_TeamName.Text #: /Game/Widgets/Leaderboard/UMG_LeaderboardTeamContent.UMG_LeaderboardTeamContent_C:WidgetTree.T_TeamName.Text msgid "Team 1"
msgstr "Tim 1"  #. Key:	1FD33B514F59D3F7EB47B68808D11F11 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_Leaderboard.UMG_Leaderboard_C:WidgetTree.T_CurrentTab.Text #: /Game/Widgets/Leaderboard/UMG_Leaderboard.UMG_Leaderboard_C:WidgetTree.T_CurrentTab.Text msgid "Leaderboard"
msgstr "Papan Peringkat"  #. Key:	1CD45A2B45D0C65BAA5CCDB00078D107 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_Leaderboard.UMG_Leaderboard_C:WidgetTree.TextBlock.Text #: /Game/Widgets/Leaderboard/UMG_Leaderboard.UMG_Leaderboard_C:WidgetTree.TextBlock.Text msgid "Players"
msgstr "Pemain"  #. Key:	AFD301424A18DC91A56FBEAEBAFDCAF3 #. SourceLocation:	/Game/Widgets/Leaderboard/UMG_Leaderboard.UMG_Leaderboard_C:WidgetTree.TextBlock_88.Text #: /Game/Widgets/Leaderboard/UMG_Leaderboard.UMG_Leaderboard_C:WidgetTree.TextBlock_88.Text msgid "Team Name"
msgstr "Nama Tim"  #. Key:	21BAD04A4E84098C8F501EA91C0D6235 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:ExecuteUbergraph_UMG_Feedbackform [Script Bytecode] #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:ExecuteUbergraph_UMG_Feedbackform [Script Bytecode] msgid "Could not process your feedback"
msgstr "Tidak dapat memproses masukan Anda"  #. Key:	2F643A69445E001809E9EBADF5402590 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:ExecuteUbergraph_UMG_Feedbackform [Script Bytecode] #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:ExecuteUbergraph_UMG_Feedbackform [Script Bytecode] msgid "User ID"
msgstr "ID Pengguna"  #. Key:	A23981184D7FC6820AC6FAB345624D94 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:ExecuteUbergraph_UMG_Feedbackform [Script Bytecode] #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:ExecuteUbergraph_UMG_Feedbackform [Script Bytecode] msgid "Your in-game coordinates"
msgstr "Koordinat permainan Anda"  #. Key:	B8F632B942762C861C8DAC97F65D41DD #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.Coords.Text #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.Coords.Text msgid "Your in-game coordinates: "
msgstr "Koordinat Anda dalam game:"  #. Key:	AF77E9804A9615AC867AD8A6C11C0F65 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.Description.HintText #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.Description.HintText msgid "Please provide detailed information about the issue"
msgstr "Berikan informasi terperinci tentang masalah tersebut"  #. Key:	503730264E9F03EADC58C898E1AEB6AC #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.Reproduce.HintText #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.Reproduce.HintText msgid "Please provide the steps to reproduce the issue if applicable"
msgstr "Berikan langkah-langkah untuk mereproduksi masalah jika memungkinkan"  #. Key:	66B60BA9499CC09ACFEE3886725B6534 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.RequiredField.Text #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.RequiredField.Text msgid "* Fill all required fields"
msgstr "* Isi semua kolom yang diperlukan"  #. Key:	1A74657A4C3E7125283432ABE2004D14 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Category.Text #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Category.Text msgid "* Category"
msgstr "* Kategori"  #. Key:	323BE2614C65B75C28EBFFB032613FDA #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Char_Steps.Text #. Key:	BDBB930446F48A9C15C3C6965317B093 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Char_Desc.Text #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Char_Desc.Text #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Char_Steps.Text msgid "0/100"
msgstr "0/100"  #. Key:	88DB3D3E42F29097AE03D38549340863 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Char_Title_1.Text #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Char_Title_1.Text msgid "(Min. 10 characters)"
msgstr "(Min. 10 karakter)"  #. Key:	E59542B94DD83DD8A2D01F84996E0999 #. SourceLocation:	/Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Description.Text #: /Game/Widgets/MainMenu/Feedbackform/UMG_Feedbackform.UMG_Feedbackform_C:WidgetTree.T_Description.Text msgid "* Description"
