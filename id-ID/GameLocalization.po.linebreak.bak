msgstr "teks"  #. Key:	61DDFA174FC7AA014B25D2B251BE7F0B #. SourceLocation:	/Game/Widgets/Icons/Input/Enum_InputKeyIcon.Enum_InputKeyIcon.DisplayNameMap(0 - Value).DisplayNameMap #: /Game/Widgets/Icons/Input/Enum_InputKeyIcon.Enum_InputKeyIcon.DisplayNameMap(0 - Value).DisplayNameMap msgid "M1"
