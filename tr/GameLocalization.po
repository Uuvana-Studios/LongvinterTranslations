#: /Game/Widgets/Tutorials/UMG_TutorialBook.UMG_TutorialBook_C:WidgetTree.T_WindowDesc.Text
msgid "Here are all the tutorials currently available. Read as much as you like!"
msgstr "İşte şu anda mevcut olan tüm eğitimler. İstediğiniz kadar okuyun!"

