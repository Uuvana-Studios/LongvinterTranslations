msgstr "Kann in legendären orangefarbenen Truhen gefunden werden."

#. Key:	1868E02B4B10918513CA8F8936D90158
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Northern islands have better loot."
msgstr "Nördliche Inseln haben bessere Beute."

#. Key:	1BE53ED0473C9023F039879A7991B965
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
