msgstr "Zeigt dir jedes Rezept. Sehr praktisch."

#. Key:	8A7F3A86466ADC2E00D0ACB3E8DF62C5
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Use Cooking book to see how to cook stuff"
msgstr "Benutze das Kochbuch, um zu sehen, wie man kocht."

#. Key:	95351ED64CBC727BB682C9AA5B7D2819
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Try buying thing from general store!"
msgstr "Versuche, Dinge aus dem Gemischtwarenladen zu kaufen!"

#. Key:	971139FD450627D4AD2868998880939B
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
