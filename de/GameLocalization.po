#: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_17.Text
msgid "Check back again later!"
msgstr "Komm später noch mal vorbei!"

#. Key:	2D2F16AB40AF6E1188D294B486763AAA
#. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_18.Text
#: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_18.Text
