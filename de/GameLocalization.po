#. Key:	611A16794B3EE69D4F78C388AE3E3917
#. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_22.Text
#: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_22.Text
msgid "Note: Your score is submitted at logout."
msgstr "Hinweis: Ihre Punktzahl wird bei der Abmeldung übermittelt."

#. Key:	BDB466684FD43282F466B686A35BEAF1
#. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_3.Text
#: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_3.Text
msgid "Every month, players with the highest scores are rewarded. The top 10 players receive a hat with a special effect, while the next 190 players get 10,000 Vintercoins. Score is earned through in-game activities like fishing, farming, hunting, rock harvesting, item selling, and cooking on any official servers."
msgstr "Jeden Monat werden Spieler mit den höchsten Punktzahlen belohnt. Die besten 10 Spieler erhalten einen Hut mit Sondereffekt, während die nächsten 190 Spieler 10.000 Vintercoins erhalten. Punkte werden durch Ingame-Aktivitäten wie Fischen, Farmen, Jagen, Felsen abbauen, Gegenstände verkaufen und Kochen auf offiziellen Servern verdient."

#. Key:	99253278428807A83139A8BD65DF4783
#. SourceLocation:	/Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:WidgetTree.TextBlock_4.Text
#. Key:	D6D549784239B4B90B8C4B80E34508AA
#. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_4.Text
#: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_4.Text
#: /Game/Widgets/MainMenu/UMG_SmallGlobalLeaderboard.UMG_SmallGlobalLeaderboard_C:WidgetTree.TextBlock_4.Text
msgid "Top 10 Prize"
msgstr "Top-10-Preis"

#. Key:	F3BC10374EC9AEF626B51B978FA065A3
#. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_5.Text
#: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_5.Text
msgid "Prize For Position 10 - 200"
msgstr "Preis für Position 10 - 200"

#. Key:	DC8137B345DE2E226E347A810027F1FB
#. SourceLocation:	/Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_7.Text
#: /Game/Widgets/Leaderboard/UMG_GlobalLeaderboard.UMG_GlobalLeaderboard_C:WidgetTree.TextBlock_7.Text
msgid "Join events on any official server by completing tasks listed below. Finish enough tasks to earn Vintercoins, and if you're in the top 10, you'll get a special hat. No event right now? Check back later. Events include fishing, farming, looting, and Arena PVP."
msgstr "Nehmen Sie an Events auf jedem offiziellen Server teil, indem Sie die unten aufgeführten Aufgaben abschließen. Schließen Sie genügend Aufgaben ab, um Vintercoins zu verdienen, und wenn Sie unter den Top 10 sind, erhalten Sie einen besonderen Hut. Derzeit kein Event? Schauen Sie später noch einmal vorbei. Events umfassen Angeln, Farmen, Plündern und Arena-PvP."

