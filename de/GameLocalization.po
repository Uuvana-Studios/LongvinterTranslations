msgstr "Alle Plätze, die du bereits kennst, können sich in besondere verwandeln."

#. Key:	4CF376614D1F5FDB127A6180039091E4
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
msgid "Just add them to the painting station!"
msgstr "Füge sie einfach an der Malstation hinzu!"

#. Key:	4E4357B947284C3FF5BABFAB4FDA1CE7
#. SourceLocation:	/Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
#: /Game/Widgets/Inventory/UMG_QuestTask.UMG_QuestTask_C:ExecuteUbergraph_UMG_QuestTask [Script Bytecode]
